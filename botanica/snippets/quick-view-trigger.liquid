{% comment %}
  snippets/quick-view-trigger.liquid — Quick view eye icon trigger.
  Rendered inside product card media area.
  Uses BtQuickView custom element for dialog.
{% endcomment %}
<button
  type="button"
  class="bt-quick-view-trigger"
  data-quick-view="{{ product.handle }}"
  aria-label="{{ 'products.product.quick_view' | t }} — {{ product.title }}"
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.5"/>
    <path d="M1 12c2.5-6 6.5-9.5 11-9.5S20.5 6 23 12c-2.5 6-6.5 9.5-11 9.5S3.5 18 1 12z" stroke="currentColor" stroke-width="1.5"/>
  </svg>
  <span class="bt-quick-view-trigger__label">{{ 'products.product.quick_view' | t }}</span>
</button>

{% stylesheet %}
  .bt-quick-view-trigger {
    position: absolute;
    bottom: var(--bt-space-2xs);
    right: var(--bt-space-2xs);
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 10px;
    background: var(--bt-color-bg);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-pill);
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-medium);
    color: var(--bt-color-text-muted);
    cursor: pointer;
    z-index: 2;
    transition: all var(--bt-duration-fast);
    opacity: 0;
    transform: translateY(4px);
  }
  .bt-card:hover .bt-quick-view-trigger,
  .bt-quick-view-trigger:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .bt-quick-view-trigger:hover {
    background: var(--bt-color-primary);
    color: var(--bt-color-primary-contrast);
    border-color: var(--bt-color-primary);
  }
  @media (max-width: 749px) {
    .bt-quick-view-trigger__label { display: none; }
  }
{% endstylesheet %}
