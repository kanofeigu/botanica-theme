{% comment %} pagination.liquid — Styled pagination with full interactivity. Zero Dawn code. {% endcomment %}
{%- if paginate.pages > 1 -%}
  <nav class="bt-pagination" aria-label="{{ 'accessibility.pagination' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="bt-pagination__btn bt-interactive bt-press" aria-label="{{ 'accessibility.previous_page' | t }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
      </a>
    {%- else -%}
      <span class="bt-pagination__btn bt-pagination__btn--disabled" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
      </span>
    {%- endif -%}

    <div class="bt-pagination__pages">
      {%- for part in paginate.parts -%}
        {%- if part.is_link -%}
          <a href="{{ part.url }}" class="bt-pagination__page bt-interactive bt-press">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page -%}
          <span class="bt-pagination__page bt-pagination__page--current" aria-current="page">{{ part.title }}</span>
        {%- else -%}
          <span class="bt-pagination__page bt-pagination__page--gap">&hellip;</span>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="bt-pagination__btn bt-interactive bt-press" aria-label="{{ 'accessibility.next_page' | t }}">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    {%- else -%}
      <span class="bt-pagination__btn bt-pagination__btn--disabled" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
      </span>
    {%- endif -%}
  </nav>
{%- endif -%}

{% stylesheet %}
  .bt-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--bt-space-2xs);
  }

  .bt-pagination__pages {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .bt-pagination__btn,
  .bt-pagination__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    height: 40px;
    padding: 0 var(--bt-space-2xs);
    font-family: var(--bt-font-body);
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-medium);
    color: var(--bt-color-text);
    text-decoration: none;
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-btn);
    background: var(--bt-color-bg);
    transition: all var(--bt-duration-fast) var(--bt-ease-out);
    cursor: pointer;
    user-select: none;
  }

  .bt-pagination__btn:hover,
  .bt-pagination__page:hover {
    border-color: var(--bt-color-primary);
    color: var(--bt-color-primary);
    background: var(--bt-color-primary-tint);
    transform: translateY(-1px);
  }

  .bt-pagination__btn:active,
  .bt-pagination__page:active {
    transform: scale(0.95);
    transition-duration: 80ms;
  }

  .bt-pagination__page--current {
    background: var(--bt-color-primary);
    color: var(--bt-color-primary-contrast);
    border-color: var(--bt-color-primary);
    font-weight: var(--bt-fw-semibold);
    cursor: default;
    pointer-events: none;
  }

  .bt-pagination__page--gap {
    border: none;
    background: none;
    color: var(--bt-color-text-muted);
    cursor: default;
    pointer-events: none;
  }

  .bt-pagination__btn--disabled {
    opacity: 0.3;
    cursor: not-allowed;
    pointer-events: none;
  }
{% endstylesheet %}
