{% comment %} card-product.liquid — Product card with Plant Atelier styling. Thin-border gallery frame, care/light chips in body, quick-add on hover. {% endcomment %}
{%- liquid
  assign ratio = image_ratio | default: '4-5'
  assign aspect = '4 / 5'
  if ratio == '1-1'
    assign aspect = '1 / 1'
  elsif ratio == '3-4'
    assign aspect = '3 / 4'
  endif
  assign show_sale = show_sale_badge | default: settings.show_sale_badge
  assign show_sold = show_sold_out_badge | default: settings.show_sold_out_badge
  assign show_care = show_care_badge | default: settings.show_care_badge | default: false
  assign show_light = show_light_badge | default: settings.show_light_badge | default: false
  comment
    Specimen frame: opt-in per section (enable_specimen_frame). Wraps the
    media in the herbarium double-line mount (white mat + hairline + outer
    ring). Defaults off so existing placements keep their current look.
  endcomment
  assign specimen_frame = specimen_frame | default: false

  comment
    LCP control: callers pass loading: 'eager', fetchpriority: 'high'
    for the first above-the-fold cards; everyone else stays lazy/auto.
  endcomment
  assign primary_loading = loading | default: 'lazy'
  assign primary_fetch = fetchpriority | default: 'auto'

  assign care_label = ''
  assign care_class = ''
  if product.tags contains 'care-easy'
    assign care_label = 'Easy'
    assign care_class = 'bt-chip--easy'
  elsif product.tags contains 'care-medium'
    assign care_label = 'Moderate'
    assign care_class = 'bt-chip--medium'
  elsif product.tags contains 'care-expert'
    assign care_label = 'Expert'
    assign care_class = 'bt-chip--expert'
  endif

  assign light_label = ''
  assign light_dots = 0
  if product.tags contains 'light-bright'
    assign light_label = 'Bright'
    assign light_dots = 3
  elsif product.tags contains 'light-medium'
    assign light_label = 'Medium'
    assign light_dots = 2
  elsif product.tags contains 'light-low'
    assign light_label = 'Low'
    assign light_dots = 1
  endif
-%}
<div class="bt-card bt-card--product{% if specimen_frame %} bt-card--specimen{% endif %}{% if show_secondary_image and product.media[1] != blank %} bt-card--swap{% endif %}">
  <div class="bt-card__media" style="aspect-ratio: {{ aspect }}">
    <a href="{{ product.url }}" aria-label="{{ product.title }}" class="bt-card__media-link">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 600 | image_tag: loading: primary_loading, fetchpriority: primary_fetch, widths: '300,400,500,600', sizes: '(min-width: 990px) 33vw, 50vw', alt: product.featured_media.alt | default: product.title, class: 'bt-product-card__image' }}
        {%- if show_secondary_image and product.media[1] != blank -%}
          {{ product.media[1] | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,400,500,600', sizes: '(min-width: 990px) 33vw, 50vw', alt: product.media[1].alt | default: product.title, class: 'bt-product-card__image bt-card__secondary-image' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'bt-card__placeholder' }}
      {%- endif -%}
    </a>

    {%- if show_sale and product.compare_at_price > product.price -%}
      <span class="bt-tag bt-tag--sale bt-card__sale-badge">{{ 'products.product.on_sale' | t }}</span>
    {%- elsif product.available and product.tags contains 'new' -%}
      <span class="bt-tag bt-tag--new bt-card__sale-badge">{{ 'products.product.new_badge' | t }}</span>
    {%- endif -%}
    {%- if show_sold and product.available == false -%}
      <span class="bt-tag bt-tag--soldout bt-card__sale-badge">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}

    {%- if product.available -%}
      <button type="button" class="bt-card__quick-add" data-variant-id="{{ product.selected_or_first_available_variant.id }}" aria-label="{{ 'products.product.add_to_cart' | t }}">
        <svg width="16" height="16" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M7 2v10" stroke="currentColor" stroke-width="2"/></svg>
        <span class="bt-card__quick-add-label">{{ 'products.product.add_to_cart' | t }}</span>
      </button>
    {%- endif -%}
  </div>

  <div class="bt-card__body">
    {%- if show_care and care_label != '' or show_light and light_dots > 0 -%}
      <div class="bt-card__chips">
        {%- if show_care and care_label != '' -%}
          <span class="bt-chip {{ care_class }}">
            {% render 'icon-leaf' %}
            {{ care_label }}
          </span>
        {%- endif -%}
        {%- if show_light and light_dots > 0 -%}
          <span class="bt-chip bt-chip--light">
            {% render 'icon-sun' %}
            {{ light_label }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

    <h3 class="bt-card__title bt-product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>

    {%- comment -%} Specimen corner: Latin metafield wins, otherwise the vendor
        (when enabled) — one quiet serif-italic line under the title. {%- endcomment -%}
    {%- assign latin_name = product.metafields.custom.latin_name.value -%}
    {%- assign specimen_line = '' -%}
    {%- if show_latin_name != false and latin_name != blank -%}
      {%- assign specimen_line = latin_name -%}
    {%- elsif show_vendor and product.vendor != blank -%}
      {%- assign specimen_line = product.vendor -%}
    {%- endif -%}
    {%- if specimen_line != '' -%}
      <p class="bt-card__latin">{{ specimen_line | escape }}</p>
    {%- endif -%}

    <div class="bt-card__price">
      {%- if product.compare_at_price > product.price -%}
        <s class="bt-card__compare-price">{{ product.compare_at_price | money }}</s>
        <span class="bt-card__current-price">{{ product.price | money }}</span>
      {%- else -%}
        <span class="bt-card__current-price">{{ product.price | money }}</span>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /* ── Product card (Plant Atelier style) ── */
  .bt-card--product {
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-card);
    background: var(--bt-color-surface-raised, var(--bt-color-surface));
    transition: border-color 250ms var(--bt-ease-out),
                box-shadow 250ms var(--bt-ease-out),
                transform 250ms var(--bt-ease-out);
  }
  /* Elevation (shadow + 4px lift) comes from the base .bt-card rules in
     base.css, already gated by hover-capability and reduced-motion; here we
     only tighten the hairline on hover. */
  @media (hover: hover) {
    .bt-card--product:hover {
      border-color: var(--bt-color-border-medium);
    }
  }

  .bt-card__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--bt-radius-card) var(--bt-radius-card) 0 0;
    background: var(--bt-color-surface-hover);
  }

  .bt-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Warm archival tint over the photo ──
     Soft-light golden wash; strength comes from --bt-img-tint
     (Theme settings → Visual craft; 0 → body.bt-no-img-tint removes the
     layer entirely). Paints above the image(s) but below the badge /
     quick-add layer (z-index 2), so hover crossfade and controls stay
     untouched. Inset follows the specimen mat padding when present. */
  .bt-card__media::after {
    content: '';
    position: absolute;
    inset: var(--bt-specimen-pad, 0);
    z-index: 1;
    background: linear-gradient(160deg, rgb(255 214 165 / var(--bt-img-tint, 0.07)), rgb(120 100 60 / calc(var(--bt-img-tint, 0.07) * 0.7)) 70%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .bt-no-img-tint .bt-card__media::after { content: none; }

  .bt-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--bt-duration-slow) var(--bt-ease-out);
  }
  /* Hover zoom — pointer-capable devices only, motion-safe. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bt-card--product:hover .bt-card__media img {
      transform: scale(1.04);
    }
  }

  .bt-card__placeholder {
    width: 100%;
    height: 100%;
    background: var(--bt-color-surface);
  }

  /* ── Specimen frame (opt-in: section setting enable_specimen_frame) ──
     Herbarium double-line mount around the media: white mat padding,
     1px hairline, outer 1px shadow ring — same language as the hero
     product card. Applied to the outer media container so hover
     crossfade / zoom on the inner <img> keeps working untouched. */
  .bt-card--specimen .bt-card__media {
    --bt-specimen-pad: var(--bt-space-2xs);
    margin: var(--bt-space-xs) var(--bt-space-xs) 0;
    padding: var(--bt-specimen-pad);
    background: var(--bt-color-surface);
    border: 1px solid var(--bt-hairline);
    border-radius: var(--bt-radius-tag);
    /* Ring mount + a soft drop under the mat so the mounting paper reads
       as floating above the card face. */
    box-shadow: 0 0 0 3px var(--bt-color-surface), 0 0 0 4px var(--bt-hairline),
                var(--bt-shadow-specimen-mat);
  }
  /* Absolutely-positioned swap image aligns to the padding box — pull it
     back onto the mat so both frames crossfade inside the mount. */
  .bt-card--specimen .bt-card__secondary-image {
    inset: var(--bt-specimen-pad);
  }

  /* ── Sale badge ── */
  .bt-card__sale-badge {
    position: absolute;
    top: var(--bt-space-xs);
    left: var(--bt-space-xs);
    z-index: 2;
  }

  /* ── Quick-add bar (full-width, slides up on hover) ── */
  .bt-card__quick-add {
    position: absolute;
    left: var(--bt-space-xs);
    right: var(--bt-space-xs);
    bottom: var(--bt-space-xs);
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--bt-space-2xs);
    padding: 0 var(--bt-space-sm);
    background: rgba(var(--bt-color-bg-rgb), 0.96);
    backdrop-filter: blur(6px);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-md);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    font-family: var(--bt-font-body);
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.02em;
    color: var(--bt-color-text);
    transition: opacity var(--bt-duration-base) var(--bt-ease-out),
                transform var(--bt-duration-base) var(--bt-ease-out),
                background var(--bt-duration-fast) var(--bt-ease-out),
                color var(--bt-duration-fast) var(--bt-ease-out);
    z-index: 2;
    box-shadow: var(--bt-shadow-sm);
  }
  .bt-card--product:hover .bt-card__quick-add,
  .bt-card--product:focus-within .bt-card__quick-add {
    opacity: 1;
    transform: translateY(0);
  }
  .bt-card__quick-add:hover {
    background: var(--bt-color-primary);
    color: var(--bt-color-primary-contrast);
    border-color: var(--bt-color-primary);
  }
  .bt-card__quick-add.is-loading {
    opacity: 1;
    pointer-events: none;
    background: var(--bt-color-primary);
    color: var(--bt-color-primary-contrast);
  }
  .bt-card__quick-add.is-loading svg {
    animation: bt-qv-spin 0.8s linear infinite;
  }
  .bt-card__quick-add.is-added {
    opacity: 1;
    background: var(--bt-color-primary);
    color: var(--bt-color-primary-contrast);
    border-color: var(--bt-color-primary);
  }
  @keyframes bt-qv-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .bt-card__quick-add.is-loading svg { animation: none; }
  }
  .bt-card__quick-add svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* ── Latin name / vendor specimen line ── */
  .bt-card__latin {
    font-family: var(--bt-font-heading);
    font-style: italic;
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
    margin: calc(var(--bt-space-3xs) * -0.5) 0 0;
  }

  /* ── Card body — hairline seam above the info block (specimen corner) ── */
  .bt-card--product .bt-card__body {
    padding: var(--bt-space-sm) var(--bt-space-sm) var(--bt-space-md);
    gap: var(--bt-space-2xs);
    border-top: 1px solid var(--bt-hairline);
  }

  /* ── Care chips row ── */
  .bt-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--bt-space-3xs);
  }

  .bt-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    font-family: var(--bt-font-body);
    font-size: 0.625rem;
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.5;
    border-radius: var(--bt-radius-pill);
    background: var(--bt-color-surface-hover);
    color: var(--bt-color-text-muted);
    border: 1px solid var(--bt-color-border-light);
    white-space: nowrap;
  }
  .bt-chip svg {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
  }

  .bt-chip--easy {
    color: var(--bt-color-primary);
    background: var(--bt-color-primary-tint);
    border-color: rgba(var(--bt-color-primary-rgb), 0.2);
  }
  .bt-chip--medium {
    color: var(--bt-color-secondary);
    background: var(--bt-color-secondary-tint);
    border-color: rgba(var(--bt-color-secondary-rgb), 0.2);
  }
  .bt-chip--expert {
    color: var(--bt-color-text);
    background: var(--bt-color-surface-hover);
    border-color: rgba(var(--bt-color-text-rgb), 0.2);
  }
  .bt-chip--light {
    gap: 3px;
  }
  .bt-chip--light svg {
    color: var(--bt-color-secondary);
  }

  /* ── Title ── */
  .bt-card--product .bt-card__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-medium);
    line-height: var(--bt-lh-heading);
    margin: 0;
  }
  .bt-card--product .bt-card__title a {
    text-decoration: none;
    color: var(--bt-color-text);
    transition: color var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-card--product .bt-card__title a:hover {
    color: var(--bt-color-primary);
    text-decoration: underline;
    text-underline-offset: 0.12em;
    text-decoration-thickness: 1px;
  }

  /* ── Price — current price carries the antique-gold highlight ── */
  .bt-card--product .bt-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--bt-space-2xs);
    margin-top: auto;
  }
  .bt-card__current-price {
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    /* Gold highlight: secondary-text is the WCAG-checked accent ladder
       (≥4.5:1 on the card surface across every scheme). */
    color: var(--bt-color-secondary-text);
  }
  .bt-card__compare-price {
    font-size: var(--bt-fs-body-xs);
    color: var(--bt-color-text-muted);
    text-decoration: line-through;
  }

  /* ── Secondary image swap — 250ms crossfade, hover-capable + motion-safe only ── */
  .bt-card--swap .bt-card__media img {
    transition: opacity 250ms var(--bt-ease-out),
                transform var(--bt-duration-slow) var(--bt-ease-out);
  }
  .bt-card--swap .bt-card__secondary-image {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bt-card--swap:hover .bt-card__media-link img:first-child,
    .bt-card--swap:focus-within .bt-card__media-link img:first-child {
      opacity: 0;
    }
    .bt-card--swap:hover .bt-card__secondary-image,
    .bt-card--swap:focus-within .bt-card__secondary-image {
      opacity: 1;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 749px) {
    .bt-card--product .bt-card__body {
      padding: var(--bt-space-xs);
    }
    /* Two-up mobile grids: step the info block down one notch so title /
       specimen line / price stay composed at ~half viewport width. */
    .bt-card--product .bt-card__title {
      font-size: var(--bt-fs-body);
    }
    .bt-card__latin {
      font-size: var(--bt-fs-body-xs);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .bt-card__quick-add {
      opacity: 1;
      transform: none;
      min-height: 40px;
      font-size: var(--bt-fs-body-xs);
      left: var(--bt-space-2xs);
      right: var(--bt-space-2xs);
      bottom: var(--bt-space-2xs);
      white-space: nowrap;
      gap: 4px;
    }
    .bt-chip {
      font-size: 0.6rem;
      padding: 1px 6px;
    }
  }

  /* Narrow phones: drop the Latin/vendor specimen line so the two-up grid
     keeps a clean title → price rhythm. */
  @media (max-width: 479px) {
    .bt-card__latin {
      display: none;
    }
    .bt-card--product .bt-card__title a {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }

  @media (hover: none) {
    .bt-card__quick-add {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}
