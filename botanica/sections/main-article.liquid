  "name": "t:sections.main_article.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout_style",
      "label": "t:sections.main_article.settings.layout_style.label",
      "options": [
        { "value": "substack", "label": "Substack — Clean reading" },
        { "value": "magazine", "label": "Magazine — Editorial" },
        { "value": "sidebar", "label": "Sidebar — With TOC" }
      ],
      "default": "substack"
    },
    {
      "type": "checkbox",
      "id": "show_progress_bar",
      "label": "t:sections.main_article.settings.show_progress_bar.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "t:sections.main_article.settings.show_share.label",
      "default": true
    }
  ],
  "presets": [{ "name": "t:sections.main_article.name" }]
}
{% endschema %}
