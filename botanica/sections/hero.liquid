{% comment %}
  sections/hero.liquid — Specimen-plate editorial hero.
  Two-column composition (~55/45): eyebrow micro-label, oversized fluid display
  headline (inline richtext → italic accent words), short copy, one primary CTA.
  The headline overlaps the image column edge; the image is framed as a
  specimen plate (double hairline frame + Nº / Latin-name caption row).
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign layout = section.settings.layout | default: 'image_right'
  assign image = section.settings.image
  assign image_mobile = section.settings.image_mobile | default: image
  assign heading = section.settings.heading
  assign heading_size = section.settings.heading_size | default: 'xl'
  assign text = section.settings.text
  assign eyebrow = section.settings.eyebrow
  assign button_label = section.settings.button_label
  assign button_link = section.settings.button_link
  assign button_style = section.settings.button_style | default: 'primary'
  assign specimen_number = section.settings.specimen_number
  assign latin_caption = section.settings.latin_caption
  assign hero_product = section.settings.product
  assign hero_product_label = section.settings.product_label

  assign ratio = section.settings.image_ratio | default: '4-5'
  assign aspect = '4 / 5'
  if ratio == '1-1'
    assign aspect = '1 / 1'
  elsif ratio == '3-4'
    assign aspect = '3 / 4'
  endif

  assign hero_alt = image.alt | default: heading | strip_html | escape
-%}
<section
  class="bt-hero bt-hero--{{ layout }} bt-section-block color-{{ section.settings.color_scheme }}{% if section.settings.full_width %} bt-hero--full{% endif %}"
  {{ section.shopify_attributes }}
>
  <div class="bt-hero__inner{% unless section.settings.full_width %} bt-container{% endunless %}">
    <div class="bt-hero__grid">
      <div class="bt-hero__intro">
        {%- if eyebrow != blank -%}
          <p class="bt-hero__eyebrow bt-micro-label"{% if section.settings.enable_reveal %} data-bt-reveal="load"{% endif %}>{{ eyebrow | escape }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h1 class="bt-hero__heading bt-display-{{ heading_size }}"{% if section.settings.enable_reveal %} data-bt-reveal="load" data-bt-reveal-delay="120"{% endif %}>{{ heading }}</h1>
        {%- endif -%}
      </div>

      <figure class="bt-hero__plate"{% if section.settings.enable_reveal %} data-bt-reveal="load" data-bt-reveal-delay="360"{% endif %}>
        <div class="bt-hero__frame">
          <div class="bt-hero__media" style="aspect-ratio: {{ aspect }}">
            {%- if image != blank -%}
              {%- assign has_mobile = false -%}
              {%- if image_mobile != blank and image_mobile != image -%}
                {%- assign has_mobile = true -%}
              {%- endif -%}
              {%- if has_mobile -%}
                <picture>
                  <source media="(max-width: 749px)" srcset="{{ image_mobile | image_url: width: 750 }} 750w">
                  <img src="{{ image | image_url: width: 1200 }}"
                    srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w"
                    sizes="(min-width: 750px) 45vw, 100vw"
                    alt="{{ hero_alt }}" class="bt-hero__img"
                    width="{{ image.width }}" height="{{ image.height }}"
                    fetchpriority="high" loading="eager" decoding="async">
                </picture>
              {%- else -%}
                <img src="{{ image | image_url: width: 1200 }}"
                  srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 750px) 45vw, 100vw"
                  alt="{{ hero_alt }}" class="bt-hero__img"
                  width="{{ image.width }}" height="{{ image.height }}"
                  fetchpriority="high" loading="eager" decoding="async">
              {%- endif -%}
            {%- else -%}
              <div class="bt-hero__placeholder" aria-hidden="true">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'bt-hero__placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
          {%- if hero_product != blank -%}
            <div class="bt-hero__product-card">
              <span class="bt-hero__product-media">
                {%- if hero_product.featured_media -%}
                  {{ hero_product.featured_media | image_url: width: 300 | image_tag:
                    loading: 'lazy',
                    widths: '150, 300',
                    sizes: '72px',
                    alt: hero_product.featured_media.alt | default: hero_product.title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'bt-hero__product-placeholder' }}
                {%- endif -%}
              </span>
              <span class="bt-hero__product-body">
                {%- if hero_product_label != blank -%}
                  <span class="bt-hero__product-label bt-micro-label">{{ hero_product_label | escape }}</span>
                {%- endif -%}
                <a
                  href="{{ hero_product.url }}"
                  class="bt-hero__product-title"
                  aria-label="{{ 'products.product.view_product' | t }}: {{ hero_product.title | escape }}"
                >{{ hero_product.title | escape }}</a>
                <span class="bt-hero__product-price">
                  {%- if hero_product.compare_at_price > hero_product.price -%}
                    <s>{{ hero_product.compare_at_price | money }}</s>
                  {%- endif -%}
                  {%- if hero_product.price_varies -%}
                    {{ 'products.product.price.from_price_html' | t: price: hero_product.price | money }}
                  {%- else -%}
                    {{ hero_product.price | money }}
                  {%- endif -%}
                </span>
              </span>
            </div>
          {%- endif -%}
        </div>
        {%- if specimen_number != blank or latin_caption != blank -%}
          <figcaption class="bt-hero__caption">
            {% render 'specimen-tag', number: specimen_number, latin: latin_caption %}
          </figcaption>
        {%- endif -%}
      </figure>

      <div class="bt-hero__body"{% if section.settings.enable_reveal %} data-bt-reveal="load" data-bt-reveal-delay="240"{% endif %}>
        {%- if text != blank -%}
          <p class="bt-hero__text">{{ text | escape }}</p>
        {%- endif -%}
        {%- if button_label != blank -%}
          <a href="{{ button_link | default: '#' }}" class="bt-btn bt-btn--{{ button_style }} bt-btn--lg">
            {{ button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if section.blocks.size > 0 -%}
    <div class="bt-hero__blocks{% unless section.settings.full_width %} bt-container{% endunless %}">
      {% content_for "blocks" %}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .bt-hero {
    position: relative;
    overflow: hidden;
  }
  .bt-hero--full .bt-hero__inner {
    padding-inline: var(--bt-page-gutter);
  }

  /* ── Two-column editorial grid (~55/45) ── */
  .bt-hero__grid {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    grid-template-rows: auto auto;
    row-gap: var(--bt-space-lg);
    align-content: center;
  }
  .bt-hero__intro {
    grid-column: 1;
    grid-row: 1;
    align-self: end;
    position: relative;
    z-index: 2;
    /* Signature overlap: the headline extends ~8–12% of the image width
       over the specimen plate. */
    margin-inline-end: calc(-1 * clamp(2rem, 5vw, 4.5rem));
  }
  .bt-hero__body {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    padding-inline-end: clamp(1.5rem, 3.5vw, 3.5rem);
  }
  .bt-hero__plate {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: center;
    margin: 0;
    min-width: 0;
  }

  /* ── Flipped: image left, text right ── */
  .bt-hero--image_left .bt-hero__grid {
    grid-template-columns: 0.88fr 1.12fr;
  }
  .bt-hero--image_left .bt-hero__plate {
    grid-column: 1;
  }
  .bt-hero--image_left .bt-hero__intro {
    grid-column: 2;
    margin-inline-end: 0;
    margin-inline-start: calc(-1 * clamp(2rem, 5vw, 4.5rem));
  }
  .bt-hero--image_left .bt-hero__body {
    grid-column: 2;
    padding-inline-end: 0;
    padding-inline-start: clamp(1.5rem, 3.5vw, 3.5rem);
  }

  /* ── Type ── */
  .bt-hero__eyebrow {
    margin: 0 0 var(--bt-space-md);
  }
  .bt-hero__heading {
    margin: 0;
    max-width: 12ch;
  }
  .bt-hero__heading em {
    letter-spacing: -0.01em;
  }
  .bt-hero__text {
    font-size: calc(var(--bt-fs-body) * 1.0625);
    line-height: var(--bt-lh-body);
    color: var(--bt-color-text-muted);
    margin: 0 0 var(--bt-space-lg);
    max-width: 46ch;
  }

  /* ── Specimen plate: outer hairline + inner offset hairline frame ── */
  .bt-hero__frame {
    position: relative;
    --bt-hero-frame-pad: clamp(8px, 0.9vw, 12px);
    padding: var(--bt-hero-frame-pad);
    border: 1px solid var(--bt-hairline);
    background: var(--bt-color-surface);
  }
  /* ── Photo treatment: bottom fade-to-page + warm archival tint ──
     Both layers are inset by the mat padding so the paper frame and its
     hairlines stay crisp (the fade never washes the mat). They paint
     above the photo but below the overlapping headline (z-index 2 on
     .bt-hero__intro) and the floating product card (z-index 3).
     The fade is always on; tint strength follows --bt-img-tint (Theme
     settings → Visual craft) and is removed entirely when set to 0. */
  .bt-hero__frame::before {
    content: '';
    position: absolute;
    inset: var(--bt-hero-frame-pad);
    z-index: 1;
    background: linear-gradient(180deg, rgb(var(--bt-color-bg-rgb) / 0) 75%, var(--bt-color-bg) 100%);
    pointer-events: none;
  }
  .bt-hero__frame::after {
    content: '';
    position: absolute;
    inset: var(--bt-hero-frame-pad);
    z-index: 1;
    background: linear-gradient(160deg, rgb(255 214 165 / var(--bt-img-tint, 0.07)), rgb(120 100 60 / calc(var(--bt-img-tint, 0.07) * 0.7)) 70%);
    mix-blend-mode: soft-light;
    pointer-events: none;
  }
  .bt-no-img-tint .bt-hero__frame::after { content: none; }
  .bt-hero__media {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--bt-hairline);
    background: var(--bt-color-surface-hover);
  }
  .bt-hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-hero__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .bt-hero__placeholder-svg {
    width: 60%;
    max-width: 320px;
    opacity: 0.15;
  }
  .bt-hero__caption {
    margin-top: var(--bt-space-sm);
  }

  /* ── Floating featured-product card — specimen mini card, double hairline ── */
  .bt-hero__product-card {
    position: absolute;
    inset-inline-end: calc(-1 * var(--bt-space-sm));
    bottom: var(--bt-space-md);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: var(--bt-space-sm);
    width: min(260px, 72%);
    padding: var(--bt-space-xs);
    background: var(--bt-color-surface);
    border: 1px solid var(--bt-hairline);
    box-shadow: 0 0 0 3px var(--bt-color-surface), 0 0 0 4px var(--bt-hairline), var(--bt-shadow-sm);
    transition: transform var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-hero__product-card:hover {
    transform: translateY(-2px);
  }
  .bt-hero__product-card:focus-within {
    outline: var(--bt-focus-ring-width) solid var(--bt-color-focus-ring);
    outline-offset: 5px;
  }
  .bt-hero__product-media {
    flex-shrink: 0;
    display: block;
    width: 72px;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--bt-hairline);
    background: var(--bt-color-surface-hover);
    overflow: hidden;
  }
  .bt-hero__product-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-hero__product-placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }
  .bt-hero__product-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .bt-hero__product-label {
    color: var(--bt-color-text-muted);
  }
  .bt-hero__product-title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-body);
    line-height: var(--bt-lh-heading);
    color: var(--bt-color-text);
    text-decoration: none;
  }
  /* Stretched link: the whole card is clickable through this one anchor */
  .bt-hero__product-title::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .bt-hero__product-card:hover .bt-hero__product-title {
    color: var(--bt-color-primary);
  }
  .bt-hero__product-price {
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
  }
  .bt-hero__product-price s {
    opacity: 0.6;
    margin-inline-end: 0.4em;
  }

  /* ── Optional theme/app blocks row ── */
  .bt-hero__blocks {
    margin-top: var(--bt-space-2xl);
    padding-top: var(--bt-space-xl);
    border-top: 1px solid var(--bt-hairline);
  }
  .bt-hero--full .bt-hero__blocks {
    padding-inline: var(--bt-page-gutter);
  }

  /* ── Mobile: stacked, no overlap — eyebrow → headline → plate → copy → CTA ── */
  @media (max-width: 749px) {
    .bt-hero__grid,
    .bt-hero--image_left .bt-hero__grid {
      display: flex;
      flex-direction: column;
      row-gap: var(--bt-space-lg);
    }
    .bt-hero__intro,
    .bt-hero--image_left .bt-hero__intro {
      margin-inline: 0;
    }
    .bt-hero__body,
    .bt-hero--image_left .bt-hero__body {
      padding-inline: 0;
    }
    .bt-hero__heading {
      max-width: 16ch;
    }
    /* Featured-product card leaves the float and joins the flow under the image */
    .bt-hero__product-card {
      position: relative;
      inset-inline-end: auto;
      bottom: auto;
      width: 100%;
      margin-top: var(--bt-space-sm);
      box-shadow: none;
    }
    .bt-hero__product-card:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.hero.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.hero.settings.layout.label",
      "options": [
        { "value": "image_right", "label": "t:sections.hero.settings.layout.options__1.label" },
        { "value": "image_left", "label": "t:sections.hero.settings.layout.options__2.label" }
      ],
      "default": "image_right"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.hero.settings.full_width.label",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.hero.settings.image_mobile.label",
      "info": "t:sections.hero.settings.image_mobile.info"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.hero.settings.image_ratio.label",
      "options": [
        { "value": "4-5", "label": "t:sections.hero.settings.image_ratio.options__1.label" },
        { "value": "3-4", "label": "t:sections.hero.settings.image_ratio.options__2.label" },
        { "value": "1-1", "label": "t:sections.hero.settings.image_ratio.options__3.label" }
      ],
      "default": "4-5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.hero.settings.eyebrow.label",
      "default": "Indoor Plants — Catalogue Nº 01"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label",
      "info": "t:sections.hero.settings.heading.info",
      "default": "Bring the <em>outside</em> in"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.hero.settings.heading_size.label",
      "options": [
        { "value": "xl", "label": "t:sections.hero.settings.heading_size.options__1.label" },
        { "value": "lg", "label": "t:sections.hero.settings.heading_size.options__2.label" },
        { "value": "md", "label": "t:sections.hero.settings.heading_size.options__3.label" }
      ],
      "default": "xl"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.hero.settings.text.label",
      "default": "Curated indoor plants selected for their beauty, resilience, and ability to transform any space into a living sanctuary."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.hero.settings.button_label.label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.hero.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.hero.settings.button_style.label",
      "options": [
        { "value": "primary", "label": "t:sections.hero.settings.button_style.options__1.label" },
        { "value": "outline", "label": "t:sections.hero.settings.button_style.options__2.label" }
      ],
      "default": "primary"
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "t:sections.all.enable_reveal.label",
      "info": "t:sections.all.enable_reveal.info",
      "default": false
    },
    {
      "type": "text",
      "id": "specimen_number",
      "label": "t:sections.hero.settings.specimen_number.label",
      "info": "t:sections.hero.settings.specimen_number.info",
      "default": "Nº 001"
    },
    {
      "type": "text",
      "id": "latin_caption",
      "label": "t:sections.hero.settings.latin_caption.label",
      "info": "t:sections.hero.settings.latin_caption.info",
      "default": "Monstera deliciosa"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.hero.settings.product.label",
      "info": "t:sections.hero.settings.product.info"
    },
    {
      "type": "text",
      "id": "product_label",
      "label": "t:sections.hero.settings.product_label.label",
      "default": "t:sections.hero.settings.product_label.default"
    }
  ],
  "presets": [{
    "name": "t:sections.hero.name"
  }]
}
{% endschema %}
