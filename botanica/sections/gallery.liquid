{% comment %}
  sections/gallery.liquid — Image gallery grid
  2-4 column responsive grid. Uses image blocks.
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign heading = section.settings.heading
  assign columns = section.settings.columns_desktop | default: 3
-%}
<section class="bt-section bt-gallery color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bt-container">
    {%- if heading != blank -%}
      <h2 class="bt-gallery__heading">{{ heading | escape }}</h2>
    {%- endif -%}
    <div class="bt-gallery__grid bt-gallery__grid--{{ columns }}-col">
      {% content_for "blocks" %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bt-gallery__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    text-align: center;
    margin: 0 0 var(--bt-space-lg);
  }
  .bt-gallery__grid {
    display: grid;
    gap: var(--bt-grid-gap);
  }
  .bt-gallery__grid--2-col { grid-template-columns: repeat(2, 1fr); }
  .bt-gallery__grid--3-col { grid-template-columns: repeat(3, 1fr); }
  .bt-gallery__grid--4-col { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 749px) {
    .bt-gallery__grid--3-col, .bt-gallery__grid--4-col { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 479px) {
    .bt-gallery__grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.gallery.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.gallery.settings.heading.label"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.gallery.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.gallery.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.gallery.settings.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.gallery.settings.columns_desktop.options__3.label" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.gallery.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.gallery.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.gallery.name",
    "blocks": [
      { "type": "image" },
      { "type": "image" },
      { "type": "image" }
    ]
  }]
}
{% endschema %}
