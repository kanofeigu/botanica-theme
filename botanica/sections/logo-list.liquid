{% comment %}
  sections/logo-list.liquid — Partner/brand logo grid
  Uses logo-item blocks. Responsive auto-grid.
  All-original. Zero Dawn code.
{% endcomment %}
<section class="bt-section bt-logo-list" {{ section.shopify_attributes }}>
  <div class="bt-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="bt-logo-list__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="bt-logo-list__grid">
      {% content_for "blocks" %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bt-logo-list__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h3);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    text-align: center;
    margin: 0 0 var(--bt-space-lg);
  }
  .bt-logo-list__grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--bt-space-md);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.logo_list.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.logo_list.settings.heading.label",
      "default": "Trusted by"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 32, "unit": "px",
      "label": "t:sections.logo_list.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 32, "unit": "px",
      "label": "t:sections.logo_list.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.logo_list.name",
    "blocks": [
      { "type": "logo-item" },
      { "type": "logo-item" },
      { "type": "logo-item" },
      { "type": "logo-item" }
    ]
  }]
}
{% endschema %}
