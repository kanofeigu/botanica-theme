{% comment %} contact-form.liquid — Original contact form section. Zero Dawn code. {% endcomment %}
<div class="bt-section bt-contact color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bt-container">
    <div style="max-width: 600px; margin-inline: auto;">
      {%- if section.settings.show_title -%}
        <h1 class="bt-h1 bt-text-center">{{ page.title }}</h1>
      {%- endif -%}
      {%- form 'contact', class: 'bt-contact__form bt-stack-md' -%}
        {%- if form.posted_successfully? -%}
          <p class="bt-form-success" role="alert">{{ 'contact.form.post_success' | t }}</p>
        {%- endif -%}
        <div>
          <label for="ContactFormName" class="bt-label">{{ 'contact.form.name' | t }}</label>
          <input type="text" id="ContactFormName" name="contact[name]" class="bt-input" value="{{ form.name }}" required autocomplete="name">
        </div>
        <div>
          <label for="ContactFormEmail" class="bt-label">{{ 'contact.form.email' | t }}</label>
          <input type="email" id="ContactFormEmail" name="contact[email]" class="bt-input" value="{{ form.email }}" required autocomplete="email">
          {%- if form.errors contains 'email' -%}<p class="bt-form-error">{{ form.errors.messages.email }}</p>{%- endif -%}
        </div>
        <div>
          <label for="ContactFormBody" class="bt-label">{{ 'contact.form.message' | t }}</label>
          <textarea id="ContactFormBody" name="contact[body]" class="bt-textarea" rows="6" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="bt-btn bt-btn--primary bt-btn--lg bt-btn--block">{{ 'contact.form.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .bt-contact__form { margin-top: var(--bt-space-lg); }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.contact_form.name", "settings": [
  { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
  { "type": "checkbox", "id": "show_title", "label": "t:sections.contact_form.settings.show_title.label", "default": false }
], "presets": [{ "name": "t:sections.contact_form.name" }] }
{% endschema %}
