{% comment %}
  sections/newsletter.liquid — Email newsletter signup section
  Two layouts:
    'statement' (default) — full-width dark band (scheme-3 by default):
      oversized centered serif headline, underline-style input row.
    'card' — the original centered card on the section surface.
  Native Shopify form with customizable heading/description.
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign layout = section.settings.layout | default: 'statement'
-%}
<section class="bt-section bt-newsletter bt-newsletter--{{ layout }} color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bt-container">
    <div class="bt-newsletter__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="bt-newsletter__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="bt-newsletter__desc">{{ section.settings.description | escape }}</p>
      {%- endif -%}
      {%- liquid
        assign newsletter_form_id = 'newsletter-form-' | append: section.id
      -%}
      {%- form 'customer', id: newsletter_form_id, class: 'bt-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="bt-newsletter__fields">
          <label for="NewsletterForm-{{ section.id }}" class="bt-sr-only">
            {{ 'newsletter.label' | t }}
          </label>
          <input
            id="NewsletterForm-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="bt-input bt-newsletter__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="NewsletterError-{{ section.id }}"
            {% elsif form.posted_successfully? %}
              aria-describedby="NewsletterSuccess-{{ section.id }}"
            {% endif %}
            placeholder="{{ 'newsletter.label' | t }}"
            required
          >
          <button type="submit" class="bt-btn bt-btn--primary" name="commit">
            {{ 'newsletter.button_label' | t }}
          </button>
        </div>
        {%- if form.errors -%}
          <small id="NewsletterError-{{ section.id }}" class="bt-form-error" role="alert">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
          </small>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <p id="NewsletterSuccess-{{ section.id }}" class="bt-newsletter__success" role="status" tabindex="-1" autofocus>
            {{ 'newsletter.success' | t }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .bt-newsletter__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    margin: 0 0 var(--bt-space-2xs);
  }
  .bt-newsletter__desc {
    color: var(--bt-color-text-muted);
    font-size: var(--bt-fs-body-sm);
    margin: 0 0 var(--bt-space-md);
  }
  .bt-newsletter__form { margin-top: var(--bt-space-sm); }
  .bt-newsletter__fields {
    display: flex;
    gap: var(--bt-space-2xs);
  }
  .bt-newsletter__input {
    flex: 1;
    min-width: 0;
  }
  .bt-form-error {
    display: block;
    margin-top: var(--bt-space-2xs);
    color: var(--bt-color-secondary);
  }
  .bt-newsletter__success {
    margin-top: var(--bt-space-sm);
    color: var(--bt-color-primary);
    font-weight: var(--bt-fw-medium);
  }

  /* ── Card layout (original): centered card on the section surface ── */
  .bt-newsletter--card .bt-newsletter__inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding: var(--bt-space-xl) var(--bt-space-md);
    background: var(--bt-color-surface);
    border-radius: var(--bt-radius-card);
  }

  /* ── Statement layout (default): full-width band, oversized centered
     serif headline, underline input. Colors come entirely from the
     section's color scheme (deep green scheme-3 by default). ── */
  .bt-newsletter--statement .bt-newsletter__inner {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    padding: var(--bt-space-xl) 0;
  }
  .bt-newsletter--statement .bt-newsletter__heading {
    font-size: var(--bt-fs-display-lg);
    line-height: var(--bt-lh-display-lg);
    letter-spacing: var(--bt-ls-display);
    max-width: 16ch;
    margin: 0 auto var(--bt-space-sm);
    text-wrap: balance;
  }
  .bt-newsletter--statement .bt-newsletter__desc {
    font-size: var(--bt-fs-body);
    max-width: 46ch;
    margin: 0 auto var(--bt-space-lg);
  }
  .bt-newsletter--statement .bt-newsletter__fields {
    max-width: 520px;
    margin: 0 auto;
    gap: var(--bt-space-sm);
    align-items: flex-end;
  }
  .bt-newsletter--statement .bt-newsletter__input {
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--bt-color-border-medium);
    border-radius: 0;
    padding-inline: 0.25em;
  }
  .bt-newsletter--statement .bt-newsletter__input:focus {
    border-color: transparent;
    border-bottom-color: var(--bt-color-text);
    box-shadow: none;
  }
  .bt-newsletter--statement .bt-newsletter__input::placeholder {
    color: var(--bt-color-text-muted);
    opacity: 0.8;
  }

  @media (max-width: 479px) {
    .bt-newsletter__fields { flex-direction: column; }
    .bt-newsletter--statement .bt-newsletter__fields { align-items: stretch; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-3" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.newsletter.settings.layout.label",
      "options": [
        { "value": "statement", "label": "t:sections.newsletter.settings.layout.options__1.label" },
        { "value": "card", "label": "t:sections.newsletter.settings.layout.options__2.label" }
      ],
      "default": "statement"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter.settings.heading.label",
      "default": "The Field Journal"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.newsletter.settings.description.label",
      "default": "Plant care guides, new arrivals, and seasonal tips delivered to your inbox every month."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.newsletter.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.newsletter.settings.padding_bottom.label"
    }
  ],
  "presets": [{ "name": "t:sections.newsletter.name" }]
}
{% endschema %}
