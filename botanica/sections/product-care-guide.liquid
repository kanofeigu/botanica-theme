{% comment %}
  sections/product-care-guide.liquid — Long-form care guide article on PDP.
  Heading + rich body (supports h3/p/ul/ol) + optional companion image.
  All content merchant-editable via section settings; no custom metafield.
  Inspired by Hey Rooted's "Red Prayer Plant Care Guide" block.
{% endcomment %}
{%- if section.settings.body != blank or section.settings.heading != blank -%}
  <section class="bt-care-guide" {{ section.shopify_attributes }}>
    <div class="bt-container bt-care-guide__inner">
      {%- if section.settings.image != blank -%}
        <div class="bt-care-guide__media">
          {{ section.settings.image | image_url: width: 900 | image_tag:
            loading: 'lazy',
            widths: '400, 600, 900',
            sizes: '(min-width: 750px) 40vw, 100vw',
            alt: section.settings.image.alt | default: section.settings.heading
          }}
        </div>
      {%- endif -%}
      <div class="bt-care-guide__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="bt-care-guide__eyebrow bt-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bt-care-guide__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="bt-care-guide__body bt-rich-text">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .bt-care-guide { padding-block: var(--bt-space-lg); }
  .bt-care-guide__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--bt-space-md);
  }
  .bt-care-guide__media {
    border-radius: var(--bt-radius-card);
    overflow: hidden;
    background: var(--bt-color-surface);
  }
  .bt-care-guide__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bt-care-guide__content { max-width: 72ch; }
  .bt-care-guide__eyebrow { margin-bottom: var(--bt-space-2xs); }
  .bt-care-guide__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    margin: 0 0 var(--bt-space-sm);
    color: var(--bt-color-text);
    text-wrap: balance;
  }
  .bt-care-guide__body {
    font-size: var(--bt-fs-body);
    line-height: var(--bt-lh-relaxed);
    color: var(--bt-color-text);
  }
  .bt-care-guide__body h3 {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-semibold);
    margin: var(--bt-space-md) 0 var(--bt-space-2xs);
    color: var(--bt-color-text);
  }
  .bt-care-guide__body p { margin: 0 0 var(--bt-space-2xs); }
  .bt-care-guide__body ul, .bt-care-guide__body ol { margin: 0 0 var(--bt-space-2xs); padding-left: 1.25em; }
  .bt-care-guide__body li { margin-bottom: var(--bt-space-3xs); }
  @media (min-width: 750px) {
    .bt-care-guide__inner { grid-template-columns: 2fr 3fr; align-items: start; gap: var(--bt-space-lg); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_care_guide.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.product_care_guide.settings.eyebrow.label", "default": "Care guide" },
    { "type": "text", "id": "heading", "label": "t:sections.product_care_guide.settings.heading.label", "default": "Plant care guide" },
    { "type": "richtext", "id": "body", "label": "t:sections.product_care_guide.settings.body.label", "default": "<p>Everything you need to keep this plant thriving. Read on for light, water, humidity, and troubleshooting tips.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:sections.product_care_guide.settings.image.label" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "t:sections.product_care_guide.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "t:sections.product_care_guide.settings.padding_bottom.label" }
  ],
  "presets": [{ "name": "t:sections.product_care_guide.name" }]
}
{% endschema %}
