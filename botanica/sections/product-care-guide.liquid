{% comment %}
  sections/product-care-guide.liquid — Long-form care guide article on PDP.
  Heading + rich body (supports h3/p/ul/ol) + optional companion image.
  All content merchant-editable via section settings; no custom metafield.
  Inspired by Hey Rooted's "Red Prayer Plant Care Guide" block.
{% endcomment %}
{%- if section.settings.body != blank or section.settings.heading != blank -%}
  <section class="bt-care-guide color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="bt-container bt-care-guide__inner">
      {%- if section.settings.image != blank -%}
        <div class="bt-care-guide__media">
          {{ section.settings.image | image_url: width: 900 | image_tag:
            loading: 'lazy',
            widths: '400, 600, 900',
            sizes: '(min-width: 750px) 40vw, 100vw',
            alt: section.settings.image.alt | default: section.settings.heading
          }}
        </div>
      {%- endif -%}
      <div class="bt-care-guide__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="bt-care-guide__eyebrow bt-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="bt-care-guide__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          {%- comment -%} Topic accordion: merchant richtext uses h3 per care
               topic (Light / Water / …). Split on those headings so each
               topic becomes an OPEN <details> — desktop (and no-JS) reads
               the long article flat; the script below collapses the topics
               on phones. Falls back to the flat body when no h3 structure
               exists. (CSS-forcing a closed <details> open does not paint
               its content in modern browsers.) {%- endcomment -%}
          {%- if section.settings.body contains '<h3>' -%}
            {%- assign chunks = section.settings.body | split: '<h3>' -%}
            {%- assign intro = chunks[0] | strip -%}
            {%- if intro != '' -%}
              <div class="bt-care-guide__body bt-rich-text">{{ intro }}</div>
            {%- endif -%}
            <div class="bt-care-guide__topics">
              {%- for chunk in chunks offset: 1 -%}
                {%- assign parts = chunk | split: '</h3>' -%}
                {%- if parts.size == 2 -%}
                  <details class="bt-care-guide__topic" open>
                    <summary class="bt-care-guide__topic-summary">
                      <span class="bt-care-guide__topic-title">{{ parts[0] | strip_html | strip }}</span>
                      <svg class="bt-care-guide__topic-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="bt-care-guide__topic-body bt-rich-text">{{ parts[1] }}</div>
                  </details>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {% comment %} Collapse topics on phones only; desktop keeps the
                 flat long-article layout. Synchronous — runs before first
                 paint, no flash of expanded topics on mobile. {% endcomment %}
            <script>
              (function () {
                var mq = window.matchMedia('(max-width: 749px)');
                function syncCareTopics() {
                  document.querySelectorAll('.bt-care-guide__topic').forEach(function (topic) {
                    topic.open = !mq.matches;
                  });
                }
                syncCareTopics();
                mq.addEventListener('change', syncCareTopics);
              })();
            </script>
          {%- else -%}
            <div class="bt-care-guide__body bt-rich-text">{{ section.settings.body }}</div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .bt-care-guide { padding-block: var(--bt-space-lg); }
  .bt-care-guide__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--bt-space-md);
  }
  .bt-care-guide__media {
    border-radius: var(--bt-radius-card);
    overflow: hidden;
    background: var(--bt-color-surface);
  }
  .bt-care-guide__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bt-care-guide__content { max-width: 72ch; }
  .bt-care-guide__eyebrow { margin-bottom: var(--bt-space-2xs); }
  .bt-care-guide__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    margin: 0 0 var(--bt-space-sm);
    color: var(--bt-color-text);
    text-wrap: balance;
  }
  .bt-care-guide__body {
    font-size: var(--bt-fs-body);
    line-height: var(--bt-lh-relaxed);
    color: var(--bt-color-text);
  }
  .bt-care-guide__body h3 {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-semibold);
    margin: var(--bt-space-md) 0 var(--bt-space-2xs);
    color: var(--bt-color-text);
  }
  .bt-care-guide__body p { margin: 0 0 var(--bt-space-2xs); }
  .bt-care-guide__body ul, .bt-care-guide__body ol { margin: 0 0 var(--bt-space-2xs); padding-left: 1.25em; }
  .bt-care-guide__body li { margin-bottom: var(--bt-space-3xs); }
  /* ── Topic accordions: collapsed rows on phones (the flat version read as
     a text wall); topics render open so desktop/no-JS show the full article. ── */
  .bt-care-guide__topics {
    display: flex;
    flex-direction: column;
    margin-top: var(--bt-space-sm);
  }
  .bt-care-guide__topic {
    border-bottom: 1px solid var(--bt-hairline);
  }
  .bt-care-guide__topic:first-child {
    border-top: 1px solid var(--bt-hairline);
  }
  .bt-care-guide__topic-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bt-space-sm);
    min-height: 48px;
    padding-block: var(--bt-space-2xs);
    cursor: pointer;
    list-style: none;
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text);
    user-select: none;
  }
  .bt-care-guide__topic-summary::-webkit-details-marker { display: none; }
  .bt-care-guide__topic-chevron {
    flex-shrink: 0;
    transition: transform var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-care-guide__topic[open] .bt-care-guide__topic-chevron { transform: rotate(180deg); }
  .bt-care-guide__topic-body { padding-bottom: var(--bt-space-sm); }
  .bt-care-guide__topic-body > :first-child { margin-top: 0; }

  @media (min-width: 750px) {
    .bt-care-guide__inner { grid-template-columns: 2fr 3fr; align-items: start; gap: var(--bt-space-lg); }
    /* Desktop: topics ship open (JS closes them on phones), so here we just
       strip the accordion chrome — borders, chevron, summary affordances. */
    .bt-care-guide__topics { margin-top: 0; }
    .bt-care-guide__topic { border: none; }
    .bt-care-guide__topic-body { padding-bottom: 0; }
    .bt-care-guide__topic-summary { pointer-events: none; cursor: default; min-height: 0; padding-block: 0; }
    .bt-care-guide__topic-chevron { display: none; }
  }
  /* Mobile: compress merchant section padding (inline style) for a tighter page rhythm */
  @media (max-width: 749px) {
    .bt-care-guide { padding-top: 28px !important; padding-bottom: 28px !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_care_guide.name",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.product_care_guide.settings.eyebrow.label", "default": "Care guide" },
    { "type": "text", "id": "heading", "label": "t:sections.product_care_guide.settings.heading.label", "default": "Plant care guide" },
    { "type": "richtext", "id": "body", "label": "t:sections.product_care_guide.settings.body.label", "default": "<p>Everything you need to keep this plant thriving. Read on for light, water, humidity, and troubleshooting tips.</p>" },
    { "type": "image_picker", "id": "image", "label": "t:sections.product_care_guide.settings.image.label" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "t:sections.product_care_guide.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "t:sections.product_care_guide.settings.padding_bottom.label" }
  ],
  "presets": [{ "name": "t:sections.product_care_guide.name" }]
}
{% endschema %}
