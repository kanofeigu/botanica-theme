{% comment %}
  sections/care-blog-teaser.liquid — Blog article teaser grid (flagship botanical)
  Pulls 3 articles from a blog (or manual cards via blocks).
  Tag badges, hover lift, editorial botanical style.
  ★ CRITICAL: Demo must have real articles — no empty gray boxes.
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign heading = section.settings.heading
  assign blog_handle = section.settings.blog
  assign blog_ref = blogs[blog_handle]
  assign show_manual = section.settings.use_manual | default: false
  assign manual_blocks = section.blocks | where: 'type', 'manual_card'
  assign show_excerpt = section.settings.show_excerpt | default: true
  assign show_date = section.settings.show_date | default: true
  assign show_author = section.settings.show_author | default: false
-%}
<section class="bt-section bt-care-blog color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bt-container">
    {%- if heading != blank -%}
      <div class="bt-care-blog__header">
        <h2 class="bt-care-blog__heading">{{ heading | escape }}</h2>
        {%- if blog_ref != blank and show_manual == false -%}
          <a href="{{ blog_ref.url }}" class="bt-care-blog__view-all bt-btn bt-btn--outline bt-btn--sm">
            {{ 'blogs.article.view_all' | t }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="bt-care-blog__grid bt-reveal-stagger">
      {%- if show_manual and manual_blocks.size > 0 -%}
        {%- for block in manual_blocks limit: 3 -%}
          {%- if block.settings.title != blank -%}
            <article class="bt-care-blog__card bt-card bt-card--hover" {{ block.shopify_attributes }}>
              <div class="bt-care-blog__media bt-card__media">
                {%- if block.settings.image != blank -%}
                  {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" aria-label="{{ block.settings.title }}">{%- endif -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 500, 600',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: block.settings.title
                  }}
                  {%- if block.settings.link != blank -%}</a>{%- endif -%}
                {%- endif -%}
                {%- if block.settings.tag != blank -%}
                  <span class="bt-badge bt-care-blog__tag">{{ block.settings.tag | escape }}</span>
                {%- endif -%}
              </div>
              <div class="bt-card__body">
                <h3 class="bt-care-blog__title">
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                  {%- else -%}
                    {{ block.settings.title | escape }}
                  {%- endif -%}
                </h3>
                {%- if show_excerpt and block.settings.excerpt != blank -%}
                  <p class="bt-care-blog__excerpt">{{ block.settings.excerpt | escape }}</p>
                {%- endif -%}
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif blog_ref != blank and blog_ref.articles.size > 0 -%}
        {%- for article in blog_ref.articles limit: 3 -%}
          <article class="bt-care-blog__card bt-card bt-card--hover">
            <div class="bt-care-blog__media bt-card__media">
              <a href="{{ article.url }}" aria-label="{{ article.title }}">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 500, 600',
                    sizes: '(min-width: 990px) 33vw, 100vw',
                    alt: article.title
                  }}
                {%- endif -%}
              </a>
              {%- if article.tags.size > 0 -%}
                <span class="bt-badge bt-care-blog__tag">{{ article.tags.first }}</span>
              {%- endif -%}
            </div>
            <div class="bt-card__body">
              {%- if show_date -%}
                <p class="bt-eyebrow">{{ article.published_at | date: '%B %d, %Y' }}</p>
              {%- endif -%}
              <h3 class="bt-care-blog__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>
              {%- if show_excerpt and article.excerpt_or_content.size > 0 -%}
                <p class="bt-care-blog__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              {%- endif -%}
              {%- if show_author and article.author != blank -%}
                <span class="bt-care-blog__author">{{ 'blogs.article.by_author' | t: author: article.author }}</span>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="bt-care-blog__card bt-card">
            <div class="bt-care-blog__media bt-card__media">
              {{ 'image' | placeholder_svg_tag: 'bt-card__placeholder' }}
            </div>
            <div class="bt-card__body">
              <h3 class="bt-care-blog__title">{{ 'blogs.article.title' | t }}</h3>
              <p class="bt-care-blog__excerpt">{{ 'blogs.article.excerpt' | t }}</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* Dates are content, not decoration — muted text color for readability. */
  .bt-care-blog .bt-eyebrow {
    color: var(--bt-color-text-muted);
    opacity: 1;
  }
  .bt-care-blog__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--bt-space-lg);
  }
  .bt-care-blog__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    margin: 0;
  }
  .bt-care-blog__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--bt-grid-gap);
  }
  .bt-care-blog__card {
    display: flex;
    flex-direction: column;
  }
  .bt-care-blog__media {
    aspect-ratio: 3 / 2;
    position: relative;
    overflow: hidden;
    border-radius: var(--bt-radius-card);
    background: var(--bt-color-surface);
  }
  .bt-care-blog__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--bt-duration-slow) var(--bt-ease-out);
  }
  .bt-care-blog__card:hover .bt-care-blog__media img {
    transform: scale(1.04);
  }
  .bt-care-blog__tag {
    position: absolute;
    top: var(--bt-space-2xs);
    left: var(--bt-space-2xs);
  }
  .bt-care-blog__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-normal);
    margin: 0;
  }
  .bt-care-blog__title a {
    color: inherit;
    text-decoration: none;
  }
  .bt-care-blog__title a:hover { color: var(--bt-color-primary); }
  .bt-care-blog__excerpt {
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
    margin: var(--bt-space-2xs) 0 0;
  }
  .bt-care-blog__author {
    font-size: var(--bt-fs-body-xs);
    color: var(--bt-color-text-muted);
    margin-top: var(--bt-space-2xs);
    display: block;
  }
  .bt-care-blog__card .bt-card__body { padding: var(--bt-space-sm) 0; }
  @media (max-width: 749px) {
    .bt-care-blog__grid { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.care_blog_teaser.name",
  "tag": "section",
  "blocks": [
    {
      "type": "manual_card",
      "name": "t:sections.care_blog_teaser.blocks.manual_card.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.care_blog_teaser.blocks.manual_card.settings.image.label"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "t:sections.care_blog_teaser.blocks.manual_card.settings.tag.label",
          "default": "Care guide"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.care_blog_teaser.blocks.manual_card.settings.title.label",
          "default": "How to propagate your Monstera"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "t:sections.care_blog_teaser.blocks.manual_card.settings.excerpt.label",
          "default": "Step-by-step guide to propagating your favorite plant and growing your indoor jungle."
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.care_blog_teaser.blocks.manual_card.settings.link.label"
        }
      ]
    }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.care_blog_teaser.settings.heading.label",
      "default": "The Field Journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.care_blog_teaser.settings.blog.label",
      "info": "t:sections.care_blog_teaser.settings.blog.info"
    },
    {
      "type": "checkbox",
      "id": "use_manual",
      "label": "t:sections.care_blog_teaser.settings.use_manual.label",
      "default": false,
      "info": "t:sections.care_blog_teaser.settings.use_manual.info"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.care_blog_teaser.settings.show_excerpt.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.care_blog_teaser.settings.show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "t:sections.care_blog_teaser.settings.show_author.label",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.care_blog_teaser.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.care_blog_teaser.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.care_blog_teaser.name",
    "blocks": [
      {
        "type": "manual_card",
        "settings": {
          "tag": "Photosynthesis",
          "title": "The secret life of chlorophyll: how plants turn sunlight into energy",
          "excerpt": "Photosynthesis is not just a chapter from your high school textbook — it is the engine driving every leaf in your home."
        }
      },
      {
        "type": "manual_card",
        "settings": {
          "tag": "Mycology",
          "title": "Mycorrhizal networks: the hidden fungal internet beneath your potting mix",
          "excerpt": "Your plant's roots are not working alone. Trillions of fungi form a symbiotic web that delivers water and nutrients."
        }
      },
      {
        "type": "manual_card",
        "settings": {
          "tag": "Evolution",
          "title": "The evolutionary arms race: how houseplants developed toxicity to survive",
          "excerpt": "Calcium oxalate crystals, latex sap, and alkaloids — your plants' chemical weapons arsenal explained."
        }
      }
    ]
  }]
}
{% endschema %}
