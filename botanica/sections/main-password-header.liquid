{% comment %} main-password-header.liquid — Password page header. Zero Dawn code. {% endcomment %}
<div class="bt-password-header bt-text-center" {{ section.shopify_attributes }}>
  {%- if settings.logo != blank -%}
    {{ settings.logo | image_url: width: 160 | image_tag: alt: shop.name, loading: 'eager' }}
  {%- else -%}
    <span class="bt-h2">{{ shop.name }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .bt-password-header { padding: var(--bt-space-md); }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_password_header.name", "presets": [{ "name": "t:sections.main_password_header.name" }] }
{% endschema %}
