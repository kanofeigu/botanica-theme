{% comment %}
  sections/risk-free-guarantee.liquid — PDP reassurance banner.
  Editorial shield mark + heading + body. All copy merchant-editable;
  no custom metafield. Inspired by Hey Rooted's "Risk-Free Guarantee"
  block but original markup/CSS.
{% endcomment %}
{%- if section.settings.body != blank or section.settings.heading != blank -%}
  <section class="bt-guarantee" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="bt-container bt-guarantee__inner">
      <span class="bt-guarantee__mark" aria-hidden="true">
        <svg width="56" height="56" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M24 4L8 11v9c0 11 7 19 16 24 9-5 16-13 16-24v-9L24 4Z"/>
          <path d="M16 24l6 6 10-12"/>
        </svg>
      </span>
      <div class="bt-guarantee__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="bt-guarantee__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <div class="bt-guarantee__body bt-rich-text">{{ section.settings.body }}</div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .bt-guarantee { padding-block: var(--bt-space-lg); }
  .bt-guarantee__inner {
    display: flex;
    align-items: center;
    gap: var(--bt-space-md);
    padding: var(--bt-space-lg) var(--bt-space-md);
    background: var(--bt-color-surface);
    border: 1px solid var(--bt-color-border-light);
    border-left: 4px solid var(--bt-color-secondary);
    border-radius: var(--bt-radius-card);
  }
  .bt-guarantee__mark {
    flex-shrink: 0;
    width: 72px; height: 72px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--bt-color-secondary);
    background: var(--bt-color-bg);
    border-radius: var(--bt-radius-pill);
    border: 1px solid var(--bt-color-border-light);
  }
  .bt-guarantee__content { max-width: 64ch; }
  .bt-guarantee__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h3);
    font-weight: var(--bt-fw-normal);
    margin: 0 0 var(--bt-space-3xs);
    color: var(--bt-color-text);
  }
  .bt-guarantee__body {
    font-size: var(--bt-fs-body-sm);
    line-height: var(--bt-lh-relaxed);
    color: var(--bt-color-text-muted);
  }
  .bt-guarantee__body p { margin: 0; }
  @media (max-width: 749px) {
    .bt-guarantee__inner { flex-direction: column; text-align: center; gap: var(--bt-space-sm); }
    .bt-guarantee__mark { width: 56px; height: 56px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.risk_free_guarantee.name",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.risk_free_guarantee.settings.heading.label", "default": "Risk-Free Guarantee" },
    { "type": "richtext", "id": "body", "label": "t:sections.risk_free_guarantee.settings.body.label", "default": "<p>In the (very) rare case you receive a damaged plant, our 14-day guarantee has you covered. We send replacements right away, and also share tips on how to revive any damaged foliage!</p>" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32, "label": "t:sections.risk_free_guarantee.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32, "label": "t:sections.risk_free_guarantee.settings.padding_bottom.label" }
  ],
  "presets": [{ "name": "t:sections.risk_free_guarantee.name" }]
}
{% endschema %}
