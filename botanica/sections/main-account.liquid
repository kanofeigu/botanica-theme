{% comment %} main-account.liquid — Customer account page. Original. {% endcomment %}
<div class="bt-section bt-account color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bt-container" style="max-width: 720px;">
    <h1 class="bt-h1">{{ 'customer.account.title' | t }}</h1>
    <div class="bt-rich-text">{{ 'customer.account.details' | t }} — <a href="{{ routes.account_logout_url }}" style="color: var(--bt-color-primary);">{{ 'customer.log_out' | t }}</a></div>
    <p style="margin-top: var(--bt-space-xs);"><a href="{{ routes.account_addresses_url }}" style="color: var(--bt-color-primary); font-size: var(--bt-fs-body-sm);">{{ 'customer.account.manage_addresses' | t: count: customer.addresses_count }}</a></p>
    <h2 class="bt-h3" style="margin-top: var(--bt-space-lg);">{{ 'customer.orders.title' | t }}</h2>
    {%- paginate customer.orders by 10 -%}
      {%- if customer.orders.size > 0 -%}
        <div class="bt-stack-sm">
          {%- for order in customer.orders -%}
            <div class="bt-card"><div class="bt-card__body bt-flex bt-justify-between bt-items-center">
              <div>
                <a href="{{ order.customer_url }}" class="bt-card__title">{{ order.name }}</a>
                <p class="bt-card__price">{{ order.created_at | date: '%B %d, %Y' }} &mdash; {{ order.financial_status_label }}</p>
              </div>
              <span class="bt-badge">{{ order.fulfillment_status_label }}</span>
            </div></div>
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ 'customer.orders.none' | t }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}{% render 'pagination', paginate: paginate %}{%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .bt-account .bt-h1 { margin-bottom: var(--bt-space-sm); }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_account.name", "settings": [
  { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }
], "presets": [{ "name": "t:sections.main_account.name" }] }
{% endschema %}
