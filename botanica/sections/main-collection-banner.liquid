{% comment %} main-collection-banner.liquid — Compact editorial collection band. Left-aligned eyebrow + Cormorant title + description with the product count integrated; collection image shrinks to a small ambient plate on the right (optional "full" plate style). Decorative botanical illustration stays behind the text. Zero Dawn code. {% endcomment %}
<div class="bt-collection-hero bt-collection-hero--{{ section.settings.image_style }} bt-section color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  {%- if section.settings.show_breadcrumbs -%}
    <div class="bt-container bt-collection-hero__breadcrumbs">
      {% render 'breadcrumbs' %}
    </div>
  {%- endif -%}
  <div class="bt-container bt-collection-hero__inner">

    <div class="bt-collection-hero__body">
      <p class="bt-eyebrow bt-collection-hero__eyebrow">{{ 'sections.collection_template.title' | t }}</p>
      <h1 class="bt-collection-hero__title">{{ collection.title }}</h1>
      <p class="bt-collection-hero__meta">
        <span class="bt-collection-hero__count">{{ 'collections.collection.product_count' | t: count: collection.all_products_count }}</span>
      </p>
      {%- if section.settings.show_collection_description and collection.description != blank -%}
        <div class="bt-collection-hero__desc bt-rich-text">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="bt-collection-hero__media">
        {{ collection.image | image_url: width: 800 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '240,400,600,800', sizes: '(min-width: 990px) 300px, 40vw', alt: collection.title, class: 'bt-collection-hero__image' }}
        <span class="bt-collection-hero__media-tag">
          <svg width="8" height="8" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="6" fill="var(--bt-color-secondary)"/></svg>
          {{ 'sections.main_collection_banner.specimens' | t: count: collection.all_products_count }}
        </span>
      </div>
    {%- endif -%}

    {% comment %} Decorative botanical SVG — subtle specimen illustration behind the text {% endcomment %}
    <div class="bt-collection-hero__decoration" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400" fill="none" opacity="0.06">
        <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
          <path d="M150 380 Q145 340 160 300 Q180 260 155 220 Q130 180 150 140 Q170 100 145 60 Q125 25 140 10" stroke="currentColor" stroke-width="2"/>
          <path d="M155 220 Q120 200 90 210 Q60 218 50 230" stroke="currentColor" stroke-width="1.5"/>
          <path d="M155 220 Q190 195 220 200" stroke="currentColor" stroke-width="1.5"/>
          <path d="M150 140 Q120 125 90 135" stroke="currentColor" stroke-width="1.2"/>
          <path d="M150 140 Q180 120 210 130" stroke="currentColor" stroke-width="1.2"/>
        </g>
        <g opacity="0.5">
          <ellipse cx="90" cy="210" rx="35" ry="16" fill="currentColor" transform="rotate(-15 90 210)"/>
          <ellipse cx="220" cy="200" rx="32" ry="14" fill="currentColor" transform="rotate(10 220 200)"/>
          <ellipse cx="50" cy="230" rx="28" ry="12" fill="currentColor" transform="rotate(-20 50 230)"/>
          <ellipse cx="90" cy="135" rx="24" ry="10" fill="currentColor" transform="rotate(-10 90 135)"/>
          <ellipse cx="210" cy="130" rx="26" ry="11" fill="currentColor" transform="rotate(15 210 130)"/>
        </g>
      </svg>
    </div>
  </div>
</div>

{% stylesheet %}
  .bt-collection-hero {
    position: relative;
    overflow: hidden;
    padding-top: var(--bt-space-md);
    padding-bottom: var(--bt-space-sm);
  }

  /* ── Compact editorial band: text left, small ambient plate right ── */
  .bt-collection-hero__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bt-space-xl);
  }

  /* ── Body ── */
  .bt-collection-hero__body {
    position: relative;
    z-index: 1;
    max-width: 640px;
    min-width: 0;
  }
  .bt-collection-hero__eyebrow {
    margin-bottom: var(--bt-space-2xs);
  }
  .bt-collection-hero__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h1);
    font-weight: var(--bt-fw-normal);
    line-height: 1.08;
    color: var(--bt-color-text);
    margin: 0;
    font-variant-numeric: oldstyle-nums;
  }
  /* Count integrated as a soft tint pill directly under the title */
  .bt-collection-hero__meta {
    margin: var(--bt-space-xs) 0 0;
  }
  .bt-collection-hero__count {
    display: inline-flex;
    align-items: center;
    padding: 2px 12px;
    background: var(--bt-color-primary-tint);
    color: var(--bt-color-primary);
    border-radius: var(--bt-radius-pill);
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* Plain editorial description — no field-note border bar */
  .bt-collection-hero__desc {
    margin-top: var(--bt-space-sm);
    font-size: var(--bt-fs-body);
    line-height: var(--bt-lh-relaxed);
    color: var(--bt-color-text-muted);
  }
  .bt-collection-hero__desc p { margin: 0; }

  /* ── Ambient plate: small rounded image, shadow-layered like cards ── */
  .bt-collection-hero__media {
    position: relative;
    flex-shrink: 0;
    width: clamp(180px, 22vw, 280px);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--bt-radius-card);
    box-shadow: var(--bt-shadow-md);
  }
  .bt-collection-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Count tag: borderless glass chip (overrides effects.css specimen label) */
  .bt-collection-hero__media-tag {
    position: absolute;
    left: var(--bt-space-xs);
    bottom: var(--bt-space-xs);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 10px;
    background: rgba(var(--bt-color-bg-rgb), 0.85);
    backdrop-filter: blur(3px);
    border-radius: var(--bt-radius-tag);
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--bt-color-text);
  }

  /* ── Full plate variant (merchant switch): wider 4/3 image ── */
  .bt-collection-hero--full .bt-collection-hero__media {
    width: clamp(280px, 34vw, 440px);
    aspect-ratio: 4 / 3;
  }

  /* ── Background decoration ── */
  .bt-collection-hero__decoration {
    position: absolute;
    top: 50%;
    right: -60px;
    transform: translateY(-50%);
    width: 260px;
    height: 340px;
    pointer-events: none;
    z-index: 0;
    color: var(--bt-color-primary);
  }

  @media (max-width: 989px) {
    .bt-collection-hero__title {
      font-size: var(--bt-fs-h2);
    }
    .bt-collection-hero__media {
      width: clamp(140px, 24vw, 200px);
    }
    .bt-collection-hero__decoration {
      right: -100px;
      width: 200px;
      height: 280px;
    }
  }

  /* ── Mobile: pure text band, image hidden ── */
  @media (max-width: 749px) {
    .bt-collection-hero {
      padding-top: var(--bt-space-sm);
    }
    .bt-collection-hero__inner {
      display: block;
    }
    .bt-collection-hero__media {
      display: none;
    }
    .bt-collection-hero__decoration {
      right: -80px;
      width: 140px;
      height: 200px;
      opacity: 0.04;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_collection_banner.name",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "t:sections.main_collection_banner.settings.show_image.label",
      "default": true
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "t:sections.main_collection_banner.settings.image_style.label",
      "options": [
        { "value": "compact", "label": "t:sections.main_collection_banner.settings.image_style.options.compact" },
        { "value": "full", "label": "t:sections.main_collection_banner.settings.image_style.options.full" }
      ],
      "default": "compact"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "t:sections.main_collection_banner.settings.show_description.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "t:sections.main_collection_banner.settings.show_breadcrumbs.label",
      "default": true
    }
  ],
  "presets": [{ "name": "t:sections.main_collection_banner.name" }]
}
{% endschema %}
