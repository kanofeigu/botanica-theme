{% comment %}
  sections/multicolumn.liquid — Multi-column section
  Configurable 2-4 column grid. Each column = one block.
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign heading = section.settings.heading
  assign columns = section.settings.columns_desktop | default: 3
-%}
<section class="bt-section bt-multicolumn color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bt-container">
    {%- if heading != blank -%}
      <h2 class="bt-multicolumn__heading">{{ heading | escape }}</h2>
    {%- endif -%}
    <div class="bt-multicolumn__grid bt-multicolumn__grid--{{ columns }}-col">
      {%- for block in section.blocks -%}
        <div class="bt-multicolumn__item" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="bt-multicolumn__media">
              {{ block.settings.image | image_url: width: 400 | image_tag:
                loading: 'lazy',
                widths: '200, 300, 400',
                sizes: '(min-width: 990px) 33vw, 50vw',
                alt: block.settings.image.alt | default: block.settings.title
              }}
            </div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="bt-multicolumn__title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="bt-multicolumn__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank -%}
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="bt-btn bt-btn--outline bt-btn--sm">
                {{ block.settings.link_label | escape }}
              </a>
            {%- else -%}
              <p class="bt-multicolumn__text">{{ block.settings.link_label | escape }}</p>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .bt-multicolumn__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    text-align: center;
    margin: 0 0 var(--bt-space-lg);
  }
  .bt-multicolumn__grid {
    display: grid;
    gap: var(--bt-grid-gap);
  }
  .bt-multicolumn__grid--2-col { grid-template-columns: repeat(2, 1fr); }
  .bt-multicolumn__grid--3-col { grid-template-columns: repeat(3, 1fr); }
  .bt-multicolumn__grid--4-col { grid-template-columns: repeat(4, 1fr); }
  .bt-multicolumn__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--bt-space-sm);
  }
  .bt-multicolumn__media {
    border-radius: var(--bt-radius-card);
    overflow: hidden;
    aspect-ratio: 1;
    background: var(--bt-color-surface);
    width: 100%;
  }
  .bt-multicolumn__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-multicolumn__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    margin: 0;
  }
  .bt-multicolumn__text {
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
    margin: 0;
    max-width: 35ch;
  }
  @media (max-width: 749px) {
    .bt-multicolumn__grid--3-col, .bt-multicolumn__grid--4-col {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 479px) {
    .bt-multicolumn__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.multicolumn.name",
  "tag": "section",
  "blocks": [
    {
      "type": "column",
      "name": "t:sections.multicolumn.blocks.column.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.multicolumn.blocks.column.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.multicolumn.blocks.column.settings.title.label",
          "default": "Column heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.multicolumn.blocks.column.settings.text.label",
          "default": "Short description for this column."
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.multicolumn.blocks.column.settings.link_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.multicolumn.blocks.column.settings.link.label"
        }
      ]
    }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.multicolumn.settings.heading.label",
      "default": "Why choose Botanica"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.multicolumn.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.multicolumn.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.multicolumn.settings.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.multicolumn.settings.columns_desktop.options__3.label" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.multicolumn.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.multicolumn.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.multicolumn.name",
    "blocks": [
      {
        "type": "column",
        "settings": { "title": "Hand-selected", "text": "Every plant is inspected by our team before shipping to ensure it arrives healthy and thriving." }
      },
      {
        "type": "column",
        "settings": { "title": "Care guarantee", "text": "Each order includes a detailed care guide specific to your plant — we're here to help you succeed." }
      },
      {
        "type": "column",
        "settings": { "title": "Eco packaging", "text": "100% recyclable, plastic-free packaging. Carbon-neutral shipping on every order." }
      }
    ]
  }]
}
{% endschema %}
