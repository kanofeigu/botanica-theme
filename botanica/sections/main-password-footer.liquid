{% comment %} main-password-footer.liquid — Password page footer. Zero Dawn code. {% endcomment %}
<div class="bt-password-footer bt-text-center" {{ section.shopify_attributes }}>
  <p>{{ 'general.password_page.admin_link_html' | t }}</p>
  <p style="margin-top: var(--bt-space-sm); font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted);">{{ powered_by_link }}</p>
</div>

{% stylesheet %}
  .bt-password-footer { padding: var(--bt-space-lg) var(--bt-space-md); font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); }
  .bt-password-footer a { color: var(--bt-color-primary); }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_password_footer.name", "presets": [{ "name": "t:sections.main_password_footer.name" }] }
{% endschema %}
