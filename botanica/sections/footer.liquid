{% comment %} footer.liquid — Botanica v3 original footer with brand, links, newsletter blocks. {% endcomment %}
<footer class="bt-footer color-{{ section.settings.color_scheme }}" role="contentinfo">
  <div class="bt-footer__inner bt-container">
    <div class="bt-footer__grid bt-grid bt-grid--{{ section.settings.column_count }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'brand' -%}
            <div class="bt-footer__brand" {{ block.shopify_attributes }}>
              {%- if settings.logo != blank -%}
                {{ settings.logo | image_url: width: 120 | image_tag: alt: shop.name, loading: 'lazy' }}
              {%- endif -%}
              {%- if block.settings.tagline != blank -%}
                <p class="bt-footer__tagline">{{ block.settings.tagline }}</p>
              {%- endif -%}
            </div>
          {%- when 'links' -%}
            <div class="bt-footer__col" {{ block.shopify_attributes }}>
              <h3 class="bt-footer__col-title">{{ block.settings.title }}</h3>
              <ul class="bt-footer__links">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="bt-footer__link">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div class="bt-footer__col" {{ block.shopify_attributes }}>
              <h3 class="bt-footer__col-title">{{ block.settings.title }}</h3>
              {%- if block.settings.text != blank -%}
                <p class="bt-footer__text">{{ block.settings.text }}</p>
              {%- endif -%}
              {%- form 'customer', class: 'bt-footer__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="bt-footer__form-row">
                  <input type="email" name="contact[email]" class="bt-input bt-footer__input" value="{{ form.email }}" placeholder="{{ block.settings.placeholder }}" aria-label="{{ block.settings.placeholder }}" required autocomplete="email">
                  <button type="submit" class="bt-btn bt-btn--primary bt-footer__submit" name="commit">{{ block.settings.button_label }}</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="bt-form-success" role="alert">{{ 'general.newsletter_form.confirmation' | t }}</p>
                {%- endif -%}
              {%- endform -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    {% comment %} Country/region + language selectors. Hidden gracefully when the store
         has a single market (available_countries.size <= 1) or a single language. {% endcomment %}
    {%- liquid
      assign show_country_selector = false
      assign show_language_selector = false
      if section.settings.enable_country_selector and localization.available_countries.size > 1
        assign show_country_selector = true
      endif
      if section.settings.enable_language_selector and localization.available_languages.size > 1
        assign show_language_selector = true
      endif
    -%}
    {%- if show_country_selector or show_language_selector -%}
      <div class="bt-footer__localization">
        {%- form 'localization', id: 'FooterLocalizationForm', class: 'bt-localization' -%}
          {%- if show_country_selector -%}
            <div class="bt-localization__field">
              <label class="bt-label" for="FooterCountrySelector">{{ 'localization.country_label' | t }}</label>
              <select id="FooterCountrySelector" class="bt-select" name="country_code" data-localization-select>
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                    {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          {%- if show_language_selector -%}
            <div class="bt-localization__field">
              <label class="bt-label" for="FooterLanguageSelector">{{ 'localization.language_label' | t }}</label>
              <select id="FooterLanguageSelector" class="bt-select" name="locale_code" data-localization-select>
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                    {{- language.endonym_name | capitalize -}}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- endif -%}
          <noscript>
            <button type="submit" class="bt-btn bt-btn--outline bt-btn--sm">{{ 'localization.update' | t }}</button>
          </noscript>
        {%- endform -%}
      </div>
      <script>
        (function () {
          document.querySelectorAll('[data-localization-select]').forEach(function (select) {
            select.addEventListener('change', function () {
              if (select.form) select.form.submit();
            });
          });
        })();
      </script>
    {%- endif -%}

    <div class="bt-footer__bottom">
      {%- if section.settings.enable_follow_on_shop -%}
        <div class="bt-footer__shop-follow">
          {{ shop | login_button }}
        </div>
      {%- endif -%}
      <div class="bt-footer__social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="bt-footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.instagram' | t }}">{% render 'icon-instagram' %}</a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" class="bt-footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.facebook' | t }}">{% render 'icon-facebook' %}</a>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <a href="{{ settings.social_pinterest_link }}" class="bt-footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.pinterest' | t }}">{% render 'icon-pinterest' %}</a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" class="bt-footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.tiktok' | t }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 15c-2 0-3.5-1.5-3.5-3.5S7 8 9 8c1.5 0 3 1 3.5 2.5v-1c0-3 2-5 5-5v4c-1.5 0-3 .5-4 1.5v6c0 3-2.5 5.5-5.5 5.5S2.5 19 2.5 16s2.5-5.5 5.5-5.5c.5 0 1 .2 1.5.4" stroke="currentColor" stroke-width="1.5"/></svg></a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" class="bt-footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.twitter' | t }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4l7 8-7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M20 4l-7 8 7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></a>
        {%- endif -%}
        {%- if settings.social_youtube_link != blank -%}
          <a href="{{ settings.social_youtube_link }}" class="bt-footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'general.social.links.youtube' | t }}"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22.5 7.5a2.5 2.5 0 00-2.5-2.5H4A2.5 2.5 0 001.5 7.5v9A2.5 2.5 0 004 19h16a2.5 2.5 0 002.5-2.5v-9z" stroke="currentColor" stroke-width="1.5"/><path d="M10 9l5 3-5 3V9z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        {%- endif -%}
      </div>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <div class="bt-footer__payment">
          <span class="bt-sr-only">{{ 'sections.footer.payment' | t }}</span>
          <ul class="bt-footer__payment-list" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="bt-footer__payment-item">{{ type | payment_type_svg_tag }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      <div class="bt-footer__copyright">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ powered_by_link }}</p>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .bt-footer { background: var(--bt-color-surface); border-top: 1px solid var(--bt-color-border-light); padding-block: var(--bt-space-xl) var(--bt-space-lg); }
  .bt-footer__grid { margin-bottom: var(--bt-space-xl); }
  .bt-footer__col-title { font-size: var(--bt-fs-body-sm); font-weight: var(--bt-fw-semibold); margin-bottom: var(--bt-space-sm); color: var(--bt-color-text); }
  .bt-footer__links { list-style: none; display: flex; flex-direction: column; gap: var(--bt-space-2xs); }
  .bt-footer__link { font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); text-decoration: none; transition: color var(--bt-duration-fast); }
  .bt-footer__link:hover { color: var(--bt-color-primary); }
  .bt-footer__tagline, .bt-footer__text { font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); max-width: 30ch; }
  .bt-footer__form-row { display: flex; gap: var(--bt-space-2xs); }
  .bt-footer__input { min-width: 0; }
  .bt-footer__submit { flex-shrink: 0; }
  .bt-footer__localization { margin-bottom: var(--bt-space-lg); }
  .bt-localization { display: flex; flex-wrap: wrap; gap: var(--bt-space-sm); }
  .bt-localization__field { flex: 0 1 260px; min-width: 200px; }
  .bt-footer__shop-follow { display: flex; align-items: center; }
  .bt-footer__bottom { display: flex; flex-direction: column; align-items: center; gap: var(--bt-space-sm); padding-top: var(--bt-space-md); border-top: 1px solid var(--bt-color-border-light); }
  .bt-footer__social { display: flex; gap: var(--bt-space-xs); }
  .bt-footer__social-link { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; color: var(--bt-color-text-muted); border-radius: var(--bt-radius-sm); transition: color var(--bt-duration-fast), background var(--bt-duration-fast); }
  .bt-footer__social-link:hover { color: var(--bt-color-primary); background: var(--bt-color-primary-tint); }
  .bt-footer__payment-list { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: var(--bt-space-2xs); margin: 0; padding: 0; }
  .bt-footer__payment-item { display: flex; align-items: center; padding: 2px 4px; background: var(--bt-color-bg); border: 1px solid var(--bt-color-border-light); border-radius: var(--bt-radius-sm); }
  .bt-footer__payment-item svg { height: 20px; width: auto; display: block; }
  .bt-footer__copyright { font-size: var(--bt-fs-body-xs); color: var(--bt-color-text-muted); text-align: center; }
  .bt-footer__copyright a { color: var(--bt-color-text-muted); }
  @media (min-width: 750px) { .bt-footer__bottom { flex-direction: row; justify-content: space-between; } }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.footer.name", "class": "section-footer", "settings": [
  { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
  { "type": "select", "id": "column_count", "label": "t:sections.footer.settings.columns.label", "options": [{"value":"2","label":"2"},{"value":"3","label":"3"},{"value":"4","label":"4"}], "default": "3" },
  { "type": "checkbox", "id": "enable_country_selector", "label": "t:sections.footer.settings.enable_country_selector.label", "info": "t:sections.footer.settings.enable_country_selector.info", "default": true },
  { "type": "checkbox", "id": "enable_language_selector", "label": "t:sections.footer.settings.enable_language_selector.label", "info": "t:sections.footer.settings.enable_language_selector.info", "default": true },
  { "type": "checkbox", "id": "enable_follow_on_shop", "label": "t:sections.footer.settings.enable_follow_on_shop.label", "info": "t:sections.footer.settings.enable_follow_on_shop.info", "default": false }
], "blocks": [
  { "type": "brand", "name": "t:sections.footer.blocks.brand.name", "settings": [
    { "type": "text", "id": "tagline", "label": "t:sections.footer.blocks.brand.settings.tagline.label", "default": "Plants for real interiors" }
  ]},
  { "type": "links", "name": "t:sections.footer.blocks.links.name", "settings": [
    { "type": "text", "id": "title", "label": "t:sections.footer.blocks.links.settings.title.label", "default": "Quick links" },
    { "type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.links.settings.menu.label" }
  ]},
  { "type": "newsletter", "name": "t:sections.footer.blocks.newsletter.name", "settings": [
    { "type": "text", "id": "title", "label": "t:sections.footer.blocks.newsletter.settings.title.label", "default": "Care guide" },
    { "type": "text", "id": "text", "label": "t:sections.footer.blocks.newsletter.settings.text.label", "default": "Weekly plant care, delivered free." },
    { "type": "text", "id": "placeholder", "label": "t:sections.footer.blocks.newsletter.settings.placeholder.label", "default": "your@email.com" },
    { "type": "text", "id": "button_label", "label": "t:sections.footer.blocks.newsletter.settings.button_label.label", "default": "Subscribe" }
  ]}
], "presets": [{"name":"t:sections.footer.name","blocks":[{"type":"brand","settings":{"tagline":"Plants for real interiors"}},{"type":"links","settings":{"title":"Shop","menu":"main-menu"}},{"type":"newsletter","settings":{"title":"Care guide","text":"Weekly plant care, delivered free.","placeholder":"your@email.com","button_label":"Subscribe"}}]}] }
{% endschema %}
