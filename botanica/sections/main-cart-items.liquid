{% comment %}
  main-cart-items.liquid — Full cart page: line-item cards, sticky order
  summary (free-shipping progress, order note, checkout), "You may also like"
  recommendations and an illustrated empty state. All interactions are AJAX
  (/cart/change.js, /cart/update.js) with graceful reload fallbacks.
  Theme blocks + @app support. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign threshold = section.settings.free_shipping_threshold | times: 100
  assign show_shipping_bar = false
  if section.settings.show_free_shipping_bar and settings.show_free_shipping_bar
    assign show_shipping_bar = true
  endif
  assign shipping_remaining_tmpl = 'sections.cart.free_shipping_remaining_html' | t: amount: '{amount}'
-%}
<div class="bt-cart bt-section color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bt-container">
    <h1 class="bt-h1 bt-cart__heading">{{ 'sections.cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <div
        class="bt-cart__layout"
        data-bt-cart-page
        {% if show_shipping_bar %}data-shipping-threshold="{{ threshold }}"{% endif %}
        data-shipping-remaining="{{ shipping_remaining_tmpl | escape }}"
        data-shipping-reached="{{ 'sections.cart.free_shipping_reached' | t | escape }}"
        data-subtotal-label="{{ 'sections.cart.subtotal' | t | escape }}"
        data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
      >
        {%- comment %} ── Left column: line items ── {%- endcomment %}
        <div class="bt-cart__main">
          <ul class="bt-cart__items" role="list" data-cart-items>
            {%- for item in cart.items -%}
              {%- assign unit_price = item.final_price | money -%}
              <li
                class="bt-cart__item{% unless item.variant.available %} bt-cart__item--soldout{% endunless %}"
                role="listitem"
                data-cart-item
                data-key="{{ item.key }}"
              >
                <a href="{{ item.url }}" class="bt-cart__item-media" tabindex="-1" aria-hidden="true">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120,240', sizes: '(max-width: 749px) 88px, 120px', alt: item.title }}
                  {%- endif -%}
                </a>

                <div class="bt-cart__item-info">
                  <a href="{{ item.url }}" class="bt-cart__item-title">{{ item.product.title }}</a>
                  {%- if item.variant.title != 'Default Title' -%}
                    <p class="bt-cart__item-variant">{{ item.variant.title }}</p>
                  {%- endif -%}

                  {%- if item.selling_plan_allocation != null -%}
                    <p class="bt-cart__item-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                  {%- endif -%}

                  {%- comment %} Line-item discounts — mirrored client-side by the
                    cart AJAX handler (data-line-discounts). {%- endcomment %}
                  <ul class="bt-cart__item-discounts" role="list" data-line-discounts{% if item.line_level_discount_allocations.size == 0 %} hidden{% endif %}>
                    {%- for allocation in item.line_level_discount_allocations -%}
                      <li class="bt-cart__item-discount">
                        <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1h4l6 6-4 4-6-6V1Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="3.5" cy="3.5" r="1" fill="currentColor"/></svg>
                        {{ allocation.discount_application.title | escape_once }}
                        <span class="bt-cart__item-discount-amount">−{{ allocation.amount | money }}</span>
                      </li>
                    {%- endfor -%}
                  </ul>

                  {%- if item.product.tags contains 'care-easy' or item.product.tags contains 'care-medium' or item.product.tags contains 'care-expert' -%}
                    <div class="bt-cart__item-chips">
                      {%- if item.product.tags contains 'care-easy' -%}
                        <span class="bt-chip bt-chip--easy">{% render 'icon-leaf' %}Easy</span>
                      {%- elsif item.product.tags contains 'care-medium' -%}
                        <span class="bt-chip bt-chip--medium">{% render 'icon-leaf' %}Moderate</span>
                      {%- elsif item.product.tags contains 'care-expert' -%}
                        <span class="bt-chip bt-chip--expert">{% render 'icon-leaf' %}Expert</span>
                      {%- endif -%}
                    </div>
                  {%- endif -%}

                  <p class="bt-cart__item-unit">
                    {%- if item.variant.compare_at_price > item.final_price -%}
                      <s>{{ item.variant.compare_at_price | money }}</s>
                    {%- endif -%}
                    {{ 'sections.cart.each_price' | t: price: unit_price }}
                  </p>

                  {%- unless item.variant.available -%}
                    <p class="bt-cart__item-soldout" role="alert">{{ 'sections.cart.sold_out' | t }}</p>
                  {%- endunless -%}

                  {%- if item.variant.available -%}
                    <div class="bt-cart__item-stepper">
                      {% render 'qty-stepper', item_key: item.key, quantity: item.quantity, product_title: item.product.title %}
                    </div>
                  {%- endif -%}
                </div>

                <div class="bt-cart__item-total">
                  <span class="bt-cart__line-price" data-line-price>{{ item.final_line_price | money }}</span>
                  <button
                    type="button"
                    class="bt-cart__item-remove"
                    data-action="remove"
                    data-key="{{ item.key }}"
                    aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                  >
                    {% render 'icon-trash' %}
                  </button>
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- comment %} ── Right column: sticky order summary ── {%- endcomment %}
        <aside class="bt-cart__summary">
          {% content_for "blocks" %}

          <div class="bt-cart__summary-card">
            {%- if show_shipping_bar -%}
              {%- assign remaining = threshold | minus: cart.total_price -%}
              <div class="bt-cart__shipping" data-cart-shipping>
                {%- if remaining > 0 -%}
                  {%- assign remaining_formatted = remaining | money -%}
                  <p class="bt-cart__shipping-msg" data-shipping-msg role="status">
                    {{- 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_formatted -}}
                  </p>
                {%- else -%}
                  <p class="bt-cart__shipping-msg bt-cart__shipping-msg--reached" data-shipping-msg role="status">
                    {{- 'sections.cart.free_shipping_reached' | t -}}
                  </p>
                {%- endif -%}
                <div class="bt-cart__shipping-track" aria-hidden="true">
                  <div
                    class="bt-cart__shipping-fill"
                    data-shipping-fill
                    style="width: {{ cart.total_price | times: 100 | divided_by: threshold | at_most: 100 }}%"
                  ></div>
                </div>
              </div>
            {%- endif -%}

            {%- comment %} Cart-level discounts — listed above the subtotal;
              subtotal stays cart.total_price (already discount-adjusted). {%- endcomment %}
            <ul class="bt-cart__discounts" role="list" data-cart-discounts{% if cart.cart_level_discount_applications.size == 0 %} hidden{% endif %}>
              {%- for discount in cart.cart_level_discount_applications -%}
                <li class="bt-cart__discount">
                  <span class="bt-cart__discount-label">
                    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1h4l6 6-4 4-6-6V1Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="3.5" cy="3.5" r="1" fill="currentColor"/></svg>
                    {{ discount.title | escape_once }}
                  </span>
                  <span class="bt-cart__discount-amount">−{{ discount.total_allocated_amount | money }}</span>
                </li>
              {%- endfor -%}
            </ul>

            <p class="bt-cart__subtotal">
              <span>{{ 'sections.cart.subtotal' | t }}</span>
              <strong data-cart-subtotal>{{ cart.total_price | money }}</strong>
            </p>

            {%- if section.settings.show_order_note -%}
              <div class="bt-cart__note">
                <label class="bt-cart__note-label" for="cart-note-{{ section.id }}">{{ 'sections.cart.note_label' | t }}</label>
                <textarea
                  id="cart-note-{{ section.id }}"
                  class="bt-textarea bt-cart__note-input"
                  rows="3"
                  placeholder="{{ 'sections.cart.note_placeholder' | t }}"
                  data-cart-note
                >{{ cart.note }}</textarea>
                <div class="bt-cart__note-actions">
                  <button type="button" class="bt-btn bt-btn--outline bt-cart__note-save" data-note-save>{{ 'sections.cart.note_save' | t }}</button>
                  <span class="bt-cart__note-status" role="status" data-note-status hidden>{{ 'sections.cart.note_saved' | t }}</span>
                </div>
              </div>
            {%- endif -%}

            <form action="{{ routes.cart_url }}" method="post" novalidate class="bt-cart__checkout-form">
              <button type="submit" name="checkout" class="bt-btn bt-btn--primary bt-btn--lg bt-btn--block">
                {{ 'sections.cart.checkout' | t }}
              </button>
              {%- comment %} Accelerated checkout buttons (Shop Pay, PayPal, Apple Pay…)
                — rendered by Shopify, brand colors untouched. {%- endcomment %}
              <div class="bt-cart__additional-checkout">
                {{ content_for_additional_checkout_buttons }}
              </div>
            </form>

            <p class="bt-cart__taxes">{{ 'sections.cart.taxes_note' | t }}</p>
            <p class="bt-cart__continue">
              <a href="{{ routes.all_products_collection_url }}">{{ 'general.continue_shopping' | t }}</a>
            </p>
          </div>
        </aside>
      </div>

      {%- if section.settings.show_recommendations -%}
        {%- assign recs_heading = section.settings.recommendations_heading -%}
        {%- if recs_heading == blank -%}
          {%- assign recs_heading = 'sections.cart.you_may_also_like' | t -%}
        {%- endif -%}
        <div
          class="bt-cart-recs"
          data-cart-recs
          data-product-id="{{ cart.items.first.product_id }}"
          hidden
        >
          <h2 class="bt-cart-recs__heading">{{ recs_heading | escape }}</h2>
          <div class="bt-cart-recs__grid" data-cart-recs-grid></div>
        </div>
      {%- endif -%}

      <p class="bt-sr-only" role="status" aria-live="polite" data-cart-live></p>
    {%- else -%}
      <div class="bt-cart__empty bt-text-center">
        <svg class="bt-cart__empty-icon" width="120" height="140" viewBox="0 0 120 140" fill="none" aria-hidden="true">
          <g stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M60 92 V52" />
            <path d="M60 62 C60 44 50 32 32 28 C35 48 45 58 60 62 Z" />
            <path d="M60 52 C60 36 70 24 88 20 C85 40 75 50 60 52 Z" />
            <path d="M60 74 C52 66 40 64 30 68 C38 78 50 80 60 74 Z" opacity="0.55" />
            <path d="M42 92 H78 L73 124 A8 8 0 0 1 65 130 H55 A8 8 0 0 1 47 124 Z" />
            <path d="M38 92 H82" />
          </g>
        </svg>
        <p class="bt-cart__empty-msg">{{ 'sections.cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="bt-btn bt-btn--primary bt-btn--lg">
          {{ 'general.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .bt-cart__heading { margin-bottom: var(--bt-space-lg); }

  /* ── Two-column layout ── */
  .bt-cart__layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(300px, 1fr);
    gap: var(--bt-space-xl);
    align-items: start;
  }

  /* ── Line items ── */
  .bt-cart__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-md);
  }
  .bt-cart__item {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    gap: var(--bt-space-md);
    align-items: start;
    padding: var(--bt-space-md);
    background: var(--bt-color-surface);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-card);
    transition: opacity var(--bt-duration-base) var(--bt-ease-out),
                transform var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-cart__item.is-removing { opacity: 0; transform: translateX(12px); }
  .bt-cart__item.is-loading { opacity: 0.6; }
  .bt-cart__item--soldout .bt-cart__item-media img { filter: grayscale(1); opacity: 0.6; }

  .bt-cart__item-media {
    display: block;
    width: 120px;
    aspect-ratio: 1;
    border-radius: var(--bt-radius-md);
    overflow: hidden;
    background: var(--bt-color-surface-hover);
  }
  .bt-cart__item-media img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .bt-cart__item-info { min-width: 0; }
  .bt-cart__item-title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-normal);
    line-height: var(--bt-lh-heading);
    text-decoration: none;
    color: var(--bt-color-text);
  }
  .bt-cart__item-title:hover { color: var(--bt-color-primary); text-decoration: underline; text-underline-offset: 0.12em; }
  .bt-cart__item-variant { margin: var(--bt-space-3xs) 0 0; font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); }
  .bt-cart__item-plan { margin: var(--bt-space-3xs) 0 0; font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); }

  .bt-cart__item-discounts {
    list-style: none;
    margin: var(--bt-space-2xs) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bt-cart__item-discount {
    display: inline-flex;
    align-items: center;
    gap: var(--bt-space-3xs);
    font-size: var(--bt-fs-body-xs);
    color: var(--bt-color-text-muted);
  }
  .bt-cart__item-discount svg { flex-shrink: 0; color: var(--bt-color-primary); }
  .bt-cart__item-discount-amount { font-variant-numeric: oldstyle-nums; }

  .bt-cart__discounts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-2xs);
  }
  .bt-cart__discount {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--bt-space-sm);
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
  }
  .bt-cart__discount-label { display: inline-flex; align-items: center; gap: var(--bt-space-3xs); }
  .bt-cart__discount-label svg { flex-shrink: 0; color: var(--bt-color-primary); }
  .bt-cart__discount-amount { font-variant-numeric: oldstyle-nums; }

  .bt-cart__additional-checkout { margin-top: var(--bt-space-2xs); }

  .bt-cart__item-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--bt-space-2xs); }
  /* Care chips — mirrors snippets/card-product.liquid (its stylesheet only
     loads where that snippet renders, so cart ships its own copy). */
  .bt-cart .bt-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    font-family: var(--bt-font-body);
    font-size: 0.625rem;
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.5;
    border-radius: var(--bt-radius-pill);
    background: var(--bt-color-surface-hover);
    color: var(--bt-color-text-muted);
    border: 1px solid var(--bt-color-border-light);
    white-space: nowrap;
  }
  .bt-cart .bt-chip svg { width: 10px; height: 10px; flex-shrink: 0; }
  .bt-cart .bt-chip--easy {
    color: var(--bt-color-primary);
    background: var(--bt-color-primary-tint);
    border-color: rgba(var(--bt-color-primary-rgb), 0.2);
  }
  .bt-cart .bt-chip--medium {
    color: var(--bt-color-secondary);
    background: var(--bt-color-secondary-tint);
    border-color: rgba(var(--bt-color-secondary-rgb), 0.2);
  }
  .bt-cart .bt-chip--expert {
    color: var(--bt-color-text);
    background: var(--bt-color-surface-hover);
    border-color: rgba(var(--bt-color-text-rgb), 0.2);
  }

  .bt-cart__item-unit { margin: var(--bt-space-2xs) 0 0; font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); }
  .bt-cart__item-unit s { opacity: 0.6; margin-right: var(--bt-space-3xs); }
  .bt-cart__item-soldout {
    margin: var(--bt-space-2xs) 0 0;
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-secondary);
  }
  .bt-cart__item-stepper { margin-top: var(--bt-space-sm); }

  .bt-cart__item-total {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--bt-space-sm);
  }
  .bt-cart__line-price { font-weight: var(--bt-fw-semibold); font-size: var(--bt-fs-body); }
  .bt-cart__item-remove {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--bt-radius-sm);
    color: var(--bt-color-text-muted);
    cursor: pointer;
    transition: color var(--bt-duration-fast) var(--bt-ease-out),
                background var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-cart__item-remove:hover { color: var(--bt-color-secondary); background: var(--bt-color-secondary-tint); }
  .bt-cart__item-remove:disabled { opacity: 0.4; cursor: default; }

  /* ── Summary card ── */
  .bt-cart__summary { position: sticky; top: var(--bt-space-2xl); }
  .bt-cart__summary-card {
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-md);
    padding: var(--bt-space-md);
    background: var(--bt-color-surface);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-card);
  }

  .bt-cart__shipping { display: flex; flex-direction: column; gap: var(--bt-space-2xs); }
  .bt-cart__shipping-msg { margin: 0; font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); }
  .bt-cart__shipping-msg--reached { color: var(--bt-color-primary); font-weight: var(--bt-fw-semibold); }
  .bt-cart__shipping-track {
    width: 100%;
    height: 6px;
    background: var(--bt-color-border-light);
    border-radius: var(--bt-radius-pill);
    overflow: hidden;
  }
  .bt-cart__shipping-fill {
    height: 100%;
    background: var(--bt-color-primary);
    border-radius: var(--bt-radius-pill);
    transition: width var(--bt-duration-base) var(--bt-ease-out);
  }

  .bt-cart__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0;
    padding-top: var(--bt-space-md);
    border-top: 2px solid var(--bt-color-border);
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
  }

  .bt-cart__note { display: flex; flex-direction: column; gap: var(--bt-space-2xs); }
  .bt-cart__note-label { font-size: var(--bt-fs-body-sm); font-weight: var(--bt-fw-semibold); }
  .bt-cart__note-input { resize: vertical; min-height: 72px; }
  .bt-cart__note-actions { display: flex; align-items: center; gap: var(--bt-space-sm); }
  .bt-cart__note-save { padding: 0.5em 1.25em; font-size: var(--bt-fs-body-sm); }
  .bt-cart__note-status { font-size: var(--bt-fs-body-sm); font-weight: var(--bt-fw-semibold); color: var(--bt-color-primary); }

  .bt-cart__checkout-form { margin: 0; }
  .bt-cart__taxes { margin: 0; text-align: center; font-size: var(--bt-fs-body-sm); color: var(--bt-color-text-muted); }
  .bt-cart__continue { margin: 0; text-align: center; font-size: var(--bt-fs-body-sm); }
  .bt-cart__continue a { color: var(--bt-color-primary); }

  /* ── Recommendations ("You may also like") ── */
  .bt-cart-recs { margin-top: var(--bt-space-2xl); }
  .bt-cart-recs__heading {
    margin: 0 0 var(--bt-space-md);
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h3);
    font-weight: var(--bt-fw-normal);
    text-align: center;
    text-wrap: balance;
    color: var(--bt-color-text);
  }
  .bt-cart-recs__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--bt-space-md);
  }
  .bt-cart-recs__card { display: flex; flex-direction: column; }
  .bt-cart-recs__media-wrap { position: relative; }
  .bt-cart-recs__media {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--bt-radius-card);
    background: var(--bt-color-surface);
    box-shadow: var(--bt-shadow-sm);
    transition: box-shadow var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-cart-recs__card:hover .bt-cart-recs__media { box-shadow: var(--bt-shadow-md); }
  .bt-cart-recs__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-cart-recs__card:hover .bt-cart-recs__media img { transform: scale(1.05); }
  .bt-cart-recs__placeholder { width: 100%; height: 100%; background: var(--bt-color-surface); }
  .bt-cart-recs__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--bt-space-2xs) var(--bt-space-3xs) 0;
  }
  .bt-cart-recs__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-medium);
    line-height: 1.3;
    color: var(--bt-color-text);
    text-decoration: none;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bt-cart-recs__title:hover { color: var(--bt-color-primary); }
  .bt-cart-recs__price {
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }
  .bt-cart-recs__compare { font-weight: var(--bt-fw-normal); opacity: 0.55; margin-right: 6px; text-decoration: line-through; }
  /* Quick-add — same look as .bt-card__quick-add in card-product, scoped here
     because that snippet's stylesheet is not guaranteed to load on /cart. */
  .bt-cart-recs .bt-card__quick-add {
    position: absolute;
    left: var(--bt-space-2xs);
    right: var(--bt-space-2xs);
    bottom: var(--bt-space-2xs);
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--bt-space-3xs);
    padding: 0 var(--bt-space-xs);
    background: rgba(var(--bt-color-bg-rgb), 0.96);
    backdrop-filter: blur(6px);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-md);
    cursor: pointer;
    opacity: 0;
    transform: translateY(8px);
    font-family: var(--bt-font-body);
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.02em;
    transition: opacity var(--bt-duration-base) var(--bt-ease-out),
                transform var(--bt-duration-base) var(--bt-ease-out),
                background var(--bt-duration-fast) var(--bt-ease-out);
    z-index: 2;
    box-shadow: var(--bt-shadow-sm);
    color: var(--bt-color-text);
  }
  .bt-cart-recs__card:hover .bt-card__quick-add { opacity: 1; transform: translateY(0); }
  .bt-cart-recs .bt-card__quick-add:hover { background: var(--bt-color-primary); color: var(--bt-color-primary-contrast); border-color: var(--bt-color-primary); }
  .bt-cart-recs .bt-card__quick-add.is-loading { opacity: 1; pointer-events: none; background: var(--bt-color-primary); color: var(--bt-color-primary-contrast); }
  .bt-cart-recs .bt-card__quick-add.is-loading svg { animation: bt-cart-recs-spin 0.8s linear infinite; }
  .bt-cart-recs .bt-card__quick-add.is-added { opacity: 1; background: var(--bt-color-primary); color: var(--bt-color-primary-contrast); border-color: var(--bt-color-primary); }
  @keyframes bt-cart-recs-spin { to { transform: rotate(360deg); } }
  @media (hover: none) {
    .bt-cart-recs .bt-card__quick-add { opacity: 1; transform: none; }
  }

  /* ── Empty state ── */
  .bt-cart__empty {
    padding-block: var(--bt-space-3xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--bt-space-md);
  }
  .bt-cart__empty-icon { width: 120px; height: auto; color: var(--bt-color-primary); opacity: 0.85; }
  .bt-cart__empty-msg { margin: 0; font-family: var(--bt-font-heading); font-size: var(--bt-fs-h4); }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    .bt-cart__layout { grid-template-columns: 1fr; gap: var(--bt-space-lg); }
    .bt-cart__summary { position: static; }
    .bt-cart__item { grid-template-columns: 88px 1fr; padding: var(--bt-space-sm); }
    .bt-cart__item-media { width: 88px; }
    .bt-cart__item-total {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .bt-cart .bt-qty-stepper__btn { width: 44px; height: 44px; }
    .bt-cart .bt-qty-stepper__value { min-width: 36px; height: 44px; }
    .bt-cart-recs__grid { grid-template-columns: repeat(2, 1fr); gap: var(--bt-space-sm); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-cart__item { transition: none; }
    .bt-cart__item.is-removing { transform: none; }
    .bt-cart__shipping-fill { transition: none; }
    .bt-cart-recs__card:hover .bt-cart-recs__media img { transform: none; }
    .bt-cart-recs .bt-card__quick-add { transition: none; }
    .bt-cart-recs .bt-card__quick-add.is-loading svg { animation: none; }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    var root = document.querySelector('[data-bt-cart-page]');

    function money(cents) {
      if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
        var fmt = (window.theme && window.theme.moneyFormat) || ('$' + '{' + '{amount}' + '}');
        return window.Shopify.formatMoney(cents, fmt);
      }
      return '$' + (cents / 100).toFixed(2);
    }

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    /* ── AJAX quantity / removal ── */
    var inflight = {};

    function setRowBusy(key, busy) {
      var row = root && root.querySelector('[data-cart-item][data-key="' + key + '"]');
      if (!row) return;
      row.classList.toggle('is-loading', busy);
      row.querySelectorAll('button').forEach(function (btn) { btn.disabled = busy; });
    }

    function removeRow(row) {
      row.classList.add('is-removing');
      setTimeout(function () {
        if (row.parentNode) row.parentNode.removeChild(row);
      }, 320);
    }

    function announce(cart) {
      var live = document.querySelector('[data-cart-live]');
      if (live) {
        live.textContent = root.getAttribute('data-subtotal-label') + ': ' + money(cart.total_price);
      }
    }

    function updateBadge(cart) {
      var badge = document.querySelector('[data-cart-count]');
      if (badge) {
        badge.textContent = cart.item_count;
        badge.hidden = cart.item_count === 0;
      }
    }

    function updateShipping(cart) {
      var wrap = root.querySelector('[data-cart-shipping]');
      if (!wrap) return;
      var threshold = parseInt(root.getAttribute('data-shipping-threshold'), 10) || 0;
      if (threshold <= 0) return;
      var remaining = threshold - cart.total_price;
      var pct = Math.min(100, Math.round((cart.total_price * 100) / threshold));
      var msg = wrap.querySelector('[data-shipping-msg]');
      var fill = wrap.querySelector('[data-shipping-fill]');
      if (fill) fill.style.width = pct + '%';
      if (msg) {
        if (remaining > 0) {
          msg.classList.remove('bt-cart__shipping-msg--reached');
          msg.textContent = root.getAttribute('data-shipping-remaining').replace('{amount}', money(remaining));
        } else {
          msg.classList.add('bt-cart__shipping-msg--reached');
          msg.textContent = root.getAttribute('data-shipping-reached');
        }
      }
    }

    function render(cart) {
      if (cart.item_count === 0) { window.location.reload(); return; }

      var rows = root.querySelectorAll('[data-cart-item]');
      var domKeys = {};
      rows.forEach(function (row) { domKeys[row.getAttribute('data-key')] = row; });

      var unknownKey = false;
      cart.items.forEach(function (item) {
        var row = domKeys[item.key];
        if (!row) { unknownKey = true; return; }
        var qtyEl = row.querySelector('[data-qty-value]');
        if (qtyEl) qtyEl.textContent = item.quantity;
        var priceEl = row.querySelector('[data-line-price]');
        if (priceEl) priceEl.textContent = money(item.final_line_price);
        var discEl = row.querySelector('[data-line-discounts]');
        if (discEl) {
          var allocs = item.line_level_discount_allocations || [];
          discEl.innerHTML = allocs.map(function (alloc) {
            var title = alloc.discount_application ? alloc.discount_application.title : '';
            return '<li class="bt-cart__item-discount">' +
              '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1h4l6 6-4 4-6-6V1Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="3.5" cy="3.5" r="1" fill="currentColor"/></svg>' +
              esc(title) +
              '<span class="bt-cart__item-discount-amount">−' + money(alloc.amount) + '</span>' +
            '</li>';
          }).join('');
          discEl.hidden = allocs.length === 0;
        }
      });
      /* A line exists server-side that this page cannot render
         (e.g. quick-added from recommendations) — reload for truth. */
      if (unknownKey) { window.location.reload(); return; }

      rows.forEach(function (row) {
        var key = row.getAttribute('data-key');
        var stillThere = cart.items.some(function (item) { return item.key === key; });
        if (!stillThere) removeRow(row);
      });

      var subtotalEl = root.querySelector('[data-cart-subtotal]');
      if (subtotalEl) subtotalEl.textContent = money(cart.total_price);
      var cartDiscEl = root.querySelector('[data-cart-discounts]');
      if (cartDiscEl) {
        var cartDiscounts = cart.cart_level_discount_applications || [];
        cartDiscEl.innerHTML = cartDiscounts.map(function (d) {
          return '<li class="bt-cart__discount">' +
            '<span class="bt-cart__discount-label">' +
              '<svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M1 1h4l6 6-4 4-6-6V1Z" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/><circle cx="3.5" cy="3.5" r="1" fill="currentColor"/></svg>' +
              esc(d.title) +
            '</span>' +
            '<span class="bt-cart__discount-amount">−' + money(d.total_allocated_amount) + '</span>' +
          '</li>';
        }).join('');
        cartDiscEl.hidden = cartDiscounts.length === 0;
      }
      updateShipping(cart);
      updateBadge(cart);
      announce(cart);
    }

    function changeQty(key, qty) {
      if (inflight[key]) return;
      inflight[key] = true;
      setRowBusy(key, true);
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: qty })
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Cart change failed');
          return res.json();
        })
        .then(function (cart) { render(cart); })
        .catch(function () { window.location.reload(); })
        .finally(function () {
          inflight[key] = false;
          setRowBusy(key, false);
        });
    }

    if (root && !root._btCartInit) {
      root._btCartInit = true;

      root.addEventListener('click', function (e) {
        var btn = e.target && e.target.closest ? e.target.closest('button[data-action]') : null;
        if (!btn || btn.disabled || !root.contains(btn)) return;
        var key = btn.getAttribute('data-key');
        if (!key) return;
        if (btn.getAttribute('data-action') === 'qty-plus' || btn.getAttribute('data-action') === 'qty-minus') {
          var stepper = btn.closest('[data-qty-stepper]');
          var valueEl = stepper ? stepper.querySelector('[data-qty-value]') : null;
          var cur = valueEl ? parseInt(valueEl.textContent, 10) : 1;
          if (isNaN(cur)) cur = 1;
          var next = btn.getAttribute('data-action') === 'qty-plus' ? cur + 1 : cur - 1;
          if (next < 0) next = 0;
          changeQty(key, next);
        } else if (btn.getAttribute('data-action') === 'remove') {
          changeQty(key, 0);
        }
      });

      /* ── Order note ── */
      var noteArea = root.querySelector('[data-cart-note]');
      var noteBtn = root.querySelector('[data-note-save]');
      var noteStatus = root.querySelector('[data-note-status]');
      var lastNote = noteArea ? noteArea.value : '';
      var noteTimer = null;

      function showNoteSaved() {
        if (!noteStatus) return;
        noteStatus.hidden = false;
        if (noteTimer) clearTimeout(noteTimer);
        noteTimer = setTimeout(function () { noteStatus.hidden = true; }, 2000);
      }

      function saveNote() {
        if (!noteArea || noteArea.value === lastNote) return;
        var value = noteArea.value;
        if (noteBtn) noteBtn.disabled = true;
        fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ note: value })
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Note save failed');
            lastNote = value;
            showNoteSaved();
          })
          .catch(function () { /* silent — note stays in the textarea */ })
          .finally(function () { if (noteBtn) noteBtn.disabled = false; });
      }

      if (noteArea) noteArea.addEventListener('blur', saveNote);
      if (noteBtn) noteBtn.addEventListener('click', saveNote);
    }

    /* ── "You may also like" recommendations ── */
    var recs = document.querySelector('[data-cart-recs]');
    if (recs && !recs._btRecsInit) {
      recs._btRecsInit = true;
      var productId = recs.getAttribute('data-product-id');
      var grid = recs.querySelector('[data-cart-recs-grid]');
      if (productId && grid) {
        var addLabel = (root && root.getAttribute('data-add-label')) || 'Add to cart';
        var plusSvg = '<svg width="18" height="18" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 7h10M7 2v10" stroke="currentColor" stroke-width="2"/></svg>';
        fetch('/recommendations/products.json?product_id=' + encodeURIComponent(productId) + '&limit=4')
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (data) {
            var products = data && data.products ? data.products : [];
            if (!products.length) return;
            var html = products.map(function (p) {
              var imgSrc = '';
              if (p.featured_image) {
                imgSrc = typeof p.featured_image === 'string'
                  ? p.featured_image
                  : (p.featured_image.src || p.featured_image.url || '');
              }
              if (imgSrc) imgSrc += (imgSrc.indexOf('?') > -1 ? '&' : '?') + 'width=400';
              var img = imgSrc
                ? '<img src="' + esc(imgSrc) + '" width="400" height="500" loading="lazy" alt="' + esc(p.title) + '">'
                : '<div class="bt-cart-recs__placeholder" aria-hidden="true"></div>';
              var priceNum = Number(p.price) || 0;
              var compareNum = Number(p.compare_at_price) || 0;
              var priceHtml = compareNum && compareNum > priceNum
                ? '<s class="bt-cart-recs__compare">' + money(compareNum) + '</s>' + money(priceNum)
                : money(priceNum);
              var v = p.variants && p.variants[0];
              var quickAdd = v && v.available
                ? '<button type="button" class="bt-card__quick-add" data-variant-id="' + v.id + '" aria-label="' + esc(addLabel) + '">' +
                  plusSvg + '<span class="bt-card__quick-add-label">' + esc(addLabel) + '</span></button>'
                : '';
              return '<div class="bt-cart-recs__card">' +
                '<div class="bt-cart-recs__media-wrap">' +
                  '<a class="bt-cart-recs__media" href="' + esc(p.url) + '" tabindex="-1" aria-hidden="true">' + img + '</a>' +
                  quickAdd +
                '</div>' +
                '<div class="bt-cart-recs__info">' +
                  '<a class="bt-cart-recs__title" href="' + esc(p.url) + '">' + esc(p.title) + '</a>' +
                  '<span class="bt-cart-recs__price">' + priceHtml + '</span>' +
                '</div>' +
              '</div>';
            }).join('');
            grid.innerHTML = html;
            recs.hidden = false;
          })
          .catch(function () { /* no recommendations — section stays hidden */ });
      }
    }

    /* ── Sync page when items are added elsewhere (quick-add, upsells) ── */
    if (root && !root._btCartSync) {
      root._btCartSync = true;
      document.addEventListener('cart:added', function () {
        fetch('/cart.js')
          .then(function (res) { return res.ok ? res.json() : null; })
          .then(function (cart) { if (cart) render(cart); })
          .catch(function () { /* drawer already reflects the add */ });
      });
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.main_cart_items.name",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_free_shipping_bar", "label": "t:sections.main_cart.settings.show_free_shipping_bar.label", "default": true },
    { "type": "text", "id": "free_shipping_threshold", "label": "t:sections.main_cart.settings.free_shipping_threshold.label", "default": "50" },
    { "type": "checkbox", "id": "show_order_note", "label": "t:sections.main_cart.settings.show_order_note.label", "default": true },
    { "type": "checkbox", "id": "show_recommendations", "label": "t:sections.main_cart.settings.show_recommendations.label", "default": true },
    { "type": "text", "id": "recommendations_heading", "label": "t:sections.main_cart.settings.recommendations_heading.label", "default": "You may also like" }
  ]
}
{% endschema %}
