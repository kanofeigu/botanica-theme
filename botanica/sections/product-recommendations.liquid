{% comment %}
  sections/product-recommendations.liquid — "You may also like" row.
  Fetches Shopify's native product recommendations asynchronously via
  {{ routes.product_recommendations_url }} so it works even for fresh
  products where the Liquid `recommendations` object is empty. Builds
  cards client-side (image, title, price, link). No external libs,
  no custom metafield. Heading + limit merchant-editable.
{% endcomment %}
{%- liquid
  assign heading = section.settings.heading | default: 'You may also like'
  assign limit = section.settings.limit | default: 4
-%}
<product-recommendations
  class="bt-recommendations color-{{ section.settings.color_scheme }}"
  {{ section.shopify_attributes }}
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  data-url="{{ routes.product_recommendations_url }}.json?product_id={{ product.id }}&limit={{ limit }}"
  data-limit="{{ limit }}"
  aria-label="{{ heading | escape }}"
>
  <div class="bt-container">
    {%- if heading != blank -%}
      <h2 class="bt-recommendations__heading">{{ heading | escape }}</h2>
    {%- endif -%}
    <ul class="bt-recommendations__list" role="list" data-recommendations-list>
      {%- comment -%} Cards injected by {% javascript %} below {%- endcomment -%}
    </ul>
    <p class="bt-recommendations__empty" data-recommendations-empty hidden>{{ 'products.product.no_recommendations' | t }}</p>
  </div>
</product-recommendations>

{% javascript %}
  (function () {
    function money(cents, fmt) {
      if (!fmt) return '$' + (cents / 100).toFixed(2);
      var amount = (cents / 100).toFixed(2);
      return fmt.replace(/\{\{\s*amount\s*\}\}/, amount)
                .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, amount.replace('.', ','));
    }
    function cardHTML(p, moneyFormat) {
      /* Shopify recommendations API: featured_image is a STRING URL, not an object. */
      var imgSrc = '';
      if (p.featured_image) {
        imgSrc = typeof p.featured_image === 'string'
          ? p.featured_image
          : (p.featured_image.src || p.featured_image.url || '');
      }
      if (imgSrc) {
        /* Append width param (Shopify CDN URLs already contain ?v=...) */
        imgSrc += (imgSrc.indexOf('?') > -1 ? '&' : '?') + 'width=400';
      }
      var img = imgSrc
        ? '<img src="' + imgSrc + '" width="400" height="400" loading="lazy" alt="' + (p.title || '').replace(/"/g, '&quot;') + '" class="bt-recommendations__img">'
        : '<div class="bt-recommendations__placeholder" aria-hidden="true"></div>';
      var priceNum = Number(p.price) || 0;
      var compareNum = Number(p.compare_at_price) || 0;
      var priceHTML = '';
      if (compareNum && compareNum > priceNum) {
        priceHTML = '<s class="bt-recommendations__compare">' + money(compareNum, moneyFormat) + '</s>' + money(priceNum, moneyFormat);
      } else {
        priceHTML = money(priceNum, moneyFormat);
      }
      var href = p.url || (window.theme.routes.all_products_collection_url + '/' + p.handle);
      return '<li class="bt-recommendations__item" role="listitem">' +
        '<a href="' + href + '" class="bt-recommendations__link" aria-label="' + (p.title || '').replace(/"/g, '&quot;') + '">' +
        '<div class="bt-recommendations__media">' + img + '</div>' +
        '<div class="bt-recommendations__info">' +
        '<span class="bt-recommendations__title">' + (p.title || '') + '</span>' +
        '<span class="bt-recommendations__price">' + priceHTML + '</span>' +
        '</div></a></li>';
    }
    function init(el) {
      if (el._btInit) return; el._btInit = true;
      var url = el.getAttribute('data-url');
      var list = el.querySelector('[data-recommendations-list]');
      var empty = el.querySelector('[data-recommendations-empty]');
      if (!url || !list) return;
      var moneyFormat = (window.theme && window.theme.moneyFormat) || null;
      fetch(url, { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (data) {
          var products = data && data.products ? data.products : [];
          if (!products.length) { if (empty) empty.hidden = false; return; }
          list.innerHTML = products.map(function (p) { return cardHTML(p, moneyFormat); }).join('');
        })
        .catch(function () { if (empty) empty.hidden = false; });
    }
    var roots = document.querySelectorAll('product-recommendations');
    roots.forEach(init);
  })();
{% endjavascript %}

{% stylesheet %}
  .bt-recommendations { padding-block: var(--bt-space-lg); }
  .bt-recommendations__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h3);
    font-weight: var(--bt-fw-normal);
    margin: 0 0 var(--bt-space-md);
    color: var(--bt-color-text);
    text-align: center;
    text-wrap: balance;
  }
  .bt-recommendations__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--bt-space-sm);
  }
  .bt-recommendations__item {
    background: transparent;
    border: none;
    border-radius: 0;
    transition: none;
  }
  .bt-recommendations__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .bt-recommendations__media {
    aspect-ratio: 4 / 5;
    background: var(--bt-color-surface);
    overflow: hidden;
    border-radius: var(--bt-radius-card);
    box-shadow: 0 1px 3px rgba(var(--bt-color-text-rgb), 0.06);
    transition: box-shadow var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-recommendations__item:hover .bt-recommendations__media {
    box-shadow: var(--bt-shadow-md);
  }
  .bt-recommendations__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-recommendations__item:hover .bt-recommendations__img { transform: scale(1.05); }
  .bt-recommendations__placeholder { width: 100%; height: 100%; background: var(--bt-color-surface); }
  .bt-recommendations__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--bt-space-2xs) var(--bt-space-3xs) 0;
  }
  .bt-recommendations__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-medium);
    line-height: 1.3;
    color: var(--bt-color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bt-recommendations__price {
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text-muted);
    font-variant-numeric: oldstyle-nums;
  }
  .bt-recommendations__compare {
    font-weight: var(--bt-fw-normal);
    opacity: 0.55;
    margin-right: 6px;
    text-decoration: line-through;
  }
  .bt-recommendations__empty {
    text-align: center;
    color: var(--bt-color-text-muted);
    font-size: var(--bt-fs-body-sm);
  }
  @media (min-width: 750px) {
    .bt-recommendations__list { grid-template-columns: repeat(4, 1fr); gap: var(--bt-space-md); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bt-recommendations__item:hover { transform: none; }
    .bt-recommendations__item:hover .bt-recommendations__img { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "t:sections.product_recommendations.settings.heading.label", "default": "You may also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "default": 4, "label": "t:sections.product_recommendations.settings.limit.label" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "t:sections.product_recommendations.settings.padding_top.label" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40, "label": "t:sections.product_recommendations.settings.padding_bottom.label" }
  ],
  "presets": [{ "name": "t:sections.product_recommendations.name" }]
}
{% endschema %}
