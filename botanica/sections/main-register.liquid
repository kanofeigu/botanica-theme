{% comment %} main-register.liquid — Customer registration page. Original. {% endcomment %}
<div class="bt-section bt-register" {{ section.shopify_attributes }}>
  <div class="bt-container" style="max-width: 480px;">
    <h1 class="bt-h1 bt-text-center">{{ 'customer.register.title' | t }}</h1>
    {%- form 'create_customer', class: 'bt-register__form bt-stack-md' -%}
      <div><label for="RegisterFirstName" class="bt-label">{{ 'customer.register.first_name' | t }}</label><input type="text" id="RegisterFirstName" name="customer[first_name]" class="bt-input" required autocomplete="given-name"></div>
      <div><label for="RegisterLastName" class="bt-label">{{ 'customer.register.last_name' | t }}</label><input type="text" id="RegisterLastName" name="customer[last_name]" class="bt-input" required autocomplete="family-name"></div>
      <div><label for="RegisterEmail" class="bt-label">{{ 'customer.register.email' | t }}</label><input type="email" id="RegisterEmail" name="customer[email]" class="bt-input" required autocomplete="email"></div>
      <div><label for="RegisterPassword" class="bt-label">{{ 'customer.register.password' | t }}</label><input type="password" id="RegisterPassword" name="customer[password]" class="bt-input" required autocomplete="new-password"></div>
      <button type="submit" class="bt-btn bt-btn--primary bt-btn--lg bt-btn--block">{{ 'customer.register.submit' | t }}</button>
      <p class="bt-text-center bt-fs-body-sm"><a href="{{ routes.account_login_url }}">{{ 'customer.register.login_link' | t }}</a></p>
      {%- if form.errors -%}<p class="bt-form-error bt-text-center" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .bt-register__form { margin-top: var(--bt-space-lg); }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_register.name", "presets": [{ "name": "t:sections.main_register.name" }] }
{% endschema %}
