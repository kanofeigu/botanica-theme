{% comment %}
  sections/featured-product.liquid — Featured single product section.
  Theme blocks + app blocks: the info column renders section blocks via
  content_for "blocks" (same architecture as main-product). Blocks receive
  the section product because `product` is assigned before rendering.
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign product = section.settings.product
  assign first_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
-%}
{%- if product != blank -%}
  <section class="bt-section bt-featured-product color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="bt-container">
      <div class="bt-featured-product__grid">
        <div class="bt-featured-product__media">
          {%- if product.featured_media -%}
            <a href="{{ product.url }}" aria-label="{{ product.title }}">
              {{ product.featured_media | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: product.featured_media.alt | default: product.title
              }}
            </a>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'bt-featured-product__placeholder' }}
          {%- endif -%}
        </div>
        <div class="bt-featured-product__info">
          {%- form 'product', product, id: product_form_id, class: 'bt-featured-product__form' -%}
            <input type="hidden" name="id" value="{{ first_variant.id }}" data-variant-id>
            <div class="bt-product__aria-live" aria-live="polite" role="status" data-aria-live></div>
            {% content_for "blocks" %}
          {%- endform -%}
        </div>
      </div>
    </div>
  </section>

  <script src="{{ 'variant-selects.js' | asset_url }}" defer="defer"></script>
  <script>
    window.theme = window.theme || {};
    window.theme.variantI18n = {
      inStock: {{ 'products.product.inventory_in_stock' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      unavailable: {{ 'products.product.unavailable' | t | json }},
      addToCart: {{ 'products.product.add_to_cart' | t | json }}
    };
  </script>
{%- endif -%}

{% stylesheet %}
  .bt-featured-product__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--bt-space-xl);
    align-items: center;
  }
  .bt-featured-product__media {
    border-radius: var(--bt-radius-card);
    overflow: hidden;
    background: var(--bt-color-surface);
    aspect-ratio: 4 / 5;
  }
  .bt-featured-product__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-featured-product__placeholder {
    width: 100%;
    height: 100%;
    background: var(--bt-color-surface);
  }
  .bt-featured-product__info {
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-md);
    padding: var(--bt-space-md);
    min-width: 0;
  }
  .bt-featured-product__form {
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-md);
  }
  .bt-featured-product__form > * { margin: 0; }
  /* Let each block own its surface; neutralize the shopify-block wrapper */
  .bt-featured-product__form .shopify-block { margin: 0; padding: 0; background: transparent; border: none; }
  /* Screen-reader-only live region for variant/price announcements
     (self-contained: main-product's stylesheet is not present here) */
  .bt-featured-product .bt-product__aria-live { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
  /* Blocks designed for the PDP info column run full-width here too */
  .bt-featured-product__form .shopify-block .bt-product-price__current {
    font-size: var(--bt-fs-h3);
  }
  @media (max-width: 749px) {
    .bt-featured-product__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_product.name",
  "tag": "section",
  "blocks": [
    { "type": "specimen-eyebrow" },
    { "type": "product-title" },
    { "type": "product-badges" },
    { "type": "product-price" },
    { "type": "product-rating" },
    { "type": "variant-picker" },
    { "type": "quantity-selector" },
    { "type": "buy-buttons" },
    { "type": "description" },
    { "type": "product-description" },
    { "type": "share" },
    { "type": "custom-liquid" },
    { "type": "@app" }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured_product.settings.product.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.featured_product.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.featured_product.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product.name",
      "blocks": [
        { "type": "specimen-eyebrow" },
        { "type": "product-title" },
        { "type": "product-price" },
        { "type": "variant-picker", "settings": { "picker_type": "swatch", "swatch_option_index": "1" } },
        { "type": "buy-buttons", "settings": { "show_dynamic_checkout": true, "show_quantity": false, "show_cart_icon": false, "show_trust_badges": false } }
      ]
    }
  ]
}
{% endschema %}
