{% comment %}
  sections/featured-product.liquid — Featured single product section
  Shows one product with image, title, price, and buy buttons.
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign product_ref = section.settings.product
  assign show_vendor = section.settings.show_vendor
  assign show_price = section.settings.show_price
  assign show_buy = section.settings.show_buy_button
-%}
{%- if product_ref != blank -%}
  <section class="bt-section bt-featured-product color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="bt-container">
      <div class="bt-featured-product__grid">
        <div class="bt-featured-product__media">
          {%- if product_ref.featured_media -%}
            <a href="{{ product_ref.url }}" aria-label="{{ product_ref.title }}">
              {{ product_ref.featured_media | image_url: width: 800 | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                alt: product_ref.featured_media.alt | default: product_ref.title
              }}
            </a>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'bt-featured-product__placeholder' }}
          {%- endif -%}
        </div>
        <div class="bt-featured-product__info">
          {%- if show_vendor -%}
            <p class="bt-eyebrow">{{ product_ref.vendor }}</p>
          {%- endif -%}
          <h2 class="bt-featured-product__title">
            <a href="{{ product_ref.url }}">{{ product_ref.title }}</a>
          </h2>
          {%- if show_price -%}
            <div class="bt-featured-product__price">
              {%- if product_ref.compare_at_price > product_ref.price -%}
                <s>{{ product_ref.compare_at_price | money }}</s>
                <span style="color:var(--bt-color-secondary)">{{ product_ref.price | money }}</span>
              {%- else -%}
                {{ product_ref.price | money }}
              {%- endif -%}
              {%- if product_ref.selected_or_first_available_variant.unit_price -%}
                <small>{{ product_ref.selected_or_first_available_variant.unit_price | money }} / {{ 'products.product.unit_price_separator' | t }}</small>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.show_description and product_ref.description != blank -%}
            <div class="bt-featured-product__desc">
              {{ product_ref.description | strip_html | truncate: 200 }}
            </div>
          {%- endif -%}
          <div class="bt-featured-product__actions">
            {%- if show_buy -%}
              <a href="{{ product_ref.url }}" class="bt-btn bt-btn--primary">
                {{ 'products.product.view_product' | t }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .bt-featured-product__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--bt-space-xl);
    align-items: center;
  }
  .bt-featured-product__media {
    border-radius: var(--bt-radius-card);
    overflow: hidden;
    background: var(--bt-color-surface);
    aspect-ratio: 4 / 5;
  }
  .bt-featured-product__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-featured-product__placeholder {
    width: 100%;
    height: 100%;
    background: var(--bt-color-surface);
  }
  .bt-featured-product__info {
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-sm);
    padding: var(--bt-space-md);
  }
  .bt-featured-product__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    margin: 0;
  }
  .bt-featured-product__title a {
    color: inherit;
    text-decoration: none;
  }
  .bt-featured-product__title a:hover { color: var(--bt-color-primary); }
  .bt-featured-product__price {
    font-size: var(--bt-fs-h4);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text);
    display: flex;
    align-items: center;
    gap: var(--bt-space-2xs);
    flex-wrap: wrap;
  }
  .bt-featured-product__price s {
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text-muted);
    text-decoration-thickness: 1px;
  }
  .bt-featured-product__desc {
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
    max-width: 55ch;
  }
  .bt-featured-product__actions {
    display: flex;
    gap: var(--bt-space-sm);
    align-items: center;
    margin-top: var(--bt-space-sm);
  }
  @media (max-width: 749px) {
    .bt-featured-product__grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_product.name",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured_product.settings.product.label"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.featured_product.settings.show_description.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.featured_product.settings.show_vendor.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:sections.featured_product.settings.show_price.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_buy_button",
      "label": "t:sections.featured_product.settings.show_buy_button.label",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.featured_product.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.featured_product.settings.padding_bottom.label"
    }
  ],
  "presets": [{ "name": "t:sections.featured_product.name" }]
}
{% endschema %}
