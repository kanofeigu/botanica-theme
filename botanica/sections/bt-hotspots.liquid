{% comment %}
  sections/bt-hotspots.liquid — Shoppable image ("Shop the look").
  One editorial image plate with positioned hotspot markers (block per
  hotspot). Hovering / focusing a marker reveals a mini product card;
  the whole card acts as one link via a stretched CTA anchor (same
  pattern as snippets/mega-promo-card.liquid). Tap toggles the card on
  touch devices via the small JS below. Without JS — and always on
  mobile — a plain product grid renders below the image as fallback.
  Reduced motion → markers are static (no pulse).
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign hotspot_aspect = '4 / 3'
  if section.settings.image_aspect == '16-9'
    assign hotspot_aspect = '16 / 9'
  elsif section.settings.image_aspect == '1-1'
    assign hotspot_aspect = '1 / 1'
  endif
-%}
<section
  class="bt-hotspots color-{{ section.settings.color_scheme }}"
  {{ section.shopify_attributes }}
  style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="bt-container">
    {%- if section.settings.heading != blank -%}
      <div class="bt-hotspots__header">
        <h2 class="bt-hotspots__heading bt-display-md">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="bt-hotspots__stage">
      <figure class="bt-hotspots__figure">
        <div class="bt-hotspots__media" style="aspect-ratio: {{ hotspot_aspect }}">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 1300px) 1250px, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading,
              class: 'bt-hotspots__img'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'bt-hotspots__placeholder' }}
          {%- endif -%}
        </div>

        {%- comment -%} Hotspot overlay sits outside the clipped media frame so
            cards are never cropped by overflow:hidden. {%- endcomment -%}
        {%- if section.blocks.size > 0 -%}
          <div class="bt-hotspots__overlay">
            {%- for block in section.blocks -%}
              {%- liquid
                assign hotspot_product = block.settings.product
                assign pos_x = block.settings.x | default: 50
                assign pos_y = block.settings.y | default: 50

                assign h_align = 'center'
                if pos_x <= 30
                  assign h_align = 'start'
                elsif pos_x >= 70
                  assign h_align = 'end'
                endif
                assign v_pos = 'above'
                if pos_y < 35
                  assign v_pos = 'below'
                endif

                assign dot_label = block.settings.label | default: hotspot_product.title
              -%}
              <div
                class="bt-hotspots__hotspot bt-hotspots__hotspot--h-{{ h_align }} bt-hotspots__hotspot--v-{{ v_pos }}"
                style="--bt-hotspot-x: {{ pos_x }}%; --bt-hotspot-y: {{ pos_y }}%;"
                {{ block.shopify_attributes }}
              >
                <button
                  type="button"
                  class="bt-hotspots__dot"
                  aria-expanded="false"
                  aria-controls="bt-hotspot-card-{{ section.id }}-{{ block.id }}"
                  {%- if dot_label != blank %}
                  aria-label="{{ 'sections.bt_hotspots.show_product' | t: product: dot_label | escape }}"
                  {%- else %}
                  aria-label="{{ 'sections.bt_hotspots.show_product_generic' | t }}"
                  {%- endif %}
                >
                  <span class="bt-hotspots__dot-core" aria-hidden="true"></span>
                </button>

                {%- if hotspot_product != blank -%}
                  <div class="bt-hotspots__card" id="bt-hotspot-card-{{ section.id }}-{{ block.id }}" role="group" aria-label="{{ hotspot_product.title | escape }}">
                    <span class="bt-hotspots__card-media">
                      {%- if hotspot_product.featured_media -%}
                        {{ hotspot_product.featured_media | image_url: width: 300 | image_tag:
                          loading: 'lazy',
                          widths: '150, 300',
                          sizes: '72px',
                          alt: hotspot_product.featured_media.alt | default: hotspot_product.title
                        }}
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'bt-hotspots__card-placeholder' }}
                      {%- endif -%}
                    </span>
                    <span class="bt-hotspots__card-body">
                      {%- if block.settings.label != blank -%}
                        <span class="bt-hotspots__card-label bt-micro-label">{{ block.settings.label | escape }}</span>
                      {%- endif -%}
                      <span class="bt-hotspots__card-title">{{ hotspot_product.title | escape }}</span>
                      <span class="bt-hotspots__card-price">
                        {%- if hotspot_product.compare_at_price > hotspot_product.price -%}
                          <s class="bt-hotspots__card-compare">{{ hotspot_product.compare_at_price | money }}</s>
                        {%- endif -%}
                        {%- if hotspot_product.price_varies -%}
                          {{ 'products.product.price.from_price_html' | t: price: hotspot_product.price | money }}
                        {%- else -%}
                          {{ hotspot_product.price | money }}
                        {%- endif -%}
                      </span>
                      <a
                        href="{{ hotspot_product.url }}"
                        class="bt-hotspots__card-cta"
                        aria-label="{{ 'products.product.view_product' | t }}: {{ hotspot_product.title | escape }}"
                      >
                        {{- 'products.product.view_details' | t -}}
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                      </a>
                    </span>
                  </div>
                {%- elsif block.settings.label != blank -%}
                  <span class="bt-hotspots__tag bt-micro-label" id="bt-hotspot-card-{{ section.id }}-{{ block.id }}">{{ block.settings.label | escape }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </figure>
    </div>

    {%- comment -%} Fallback product grid — always rendered for mobile and
        no-JS visitors; hidden on desktop once JS enables the popover cards.
        Carries no shopify_attributes (those live on the overlay markers). {%- endcomment -%}
    {%- assign listed_products = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.product != blank -%}
        {%- assign listed_products = listed_products | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if listed_products > 0 -%}
      <ul class="bt-hotspots__list" role="list">
        {%- for block in section.blocks -%}
          {%- assign list_product = block.settings.product -%}
          {%- if list_product != blank -%}
            <li class="bt-hotspots__item">
              <span class="bt-hotspots__item-media">
                {%- if list_product.featured_media -%}
                  {{ list_product.featured_media | image_url: width: 400 | image_tag:
                    loading: 'lazy',
                    widths: '200, 300, 400',
                    sizes: '(max-width: 749px) 40vw, 200px',
                    alt: list_product.featured_media.alt | default: list_product.title
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'bt-hotspots__card-placeholder' }}
                {%- endif -%}
              </span>
              <span class="bt-hotspots__item-body">
                {%- if block.settings.label != blank -%}
                  <span class="bt-hotspots__card-label bt-micro-label">{{ block.settings.label | escape }}</span>
                {%- endif -%}
                <span class="bt-hotspots__card-title">{{ list_product.title | escape }}</span>
                <span class="bt-hotspots__card-price">
                  {%- if list_product.compare_at_price > list_product.price -%}
                    <s class="bt-hotspots__card-compare">{{ list_product.compare_at_price | money }}</s>
                  {%- endif -%}
                  {%- if list_product.price_varies -%}
                    {{ 'products.product.price.from_price_html' | t: price: list_product.price | money }}
                  {%- else -%}
                    {{ list_product.price | money }}
                  {%- endif -%}
                </span>
                <a
                  href="{{ list_product.url }}"
                  class="bt-hotspots__card-cta"
                  aria-label="{{ 'products.product.view_product' | t }}: {{ list_product.title | escape }}"
                >
                  {{- 'products.product.view_details' | t -}}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                </a>
              </span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .bt-hotspots__header {
    margin-bottom: var(--bt-space-lg);
  }
  .bt-hotspots__heading {
    margin: 0;
  }

  /* ── Image plate: double hairline specimen frame ── */
  .bt-hotspots__stage {
    border: 1px solid var(--bt-hairline);
    background: var(--bt-color-surface);
    padding: clamp(8px, 0.9vw, 12px);
  }
  .bt-hotspots__figure {
    position: relative;
    margin: 0;
  }
  .bt-hotspots__media {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--bt-hairline);
    background: var(--bt-color-surface-hover);
  }
  .bt-hotspots__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-hotspots__placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.15;
  }

  /* ── Hotspot overlay (not clipped by the media frame) ── */
  .bt-hotspots__overlay {
    position: absolute;
    inset: 0;
  }
  .bt-hotspots__hotspot {
    position: absolute;
    left: var(--bt-hotspot-x);
    top: var(--bt-hotspot-y);
    transform: translate(-50%, -50%);
    z-index: 2;
  }

  /* Marker — 24px touch target with a quiet pulse ring (motion-safe only) */
  .bt-hotspots__dot {
    position: relative;
    width: 24px;
    height: 24px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(var(--bt-color-bg-rgb), 0.9);
    border: 1px solid var(--bt-color-border-medium);
    border-radius: var(--bt-radius-pill);
    cursor: pointer;
    color: var(--bt-color-text);
    backdrop-filter: blur(2px);
  }
  .bt-hotspots__dot-core {
    width: 8px;
    height: 8px;
    border-radius: var(--bt-radius-pill);
    background: currentColor;
    transition: transform var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-hotspots__dot:hover .bt-hotspots__dot-core,
  .bt-hotspots__hotspot.is-open .bt-hotspots__dot-core {
    transform: scale(1.35);
  }
  .bt-hotspots__dot:focus-visible {
    outline: var(--bt-focus-ring-width) solid var(--bt-color-focus-ring);
    outline-offset: var(--bt-focus-ring-offset);
  }
  @media (prefers-reduced-motion: no-preference) {
    .bt-hotspots__dot::before {
      content: '';
      position: absolute;
      inset: -1px;
      border-radius: var(--bt-radius-pill);
      border: 1px solid currentColor;
      opacity: 0;
      animation: bt-hotspot-pulse 2.8s var(--bt-ease-out) infinite;
      pointer-events: none;
    }
  }
  @keyframes bt-hotspot-pulse {
    0%   { transform: scale(0.9); opacity: 0.55; }
    70%, 100% { transform: scale(2); opacity: 0; }
  }

  /* ── Mini product card (popover) — hairline specimen frame, stretched link ── */
  .bt-hotspots__card {
    position: absolute;
    bottom: calc(100% + var(--bt-space-xs));
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    z-index: var(--bt-z-dropdown);
    width: 264px;
    max-width: 72vw;
    display: flex;
    gap: var(--bt-space-xs);
    padding: var(--bt-space-2xs);
    background: var(--bt-color-surface);
    border: 1px solid var(--bt-color-border-medium);
    border-radius: var(--bt-radius-sm);
    box-shadow: var(--bt-shadow-md);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--bt-duration-fast) var(--bt-ease-out),
                transform var(--bt-duration-fast) var(--bt-ease-out),
                visibility var(--bt-duration-fast);
  }
  /* Vertical flip: card opens below the dot near the top edge */
  .bt-hotspots__hotspot--v-below .bt-hotspots__card {
    bottom: auto;
    top: calc(100% + var(--bt-space-xs));
    transform: translateX(-50%) translateY(-4px);
  }
  /* Horizontal alignment: keep the card inside the frame near the side edges */
  .bt-hotspots__hotspot--h-start .bt-hotspots__card {
    left: -12px;
    transform: translateY(4px);
  }
  .bt-hotspots__hotspot--h-start.bt-hotspots__hotspot--v-below .bt-hotspots__card {
    transform: translateY(-4px);
  }
  .bt-hotspots__hotspot--h-end .bt-hotspots__card {
    left: auto;
    right: -12px;
    transform: translateY(4px);
  }
  .bt-hotspots__hotspot--h-end.bt-hotspots__hotspot--v-below .bt-hotspots__card {
    transform: translateY(-4px);
  }

  /* Reveal: hover/focus on pointer devices, .is-open toggled by JS on touch */
  @media (hover: hover) {
    .bt-hotspots__hotspot:hover .bt-hotspots__card,
    .bt-hotspots__hotspot:focus-within .bt-hotspots__card {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateX(-50%) translateY(0);
    }
    .bt-hotspots__hotspot--h-start:hover .bt-hotspots__card,
    .bt-hotspots__hotspot--h-start:focus-within .bt-hotspots__card,
    .bt-hotspots__hotspot--h-end:hover .bt-hotspots__card,
    .bt-hotspots__hotspot--h-end:focus-within .bt-hotspots__card {
      transform: translateY(0);
    }
  }
  .bt-hotspots__hotspot.is-open .bt-hotspots__card {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateX(-50%) translateY(0);
  }
  .bt-hotspots__hotspot--h-start.is-open .bt-hotspots__card,
  .bt-hotspots__hotspot--h-end.is-open .bt-hotspots__card {
    transform: translateY(0);
  }

  /* Label-only marker (no product picked): plain caption, always visible */
  .bt-hotspots__tag {
    position: absolute;
    bottom: calc(100% + var(--bt-space-3xs));
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 8px;
    background: rgba(var(--bt-color-bg-rgb), 0.88);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-tag);
    color: var(--bt-color-text-muted);
    white-space: nowrap;
    pointer-events: none;
  }

  /* ── Card internals (shared by popover + fallback grid) ── */
  .bt-hotspots__card-media,
  .bt-hotspots__item-media {
    display: block;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--bt-color-surface-hover);
    border-radius: var(--bt-radius-sm);
  }
  .bt-hotspots__card-media {
    width: 72px;
    aspect-ratio: 4 / 5;
  }
  .bt-hotspots__card-media img,
  .bt-hotspots__item-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bt-hotspots__card-placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }
  .bt-hotspots__card-body,
  .bt-hotspots__item-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--bt-space-3xs);
    min-width: 0;
    padding: var(--bt-space-3xs) 0;
  }
  .bt-hotspots__card-label {
    color: var(--bt-color-secondary-text);
  }
  .bt-hotspots__card-title {
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    line-height: var(--bt-lh-heading);
    color: var(--bt-color-text);
  }
  .bt-hotspots__card-price {
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text);
    font-variant-numeric: oldstyle-nums;
  }
  .bt-hotspots__card-compare {
    color: var(--bt-color-text-muted);
    margin-right: var(--bt-space-3xs);
  }
  .bt-hotspots__card-cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: var(--bt-space-3xs);
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--bt-color-primary);
    text-decoration: none;
  }
  /* Stretched link: the whole card is clickable through this one anchor */
  .bt-hotspots__card-cta::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .bt-hotspots__card:focus-within,
  .bt-hotspots__item:focus-within {
    outline: var(--bt-focus-ring-width) solid var(--bt-color-focus-ring);
    outline-offset: var(--bt-focus-ring-offset);
  }
  .bt-hotspots__card-cta:focus-visible {
    outline: none;
  }

  /* ── Fallback product grid (mobile + no-JS) ── */
  .bt-hotspots__list {
    list-style: none;
    margin: var(--bt-space-lg) 0 0;
    padding: var(--bt-space-md) 0 0;
    border-top: 1px solid var(--bt-hairline);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--bt-space-sm);
  }
  .bt-hotspots__item {
    position: relative;
    display: flex;
    gap: var(--bt-space-xs);
    padding: var(--bt-space-2xs);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-sm);
    background: var(--bt-color-surface);
  }
  .bt-hotspots__item-media {
    width: 64px;
    aspect-ratio: 4 / 5;
  }
  /* Once JS is up, desktop uses popover cards only; the grid stays on mobile */
  @media (min-width: 990px) {
    .bt-js .bt-hotspots__list {
      display: none;
    }
  }
  @media (max-width: 749px) {
    .bt-hotspots__card {
      width: 232px;
    }
    .bt-hotspots__list {
      grid-template-columns: 1fr;
    }
  }

  /* Reduced motion: static markers, instant card swaps */
  @media (prefers-reduced-motion: reduce) {
    .bt-hotspots__dot-core,
    .bt-hotspots__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Hotspot popovers: tap to toggle on touch devices, Escape / outside
     click to close. One document-level delegated listener, globally guarded
     so multiple hotspot sections never double-bind. Hover/focus reveal on
     pointer devices is pure CSS and needs no JS. */
  (function () {
    if (window.__btHotspotsBound) return;
    window.__btHotspotsBound = true;

    function setOpen(hotspot, open) {
      hotspot.classList.toggle('is-open', open);
      var dot = hotspot.querySelector('.bt-hotspots__dot');
      if (dot) dot.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    function closeAll(except) {
      document.querySelectorAll('.bt-hotspots__hotspot.is-open').forEach(function (hotspot) {
        if (hotspot !== except) setOpen(hotspot, false);
      });
    }

    document.addEventListener('click', function (e) {
      var dot = e.target.closest('.bt-hotspots__dot');
      if (!dot) {
        /* Click outside any hotspot closes open cards; clicks inside a card
           (e.g. the stretched link) must not close it first. */
        if (!e.target.closest('.bt-hotspots__hotspot')) closeAll(null);
        return;
      }
      var hotspot = dot.closest('.bt-hotspots__hotspot');
      if (!hotspot) return;
      var open = !hotspot.classList.contains('is-open');
      closeAll(hotspot);
      setOpen(hotspot, open);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') closeAll(null);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.bt_hotspots.name",
  "tag": "section",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "hotspot",
      "name": "t:sections.bt_hotspots.blocks.hotspot.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.bt_hotspots.blocks.hotspot.settings.product.label"
        },
        {
          "type": "range",
          "id": "x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.bt_hotspots.blocks.hotspot.settings.x.label",
          "info": "t:sections.bt_hotspots.blocks.hotspot.settings.x.info",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "t:sections.bt_hotspots.blocks.hotspot.settings.y.label",
          "info": "t:sections.bt_hotspots.blocks.hotspot.settings.y.info",
          "default": 50
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.bt_hotspots.blocks.hotspot.settings.label.label",
          "info": "t:sections.bt_hotspots.blocks.hotspot.settings.label.info"
        }
      ]
    }
  ],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.bt_hotspots.settings.heading.label",
      "default": "t:sections.bt_hotspots.settings.heading.default"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.bt_hotspots.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_aspect",
      "label": "t:sections.bt_hotspots.settings.image_aspect.label",
      "options": [
        { "value": "16-9", "label": "t:sections.bt_hotspots.settings.image_aspect.options__1.label" },
        { "value": "4-3", "label": "t:sections.bt_hotspots.settings.image_aspect.options__2.label" },
        { "value": "1-1", "label": "t:sections.bt_hotspots.settings.image_aspect.options__3.label" }
      ],
      "default": "4-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.bt_hotspots.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.bt_hotspots.settings.padding_bottom.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.bt_hotspots.name",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 32, "y": 48, "label": "Statement plant" } },
        { "type": "hotspot", "settings": { "x": 68, "y": 30, "label": "Sculptural pot" } }
      ]
    }
  ]
}
{% endschema %}
