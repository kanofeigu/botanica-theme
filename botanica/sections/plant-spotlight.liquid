{% comment %}
  sections/plant-spotlight.liquid — Plant spotlight (flagship section)
  Editorial plant focus: large specimen media + eyebrow/heading/text/care
  blocks rendered as theme blocks. The grid pins the media block to the left
  column (spanning all rows); every other block flows down the right column.
  All-original. Zero Dawn code.
{% endcomment %}
<section class="bt-section bt-plant-spotlight color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bt-container">
    <div class="bt-plant-spotlight__grid">
      {% content_for "blocks" %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bt-plant-spotlight__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--bt-space-xl);
    row-gap: var(--bt-space-md);
    align-items: start;
  }
  /* Theme blocks render inside .shopify-block wrappers: the media block pins
     left and spans every row; all other blocks flow down the right column. */
  .bt-plant-spotlight__grid > .shopify-block { grid-column: 2; }
  .bt-plant-spotlight__grid > .shopify-block:has(.bt-spotlight-media) {
    grid-column: 1;
    grid-row: 1 / span 99;
  }
  .bt-plant-spotlight__grid > .shopify-block:has(.bt-spotlight-media) .bt-spotlight-media {
    margin: 0;
  }
  @media (max-width: 749px) {
    .bt-plant-spotlight__grid { grid-template-columns: 1fr; }
    .bt-plant-spotlight__grid > .shopify-block,
    .bt-plant-spotlight__grid > .shopify-block:has(.bt-spotlight-media) {
      grid-column: 1;
      grid-row: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.plant_spotlight.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.plant_spotlight.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.plant_spotlight.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.plant_spotlight.name",
    "blocks": [
      { "type": "eyebrow" },
      { "type": "heading" },
      { "type": "spotlight-media" },
      { "type": "text" },
      { "type": "care-table" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "editorial-quote" },
      { "type": "button-group" }
    ]
  }]
}
{% endschema %}
