{% comment %}
  sections/plant-spotlight.liquid — Plant spotlight (flagship section)
  Editorial plant focus: large image + specimen tag + care table + field notes.
  Assembles blocks: eyebrow + heading + spotlight-media + care-table +
  editorial-quote + button-group.
  ★ The "Awwwards-level" editorial plant page aesthetic.
  All-original. Zero Dawn code.
{% endcomment %}
<section class="bt-section bt-plant-spotlight" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bt-container">
    <div class="bt-plant-spotlight__grid">
      <div class="bt-plant-spotlight__media bt-reveal--scale">
        {%- for block in section.blocks -%}
          {%- if block.type == 'spotlight-media' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="bt-plant-spotlight__frame bt-specimen-frame{% if block.settings.show_texture %} bt-texture bt-texture--warm{% endif %}">
                  {{ block.settings.image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1000',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: block.settings.image.alt
                  }}
                </div>
              {%- else -%}
                <div class="bt-plant-spotlight__frame bt-specimen-frame bt-texture bt-texture--warm bt-plant-spotlight__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'Plant specimen' }}
                </div>
              {%- endif -%}
              {%- if block.settings.label != blank -%}
                <div class="bt-specimen-label" aria-hidden="true">
                  {{ block.settings.label | escape }}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      <div class="bt-plant-spotlight__content bt-reveal--right">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'eyebrow' -%}
              <p class="bt-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
            {%- when 'heading' -%}
              <h2 class="bt-plant-spotlight__heading" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</h2>
            {%- when 'text' -%}
              <div class="bt-plant-spotlight__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- when 'care-table' -%}
              <div class="bt-plant-spotlight__care" {{ block.shopify_attributes }}>
                {%- if block.settings.title != blank -%}
                  <h3 class="bt-eyebrow">{{ block.settings.title }}</h3>
                {%- endif -%}
                <dl class="bt-plant-spotlight__care-list">
                  {%- for child in section.blocks -%}
                    {%- if child.type == 'care-row' -%}
                      {%- liquid
                        assign icon = child.settings.icon | default: 'light'
                        assign label = child.settings.label | default: ''
                        assign value = child.settings.value | default: ''
                        assign level = child.settings.level | default: 0 | plus: 0
                      -%}
                      <div class="bt-plant-spotlight__care-row" {{ child.shopify_attributes }}>
                        <dt>
                          <span class="bt-plant-spotlight__care-icon" aria-hidden="true">
                            {%- case icon -%}
                              {%- when 'light' -%}
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="3.5" stroke="currentColor" stroke-width="1.2"/><path d="M9 1v2M9 15v2M1 9h2M15 9h2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                              {%- when 'water' -%}
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M9 2C6 6 4 9 4 11.5a5 5 0 0010 0C14 9 12 6 9 2z" stroke="currentColor" stroke-width="1.2"/></svg>
                              {%- when 'humidity' -%}
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M4 9a5 5 0 0010 0c0-2.5-5-6.5-5-6.5S4 6.5 4 9z" stroke="currentColor" stroke-width="1.2"/></svg>
                              {%- when 'size' -%}
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><path d="M2 2h5v5M16 2l-5.5 5.5M16 16h-5v-5M2 16l5.5-5.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                              {%- when 'toxicity' -%}
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.2"/><path d="M9 5v4.5M9 13v.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
                              {%- else -%}
                                <svg width="18" height="18" viewBox="0 0 18 18" fill="none"><circle cx="9" cy="9" r="7" stroke="currentColor" stroke-width="1.2"/></svg>
                            {%- endcase -%}
                          </span>
                          {{ label }}
                        </dt>
                        <dd>
                          {{ value }}
                          {%- if child.settings.show_meter and level > 0 -%}
                            <span class="bt-plant-spotlight__meter" aria-hidden="true">
                              {%- for i in (1..3) -%}
                                <span class="bt-plant-spotlight__dot{% if i <= level %} is-on{% endif %}"></span>
                              {%- endfor -%}
                            </span>
                          {%- endif -%}
                        </dd>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                </dl>
              </div>
            {%- when 'editorial-quote' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'field-note',
                  text: block.settings.quote,
                  source: block.settings.attribution,
                  show_icon: true
                %}
              </div>
            {%- when 'button-group' -%}
              <a href="{{ block.settings.link | default: '#' }}" class="bt-btn bt-btn--{{ block.settings.style | default: 'primary' }}" {{ block.shopify_attributes }}>
                {{ block.settings.label | escape }}
              </a>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .bt-plant-spotlight__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--bt-space-xl);
    align-items: start;
  }
  .bt-plant-spotlight__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--bt-color-surface);
    border-radius: var(--bt-radius-card);
  }
  .bt-plant-spotlight__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: inherit;
  }
  .bt-plant-spotlight__media { position: relative; }
  .bt-plant-spotlight__media .bt-specimen-label {
    position: absolute;
    bottom: 12px;
    left: 12px;
    z-index: 2;
    background: var(--bt-color-bg);
    border: 1px solid var(--bt-color-border-medium);
  }
  .bt-plant-spotlight__content {
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-md);
    padding: var(--bt-space-md) 0;
    position: sticky;
    top: 100px;
  }
  .bt-plant-spotlight__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    margin: 0;
    font-variant-numeric: oldstyle-nums;
  }
  .bt-plant-spotlight__text {
    font-size: var(--bt-fs-body);
    line-height: var(--bt-lh-body);
    color: var(--bt-color-text-muted);
  }
  .bt-plant-spotlight__care-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .bt-plant-spotlight__care-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--bt-space-2xs) 0;
    border-bottom: 1px solid var(--bt-color-border-light);
    font-size: var(--bt-fs-body-sm);
  }
  .bt-plant-spotlight__care-row:last-child { border-bottom: none; }
  .bt-plant-spotlight__care-row dt {
    display: flex;
    align-items: center;
    gap: var(--bt-space-2xs);
    font-weight: 500;
    color: var(--bt-color-text-muted);
  }
  .bt-plant-spotlight__care-row dd {
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text);
    display: flex;
    align-items: center;
    gap: var(--bt-space-2xs);
    margin: 0;
  }
  .bt-plant-spotlight__care-icon {
    color: var(--bt-color-secondary);
    display: flex;
  }
  .bt-plant-spotlight__meter {
    display: inline-flex;
    gap: 3px;
  }
  .bt-plant-spotlight__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bt-color-border-light);
  }
  .bt-plant-spotlight__dot.is-on { background: var(--bt-color-primary); }
  .bt-plant-spotlight__content .bt-field-note {
    margin-top: var(--bt-space-xs);
  }
  @media (max-width: 749px) {
    .bt-plant-spotlight__grid { grid-template-columns: 1fr; }
    .bt-plant-spotlight__content { position: static; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.plant_spotlight.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.plant_spotlight.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.plant_spotlight.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.plant_spotlight.name",
    "blocks": [
      { "type": "eyebrow" },
      { "type": "heading" },
      { "type": "spotlight-media" },
      { "type": "text" },
      { "type": "care-table" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "care-row" },
      { "type": "editorial-quote" },
      { "type": "button-group" }
    ]
  }]
}
{% endschema %}
