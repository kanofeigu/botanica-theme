{% comment %}
  sections/featured-collection.liquid — Featured collection product grid
  Displays up to 12 products from a collection. Uses product card snippet.
  All-original. Zero Dawn code.
{% endcomment %}
{%- liquid
  assign collection = section.settings.collection
  assign heading = section.settings.heading
  assign products_to_show = section.settings.products_to_show | default: 4
  assign columns = section.settings.columns_desktop | default: 3
  assign layout = section.settings.layout | default: 'editorial'
-%}
{%- if collection != blank -%}
  <section class="bt-section bt-featured-collection bt-dappled-light color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
    <div class="bt-container">
      {%- if heading != blank -%}
        <div class="bt-featured-collection__header">
          <h2 class="bt-featured-collection__heading">{{ heading | escape }}</h2>
          <a href="{{ collection.url }}" class="bt-featured-collection__view-all">
            {{ 'collections.general.view_all' | t }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15m-6-7 7 7-7 7"/></svg>
          </a>
        </div>
      {%- endif -%}
      <div class="bt-featured-collection__grid bt-featured-collection__grid--{{ columns }}-col bt-featured-collection__grid--{{ layout }}{% if section.settings.mobile_swipe %} bt-featured-collection__grid--swipe-mobile{% endif %}"{% if section.settings.enable_reveal %} data-bt-reveal-stagger{% endif %}>
        {%- for product in collection.products limit: products_to_show -%}
          {%- if forloop.index <= 4 -%}
            <div{% if forloop.first %} class="bt-featured-collection__feature"{% endif %}{% if section.settings.enable_reveal %} data-bt-reveal{% endif %}>{%- render 'card-product', product: product, show_secondary_image: true, show_vendor: false, image_ratio: settings.card_image_aspect_ratio, show_sale_badge: settings.show_sale_badge, show_sold_out_badge: settings.show_sold_out_badge, show_care_badge: settings.show_care_badge, show_light_badge: settings.show_light_badge, specimen_frame: section.settings.enable_specimen_frame, loading: 'eager', fetchpriority: 'high' -%}</div>
          {%- else -%}
            <div{% if section.settings.enable_reveal %} data-bt-reveal{% endif %}>{%- render 'card-product', product: product, show_secondary_image: true, show_vendor: false, image_ratio: settings.card_image_aspect_ratio, show_sale_badge: settings.show_sale_badge, show_sold_out_badge: settings.show_sold_out_badge, show_care_badge: settings.show_care_badge, show_light_badge: settings.show_light_badge, specimen_frame: section.settings.enable_specimen_frame -%}</div>
          {%- endif -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="bt-card bt-card--placeholder{% if forloop.first %} bt-featured-collection__feature{% endif %}">
              <div class="bt-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'bt-card__placeholder' }}</div>
              <div class="bt-card__body">
                <h3 class="bt-card__title">{{ 'products.product.title' | t }}</h3>
                <div class="bt-card__price">{{ 1999 | money }}</div>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .bt-featured-collection__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--bt-space-lg);
  }
  .bt-featured-collection__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    margin: 0;
  }
  /* View all: quiet text link with a sliding arrow — no button box. */
  .bt-featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--bt-space-2xs);
    font-family: var(--bt-font-body);
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.02em;
    color: var(--bt-color-primary);
    text-decoration: none;
  }
  .bt-featured-collection__view-all svg {
    width: 15px;
    height: 15px;
    transition: transform var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-featured-collection__view-all:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  .bt-featured-collection__view-all:hover svg {
    transform: translateX(4px);
  }
  .bt-featured-collection__grid {
    display: grid;
    gap: var(--bt-grid-gap);
  }
  /* Cards render inside a wrapper div (reveal-stagger hooks) — keep
     equal-height stretching identical to bare grid-item cards. */
  .bt-featured-collection__grid > div {
    display: flex;
    flex-direction: column;
  }
  .bt-featured-collection__grid > div > .bt-card {
    flex: 1;
  }
  .bt-featured-collection__grid--2-col { grid-template-columns: repeat(2, 1fr); }
  .bt-featured-collection__grid--3-col { grid-template-columns: repeat(3, 1fr); }
  .bt-featured-collection__grid--4-col { grid-template-columns: repeat(4, 1fr); }

  /* ── Editorial layout (default): the first product becomes an oversized
     feature card spanning 2×2 cells of the uniform grid — asymmetric
     magazine spread. Bigger title/price match the scale. ── */
  @media (min-width: 750px) {
    .bt-featured-collection__grid--editorial .bt-featured-collection__feature {
      grid-column: span 2;
      grid-row: span 2;
    }
    .bt-featured-collection__grid--editorial .bt-featured-collection__feature .bt-card__body {
      padding: var(--bt-space-md);
      gap: var(--bt-space-2xs);
    }
    .bt-featured-collection__grid--editorial .bt-featured-collection__feature .bt-card__title {
      font-size: var(--bt-fs-h3);
    }
    .bt-featured-collection__grid--editorial .bt-featured-collection__feature .bt-card__price {
      font-size: var(--bt-fs-body);
    }
  }
  @media (max-width: 749px) {
    /* Mobile default: a fixed two-up grid with tightened gutters, whatever
       the desktop column count. */
    .bt-featured-collection__grid--2-col,
    .bt-featured-collection__grid--3-col,
    .bt-featured-collection__grid--4-col { grid-template-columns: repeat(2, 1fr); }
    .bt-featured-collection__grid { gap: var(--bt-space-xs); }

    /* Editorial on mobile: the feature card takes the full row of the
       two-up grid; in swipe mode it becomes a wider leading slide. */
    .bt-featured-collection__grid--editorial .bt-featured-collection__feature {
      grid-column: 1 / -1;
    }
    .bt-featured-collection__grid--editorial .bt-featured-collection__feature .bt-card__title {
      font-size: var(--bt-fs-h3);
    }

    /* Mobile swipe (opt-in): cards become a snap-scrolling row, second
       card peeks in */
    .bt-featured-collection__grid--swipe-mobile {
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: var(--bt-space-sm);
      padding-bottom: var(--bt-space-2xs);
      scrollbar-width: none;
    }
    .bt-featured-collection__grid--swipe-mobile::-webkit-scrollbar {
      display: none;
    }
    .bt-featured-collection__grid--swipe-mobile > * {
      flex: 0 0 68%;
      scroll-snap-align: start;
    }
    .bt-featured-collection__grid--swipe-mobile > .bt-featured-collection__feature {
      flex-basis: 84%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "options": [
        { "value": "editorial", "label": "t:sections.featured_collection.settings.layout.options__1.label" },
        { "value": "uniform", "label": "t:sections.featured_collection.settings.layout.options__2.label" }
      ],
      "default": "editorial"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.featured_collection.settings.heading.label",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.products_to_show.label"
    },
    {
      "type": "checkbox",
      "id": "mobile_swipe",
      "label": "t:sections.featured_collection.settings.mobile_swipe.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_specimen_frame",
      "label": "t:sections.featured_collection.settings.enable_specimen_frame.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_reveal",
      "label": "t:sections.all.enable_reveal.label",
      "info": "t:sections.all.enable_reveal.info",
      "default": false
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.featured_collection.settings.columns_desktop.label",
      "options": [
        { "value": "2", "label": "t:sections.featured_collection.settings.columns_desktop.options__1.label" },
        { "value": "3", "label": "t:sections.featured_collection.settings.columns_desktop.options__2.label" },
        { "value": "4", "label": "t:sections.featured_collection.settings.columns_desktop.options__3.label" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.featured_collection.settings.padding_bottom.label"
    }
  ],
  "presets": [{ "name": "t:sections.featured_collection.name" }]
}
{% endschema %}
