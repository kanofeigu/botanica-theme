{% comment %} main-password-content.liquid — Password page login form. Original. {% endcomment %}
<div class="bt-section bt-password-content" {{ section.shopify_attributes }}>
  <div class="bt-container" style="max-width: 440px; text-align: center;">
    <h1 class="bt-h1">{{ 'general.password_page.login_form_heading' | t }}</h1>
    {%- form 'storefront_password', class: 'bt-stack-md' -%}
      <label for="Password" class="bt-sr-only">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" name="password" id="Password" class="bt-input" placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}" autofocus aria-required="true" required style="text-align: center;">
      <button type="submit" name="commit" class="bt-btn bt-btn--primary bt-btn--lg bt-btn--block">{{ 'general.password_page.login_form_submit' | t }}</button>
      {%- if form.errors -%}<p class="bt-form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .bt-password-content { padding-block: var(--bt-space-xl); min-height: 60vh; display: flex; align-items: center; }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_password_content.name", "presets": [{ "name": "t:sections.main_password_content.name" }] }
{% endschema %}
