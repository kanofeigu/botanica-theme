{% comment %}
  sections/testimonials.liquid — Customer testimonials grid
  Uses testimonial blocks in a responsive 1-3 column grid.
  All-original. Zero Dawn code.
{% endcomment %}
<section class="bt-section bt-testimonials" {{ section.shopify_attributes }}>
  <div class="bt-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="bt-testimonials__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <div class="bt-testimonials__grid bt-grid bt-grid--{{ section.settings.columns_desktop | default: 3 }}-col">
      {% content_for "blocks" %}
    </div>
  </div>
</section>

{% stylesheet %}
  .bt-testimonials__heading {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
    text-align: center;
    margin: 0 0 var(--bt-space-lg);
  }
  .bt-testimonials__grid {
    display: grid;
    gap: var(--bt-grid-gap);
    align-items: start;
  }
  .bt-grid--1-col { grid-template-columns: 1fr; max-width: 600px; margin-inline: auto; }
  .bt-grid--2-col { grid-template-columns: repeat(2, 1fr); }
  .bt-grid--3-col { grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 749px) {
    .bt-grid--2-col, .bt-grid--3-col { grid-template-columns: 1fr; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.testimonials.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.testimonials.settings.heading.label",
      "default": "What plant parents say"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:sections.testimonials.settings.columns_desktop.label",
      "options": [
        { "value": "1", "label": "t:sections.testimonials.settings.columns_desktop.options__1.label" },
        { "value": "2", "label": "t:sections.testimonials.settings.columns_desktop.options__2.label" },
        { "value": "3", "label": "t:sections.testimonials.settings.columns_desktop.options__3.label" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.testimonials.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 100, "step": 4, "default": 40, "unit": "px",
      "label": "t:sections.testimonials.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.testimonials.name",
    "blocks": [
      { "type": "testimonial" },
      { "type": "testimonial" },
      { "type": "testimonial" }
    ]
  }]
}
{% endschema %}
