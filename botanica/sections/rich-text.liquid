{% comment %}
  sections/rich-text.liquid — Rich text section
  Centered editorial text area. Uses text/heading/eyebrow blocks.
  All-original. Zero Dawn code.
{% endcomment %}
<section class="bt-section bt-rich-text" {{ section.shopify_attributes }} style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="bt-container bt-rich-text__inner">
    {% content_for "blocks" %}
  </div>
</section>

{% stylesheet %}
  .bt-rich-text__inner {
    max-width: 720px;
    text-align: var(--bt-rich-text-align, center);
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "t:sections.rich_text.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 40,
      "unit": "px",
      "label": "t:sections.rich_text.settings.padding_bottom.label"
    }
  ],
  "presets": [{
    "name": "t:sections.rich_text.name",
    "blocks": [
      { "type": "eyebrow" },
      { "type": "heading" },
      { "type": "text" },
      { "type": "button-group" }
    ]
  }]
}
{% endschema %}
