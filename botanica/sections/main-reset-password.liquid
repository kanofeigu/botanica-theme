{% comment %} main-reset-password.liquid — Password reset page. Original. Zero Dawn code. {% endcomment %}
<div class="bt-section bt-reset-password color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bt-container" style="max-width: 480px;">
    <h1 class="bt-h1 bt-text-center">{{ 'customer.reset_password.title' | t }}</h1>
    {%- form 'reset_customer_password', class: 'bt-stack-md' -%}
      <div><label for="ResetPassword" class="bt-label">{{ 'customer.reset_password.password' | t }}</label><input type="password" id="ResetPassword" name="customer[password]" class="bt-input" required autocomplete="new-password"></div>
      <div><label for="PasswordConfirmation" class="bt-label">{{ 'customer.reset_password.password_confirm' | t }}</label><input type="password" id="PasswordConfirmation" name="customer[password_confirmation]" class="bt-input" required></div>
      <button type="submit" class="bt-btn bt-btn--primary bt-btn--lg bt-btn--block">{{ 'customer.reset_password.submit' | t }}</button>
      {%- if form.errors -%}<div class="bt-form-error bt-text-center" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .bt-reset-password form { margin-top: var(--bt-space-lg); }
{% endstylesheet %}

{% schema %}
{ "name": "t:sections.main_reset_password.name", "settings": [{ "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" }], "presets": [{ "name": "t:sections.main_reset_password.name" }] }
{% endschema %}
