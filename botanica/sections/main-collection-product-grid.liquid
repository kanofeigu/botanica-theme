  /* ════════════════════════════════════════════
     SORT — custom popover dropdown
     ════════════════════════════════════════════ */
  .bt-sort { position: relative; }
  /* Soft-fill pill trigger — no outline box */
  .bt-sort__button {
    display: inline-flex;
    align-items: center;
    gap: var(--bt-space-2xs);
    padding: 0.5em 1em;
    font-family: var(--bt-font-body);
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text);
    background: var(--bt-color-surface-hover);
    border: none;
    border-radius: var(--bt-radius-pill);
    cursor: pointer;
    transition: background var(--bt-duration-fast) var(--bt-ease-out),
                color var(--bt-duration-fast) var(--bt-ease-out);
    -webkit-appearance: none;
    appearance: none;
  }
  .bt-sort__button:hover {
    background: var(--bt-color-primary-tint);
    color: var(--bt-color-primary);
  }
  .bt-sort__button:focus-visible {
    outline: var(--bt-focus-ring-width) solid var(--bt-color-focus-ring);
    outline-offset: 2px;
  }
  .bt-sort__button[aria-expanded="true"] {
    background: var(--bt-color-primary-tint);
    color: var(--bt-color-primary);
  }
  .bt-sort__label { display: inline-flex; align-items: baseline; gap: 0.35em; }
  .bt-sort__label-prefix {
    font-size: var(--bt-fs-body-xs);
    color: var(--bt-color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: var(--bt-fw-medium);
  }
  .bt-sort__label-value {
    font-weight: var(--bt-fw-semibold);
  }
  .bt-sort__chevron {
    transition: transform var(--bt-duration-fast) var(--bt-ease-out);
    flex-shrink: 0;
    opacity: 0.6;
  }
  .bt-sort__button[aria-expanded="true"] .bt-sort__chevron {
    transform: rotate(180deg);
  }

  .bt-sort__menu {
    /* Positioning handled by JS (portal to body + fixed coords) */
    z-index: 1000;
    min-width: 200px;
    padding: 4px;
    background: var(--bt-color-surface-raised, var(--bt-color-surface));
    border-radius: var(--bt-radius-md);
    box-shadow: 0 8px 28px rgba(var(--bt-color-text-rgb), 0.12);
    display: flex;
    flex-direction: column;
    gap: 1px;
    /* hidden state (before .is-open) */
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    transform-origin: top center;
    pointer-events: none;
    transition: opacity 160ms var(--bt-ease-out), transform 160ms var(--bt-ease-out);
  }
  .bt-sort__menu.is-open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  .bt-sort__option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bt-space-2xs);
    padding: 0.55em 0.75em;
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text);
    text-decoration: none;
    border-radius: var(--bt-radius-sm);
    transition: background var(--bt-duration-fast), color var(--bt-duration-fast);
  }
  .bt-sort__option:hover {
    background: var(--bt-color-primary-tint);
    color: var(--bt-color-primary);
  }
  .bt-sort__option:focus-visible {
    outline: var(--bt-focus-ring-width) solid var(--bt-color-focus-ring);
    outline-offset: -2px;
  }
  .bt-sort__check {
    opacity: 0;
    color: var(--bt-color-primary);
    flex-shrink: 0;
    transition: opacity var(--bt-duration-fast);
  }
  .bt-sort__option.is-selected {
    background: var(--bt-color-primary-tint);
    color: var(--bt-color-primary);
    font-weight: var(--bt-fw-semibold);
  }
  .bt-sort__option.is-selected .bt-sort__check {
    opacity: 1;
  }

  /* ════════════════════════════════════════════
     LAYOUT
     ════════════════════════════════════════════ */
  .bt-collection-grid__layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--bt-space-xl);
    align-items: start;
    overflow-x: clip; /* prevent any horizontal scrollbar from child overflow */
    transition: grid-template-columns var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-collection-grid__main { min-width: 0; }

  /* Desktop sidebar collapse (toolbar filter toggle) */
  .bt-collection-grid.is-sidebar-collapsed .bt-collection-grid__layout {
    grid-template-columns: 1fr;
  }
  .bt-collection-grid.is-sidebar-collapsed .bt-collection-grid__sidebar {
    display: none;
  }

  /* ════════════════════════════════════════════
     SIDEBAR
     ════════════════════════════════════════════ */
  .bt-collection-grid__sidebar {
    position: sticky;
    top: calc(var(--bt-space-md) + 120px); /* below sticky toolbar */
    /* No max-height/overflow — let popover menus overflow freely,
       and avoid a horizontal scrollbar inside the sidebar. */
    padding-right: 2px;
  }
  .bt-collection-grid__sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--bt-space-sm);
    padding-bottom: var(--bt-space-xs);
    border-bottom: 1px solid var(--bt-color-border-light);
  }
  .bt-collection-grid__sidebar-title {
    margin: 0;
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-body);
    font-weight: var(--bt-fw-normal);
  }
  .bt-collection-grid__sidebar-clear {
    font-size: 0.7rem;
    font-weight: var(--bt-fw-semibold);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--bt-color-text-muted);
    text-decoration: none;
    padding: 2px 8px;
    border-radius: var(--bt-radius-pill);
    transition: all var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-collection-grid__sidebar-clear:hover {
    color: var(--bt-color-secondary);
    background: var(--bt-color-secondary-tint);
  }

  /* Mobile drawer footer — hidden on desktop */
  .bt-collection-grid__sidebar-footer { display: none; }

  /* ── Filter group (animated details) ── */
  .bt-filter-group {
    border-bottom: 1px solid var(--bt-color-border-light);
    padding-block: var(--bt-space-xs);
  }
  .bt-filter-group__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text);
    list-style: none;
    user-select: none;
    padding-block: 4px;
    transition: color var(--bt-duration-fast);
  }
  .bt-filter-group__summary:hover { color: var(--bt-color-primary); }
  .bt-filter-group__summary::-webkit-details-marker { display: none; }
  .bt-filter-group__summary::-moz-list-marker { display: none; }
  .bt-filter-group__summary-right {
    display: inline-flex;
    align-items: center;
    gap: var(--bt-space-2xs);
  }
  .bt-filter-group__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    background: var(--bt-color-primary);
    color: var(--bt-color-primary-contrast);
    border-radius: var(--bt-radius-pill);
    font-size: 0.65rem;
    font-weight: var(--bt-fw-bold);
  }
  .bt-filter-group__chevron {
    transition: transform var(--bt-duration-base) var(--bt-ease-out);
    flex-shrink: 0;
    opacity: 0.5;
  }
  details[open] > .bt-filter-group__summary .bt-filter-group__chevron {
    transform: rotate(180deg);
  }

  /* Animated content wrapper */
  .bt-filter-group__content {
    overflow: hidden;
    transition: height 220ms var(--bt-ease-out), opacity 200ms var(--bt-ease-out);
  }
  details:not([open]) .bt-filter-group__content {
    height: 0;
    opacity: 0;
  }
  details[open] .bt-filter-group__content {
    opacity: 1;
  }

  .bt-filter-group__values {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--bt-space-xs);
    padding-bottom: var(--bt-space-3xs);
  }

  /* ── Filter checkbox: rounded box, deep-green fill + white check ── */
  .bt-filter-checkbox {
    display: flex;
    align-items: center;
    gap: var(--bt-space-2xs);
    cursor: pointer;
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text);
    padding: 3px 0;
    user-select: none;
    transition: color var(--bt-duration-fast);
  }
  .bt-filter-checkbox:hover { color: var(--bt-color-primary); }
  .bt-filter-checkbox.is-disabled { cursor: not-allowed; opacity: 0.45; }
  .bt-filter-checkbox.is-disabled:hover { color: var(--bt-color-text); }
  .bt-filter-checkbox input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
  }
  .bt-filter-checkbox__indicator {
    width: 18px;
    height: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--bt-color-border-medium);
    border-radius: var(--bt-radius-sm);
    flex-shrink: 0;
    background: var(--bt-color-bg);
    transition: all var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-filter-checkbox:hover .bt-filter-checkbox__indicator {
    border-color: var(--bt-color-primary);
  }
  .bt-filter-checkbox__indicator svg {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity var(--bt-duration-fast), transform var(--bt-duration-base) var(--bt-ease-out);
    color: var(--bt-color-primary-contrast);
  }
  .bt-filter-checkbox input:checked + .bt-filter-checkbox__indicator {
    background: var(--bt-color-primary);
    border-color: var(--bt-color-primary);
  }
  .bt-filter-checkbox input:checked + .bt-filter-checkbox__indicator svg {
    opacity: 1;
    transform: scale(1);
  }
  .bt-filter-checkbox input:focus-visible + .bt-filter-checkbox__indicator {
    outline: var(--bt-focus-ring-width) solid var(--bt-color-focus-ring);
    outline-offset: 2px;
  }
  .bt-filter-checkbox__label { flex: 1; }
  .bt-filter-checkbox__count {
    font-size: var(--bt-fs-body-xs);
    color: var(--bt-color-text-muted);
    flex-shrink: 0;
    font-variant-numeric: oldstyle-nums;
  }

  /* ── Availability as a toggle switch ── */
  .bt-filter-checkbox--switch .bt-filter-checkbox__indicator {
    position: relative;
    width: 34px;
    height: 20px;
    border: none;
    border-radius: var(--bt-radius-pill);
    background: var(--bt-color-border-medium);
  }
  .bt-filter-checkbox--switch .bt-filter-checkbox__indicator svg { display: none; }
  .bt-filter-checkbox--switch .bt-filter-checkbox__indicator::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--bt-color-bg);
    box-shadow: var(--bt-shadow-sm);
    transition: transform var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-filter-checkbox--switch:hover .bt-filter-checkbox__indicator {
    background: var(--bt-color-text-muted);
  }
  .bt-filter-checkbox--switch input:checked + .bt-filter-checkbox__indicator {
    background: var(--bt-color-primary);
  }
  .bt-filter-checkbox--switch input:checked + .bt-filter-checkbox__indicator::after {
    transform: translateX(14px);
  }

  /* Price range — soft-fill from/to inputs */
  .bt-price-range {
    display: flex;
    align-items: flex-end;
    gap: var(--bt-space-xs);
    margin-top: var(--bt-space-xs);
  }
  .bt-price-range__field {
    flex: 1;
    min-width: 0;
  }
  .bt-price-range__label {
    display: block;
    font-size: var(--bt-fs-body-xs);
    color: var(--bt-color-text-muted);
    margin-bottom: 4px;
  }
  .bt-price-range__input-wrap {
    display: flex;
    align-items: center;
    /* Soft-fill field, no outline */
    background: var(--bt-color-surface-hover);
    border: var(--bt-border-width) var(--bt-border-style) transparent;
    border-radius: var(--bt-radius-sm);
    overflow: hidden;
    transition: border-color var(--bt-duration-fast) var(--bt-ease-out),
                box-shadow var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-price-range__input-wrap:focus-within {
    border-color: var(--bt-color-primary);
    box-shadow: 0 0 0 3px var(--bt-color-primary-tint);
  }
  .bt-price-range__currency {
    padding: 0 8px;
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
    background: transparent;
    user-select: none;
  }
  .bt-price-range__input {
    width: 100%;
    padding: 8px 10px;
    border: 0;
    outline: none;
    background: transparent;
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text);
    -moz-appearance: textfield;
  }
  .bt-price-range__input:focus,
  .bt-price-range__input:focus-visible {
    outline: none;
  }
  .bt-price-range__input::-webkit-inner-spin-button,
  .bt-price-range__input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .bt-price-range__sep {
    padding-bottom: 8px;
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
    flex-shrink: 0;
  }

  /* ════════════════════════════════════════════
     EMPTY STATE
     ════════════════════════════════════════════ */
  .bt-collection-grid__empty {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--bt-space-sm);
    padding-block: var(--bt-space-3xl);
    text-align: center;
    animation: bt-reveal-fade var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-collection-grid__empty-title {
    margin: 0;
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h2);
    font-weight: var(--bt-fw-normal);
    color: var(--bt-color-text);
  }
  .bt-collection-grid__empty-text {
    margin: 0 0 var(--bt-space-sm);
    color: var(--bt-color-text-muted);
    font-size: var(--bt-fs-body);
    max-width: 42ch;
  }

  /* ════════════════════════════════════════════
     LOAD MORE + numbered-pagination fallback
     ════════════════════════════════════════════ */
  .bt-collection-grid__loadmore {
    margin-top: var(--bt-space-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--bt-space-xs);
  }
  .bt-collection-grid__showing {
    margin: 0;
    font-size: var(--bt-fs-body-xs);
    color: var(--bt-color-text-muted);
    letter-spacing: 0.02em;
    font-variant-numeric: oldstyle-nums;
  }
  /* Gold progress hairline under the count */
  .bt-collection-grid__progress {
    width: min(220px, 60%);
    height: 2px;
    border-radius: var(--bt-radius-pill);
    background: var(--bt-color-border-light);
    overflow: hidden;
  }
  .bt-collection-grid__progress-bar {
    display: block;
    height: 100%;
    background: var(--bt-color-secondary);
    border-radius: inherit;
    transition: width var(--bt-duration-slow, 400ms) var(--bt-ease-out);
  }
  .bt-collection-grid__pagination {
    margin-top: var(--bt-space-xl);
    display: flex;
    justify-content: center;
  }
  .bt-collection-grid__pagination[hidden] { display: none; }

  /* Appended cards fade up like the AJAX reveal */
  .bt-loadmore-item {
    animation: bt-ajax-card 380ms var(--bt-ease-out) both;
  }

  /* ════════════════════════════════════════════
     RESPONSIVE
     ════════════════════════════════════════════ */
  @media (max-width: 989px) {
    .bt-collection-grid__layout {
      grid-template-columns: 1fr;
    }
    .bt-collection-grid__sidebar {
      position: fixed;
      top: 0;
      left: 0;
      max-height: none;
      width: min(340px, 88vw);
      height: 100vh;
      height: 100dvh;
      z-index: 100;
      background: var(--bt-color-bg);
      padding: var(--bt-space-lg) var(--bt-space-md) var(--bt-space-md);
      transform: translateX(-100%);
      transition: transform var(--bt-duration-base) var(--bt-ease-out);
      overflow-y: auto;
      overflow-x: hidden;
      box-shadow: 0 0 40px rgba(var(--bt-color-text-rgb), 0.2);
    }
    .bt-collection-grid__sidebar.is-open {
      transform: translateX(0);
    }
    /* Sticky "Show N results" bar pinned to the drawer bottom */
    .bt-collection-grid__sidebar-footer {
      display: block;
      position: sticky;
      bottom: calc(-1 * var(--bt-space-md));
      margin: var(--bt-space-md) calc(-1 * var(--bt-space-md)) calc(-1 * var(--bt-space-md));
      padding: var(--bt-space-sm) var(--bt-space-md);
      background: var(--bt-color-bg);
      border-top: 1px solid var(--bt-color-border-light);
    }
    body.bt-filter-open::before {
      content: '';
      position: fixed;
      inset: 0;
      background: rgba(var(--bt-color-text-rgb), 0.4);
      z-index: 99;
    }
  }

  @media (max-width: 749px) {
    .bt-collection-grid__toolbar {
      top: 64px;
      gap: var(--bt-space-xs);
    }
    .bt-collection-grid__toolbar-left {
      flex: 1;
      min-width: 0;
    }
    /* Save horizontal room: drop the "SORT BY:" prefix on phones */
    .bt-sort__label-prefix { display: none; }
    .bt-sort__button { padding-inline: 0.75em; }
    /* Mobile product grid: fixed two-up with tightened gutters. */
    .bt-collection-grid .bt-grid {
      gap: var(--bt-space-xs);
    }
  }

  /* Base grid collapses to one column below 480px — product grids stay
     two-up so cards keep a browsable catalogue rhythm on phones. */
  @media (max-width: 479px) {
    .bt-collection-grid .bt-grid--2,
    .bt-collection-grid .bt-grid--3,
    .bt-collection-grid .bt-grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ════════════════════════════════════════════
     AJAX TRANSITIONS — choreographed card swap.
     EXIT: old cards slide left + fade (fast, ease-in, 20ms stagger).
     ENTER: new cards slide in from the right + fade (ease-out, 45ms
     stagger, delay set inline by JS). The main area is height-locked
     by JS during the swap so the page never jumps (no CLS).
     Toolbar / sidebar stay still — only the product grid moves.
     ════════════════════════════════════════════ */
  .bt-collection-grid { position: relative; }
  /* Tighten the seam under the compact collection band */
  .bt-collection-grid.bt-section { padding-top: var(--bt-space-md); }
  .bt-collection-grid__main { position: relative; }

  /* EXIT — applied per card by JS (transition-delay carries the stagger) */
  .bt-collection-grid .bt-grid > *.bt-card-exit {
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 200ms ease-in, transform 200ms ease-in;
    pointer-events: none;
  }

  /* Spinner centered on the main grid area while fetching */
  body.bt-ajax-loading .bt-collection-grid__main::after {
    content: '';
    position: absolute;
    top: 40%; left: 50%;
    width: 32px; height: 32px;
    margin: -16px 0 0 -16px;
    border: 3px solid var(--bt-color-border-light);
    border-top-color: var(--bt-color-primary);
    border-radius: 50%;
    animation: bt-ajax-spin 0.7s linear infinite;
    z-index: 5;
  }
  @keyframes bt-ajax-spin { to { transform: rotate(360deg); } }

  /* ENTER — cards fade + slide from the right; JS sets animation-delay
     inline (45ms stagger, capped) so any page size is covered. */
  .bt-collection-grid.bt-ajax-in .bt-grid > * {
    animation: bt-card-enter 320ms var(--bt-ease-out) both;
  }
  @keyframes bt-card-enter {
    from { opacity: 0; transform: translateX(12px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* Load-more appended cards: light fade + rise */
  @keyframes bt-ajax-card {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-sort__menu,
    .bt-filter-group__content,
    .bt-filter-group__chevron,
    .bt-sort__chevron,
    .bt-collection-grid__sidebar,
    .bt-collection-grid__progress-bar,
    .bt-collection-grid .bt-grid > *.bt-card-exit {
      transition: none !important;
    }
    .bt-collection-grid__empty { animation: none; }
    body.bt-ajax-loading .bt-collection-grid__main::after { animation: none; }
    .bt-collection-grid.bt-ajax-in .bt-grid > *,
    .bt-loadmore-item { animation: none !important; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_collection_product_grid.name",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:sections.all.colors.label", "default": "scheme-1" },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12,
      "label": "t:sections.main_collection_product_grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.main_collection_product_grid.settings.columns_desktop.label"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection_product_grid.settings.enable_filtering.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection_product_grid.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "t:sections.main_collection_product_grid.settings.show_secondary_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:sections.main_collection_product_grid.settings.show_vendor.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_specimen_frame",
      "label": "t:sections.main_collection_product_grid.settings.enable_specimen_frame.label",
      "default": false
    }
  ],
  "presets": [{ "name": "t:sections.main_collection_product_grid.name" }]
}
{% endschema %}
