{% comment %}
  main-collection-product-grid.liquid — Sidebar-first filter experience.
  Sticky toolbar: filter toggle (desktop collapses sidebar / mobile opens
  drawer) + prominent count + soft-pill sort popover. Active filter chips
  row with per-value remove links + Clear all. Sidebar groups are animated
  accordions (first two open by default); Availability renders as a toggle
  switch; price uses soft-fill from/to inputs. Pagination is a "Load more"
  button powered by the Section Rendering API (numbered pagination stays as
  the no-JS fallback). Zero Dawn code.
{% endcomment %}

{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign columns_desktop = section.settings.columns_desktop | default: 3
  assign enable_sorting = section.settings.enable_sorting | default: true
  assign enable_filtering = section.settings.enable_filtering | default: true

  assign has_modern_filters = false
  if collection.filters.size > 0
    assign has_modern_filters = true
  endif

  assign has_active_filters = false
  for filter in collection.filters
    if filter.active_values.size > 0
      assign has_active_filters = true
    endif
    if filter.type == 'price_range'
      if filter.min_value.value > 0 or filter.max_value.value < filter.range_max
        assign has_active_filters = true
      endif
    endif
  endfor

  assign active_filter_count = 0
  for filter in collection.filters
    assign active_filter_count = active_filter_count | plus: filter.active_values.size
  endfor
-%}

<div class="bt-collection-grid bt-section color-{{ section.settings.color_scheme }}" {{ section.shopify_attributes }}>
  <div class="bt-container">

    {% comment %} ══════════════ STICKY TOOLBAR: filter toggle + count + sort ══════════════ {% endcomment %}
    <div class="bt-collection-grid__toolbar" data-toolbar>
      <div class="bt-collection-grid__toolbar-left">
        {%- if enable_filtering and has_modern_filters -%}
          <button type="button" class="bt-collection-grid__filter-trigger bt-interactive" data-filter-toggle aria-expanded="true" aria-label="{{ 'collections.filters.title' | t }}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
            <span>{{ 'collections.filters.title' | t }}</span>
            {%- if has_active_filters -%}<span class="bt-collection-grid__filter-count">{{ active_filter_count }}</span>{%- endif -%}
          </button>
        {%- endif -%}
        <p class="bt-collection-grid__count">
          <strong class="bt-collection-grid__count-number">{{ collection.products_count }}</strong>
          <span>{{ 'collections.collection.product_count' | t: count: collection.products_count | remove: collection.products_count | strip }}</span>
          {%- if has_active_filters -%}
            <span class="bt-collection-grid__filtered-badge">{{ active_filter_count }} {{ 'collections.filters.active' | t }}</span>
          {%- endif -%}
        </p>
      </div>

      {%- if enable_sorting -%}
        <div class="bt-sort" data-sort>
          <button type="button" class="bt-sort__button bt-interactive" data-sort-button aria-haspopup="listbox" aria-expanded="false" aria-label="{{ 'collections.sorting.title' | t }}">
            <span class="bt-sort__label">
              <span class="bt-sort__label-prefix">{{ 'collections.sorting.title' | t }}:</span>
              <span class="bt-sort__label-value" data-sort-current>
                {%- liquid
                  assign current_sort = collection.sort_by | default: collection.default_sort_by
                  assign current_sort_name = current_sort
                  for opt in collection.sort_options
                    if opt.value == current_sort
                      assign current_sort_name = opt.name
                    endif
                  endfor
                -%}
                {{ current_sort_name }}
              </span>
            </span>
            <svg class="bt-sort__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <div class="bt-sort__menu" data-sort-menu role="listbox" aria-label="{{ 'collections.sorting.title' | t }}" hidden>
            {%- for option in collection.sort_options -%}
              <a href="#" class="bt-sort__option{% if option.value == current_sort %} is-selected{% endif %}" role="option" {% if option.value == current_sort %}aria-selected="true"{% endif %} data-sort-option data-sort-value="{{ option.value }}">
                <span>{{ option.name }}</span>
                <svg class="bt-sort__check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {% comment %} ══════════════ ACTIVE FILTER CHIPS — one removable chip per applied value ══════════════ {% endcomment %}
    {%- if has_active_filters -%}
      <div class="bt-active-filters" role="list" aria-label="{{ 'accessibility.filters_active' | t }}">
        {%- for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a class="bt-active-filters__chip bt-interactive bt-press" role="listitem" href="{{ value.url_to_remove | escape }}" aria-label="{{ 'accessibility.remove_filter' | t: label: value.label }}">
              <span class="bt-active-filters__chip-label">{{ filter.label }}: {{ value.label }}</span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
            </a>
          {%- endfor -%}
          {%- if filter.type == 'price_range' and filter.min_value.value or filter.type == 'price_range' and filter.max_value.value -%}
            {%- liquid
              assign chip_price_lo = filter.min_value.value | money
              assign chip_price_hi = filter.max_value.value | money
            -%}
            <a class="bt-active-filters__chip bt-active-filters__chip--gold bt-interactive bt-press" role="listitem" href="{{ filter.url_to_remove | escape }}" aria-label="{{ 'accessibility.remove_filter' | t: label: filter.label }}">
              <span class="bt-active-filters__chip-label">
                {{ filter.label }}:
                {%- if filter.min_value.value and filter.max_value.value -%}
                  {{ 'collections.filters.price_between_html' | t: lo: chip_price_lo, hi: chip_price_hi }}
                {%- elsif filter.min_value.value -%}
                  {{ 'collections.filters.price_over_html' | t: amount: chip_price_lo }}
                {%- else -%}
                  {{ 'collections.filters.price_under_html' | t: amount: chip_price_hi }}
                {%- endif -%}
              </span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
            </a>
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}" class="bt-active-filters__clear bt-interactive bt-press">
          {{ 'collections.filters.clear_all' | t }}
        </a>
      </div>
    {%- endif -%}

    {% comment %} ══════════════ MAIN LAYOUT ══════════════ {% endcomment %}
    <div class="bt-collection-grid__layout">
      {% comment %} Sidebar — single source of truth for filters {% endcomment %}
      {%- if enable_filtering and has_modern_filters -%}
        <aside class="bt-collection-grid__sidebar" aria-label="{{ 'accessibility.filter' | t }}" data-sidebar>
          <div class="bt-collection-grid__sidebar-header">
            <h2 class="bt-collection-grid__sidebar-title">{{ 'collections.filters.title' | t }}</h2>
            {%- if has_active_filters -%}
              <a href="{{ collection.url }}?sort_by={{ collection.sort_by | default: collection.default_sort_by }}" class="bt-collection-grid__sidebar-clear bt-interactive bt-press">
                {{ 'collections.filters.clear_all' | t }}
              </a>
            {%- endif -%}
          </div>

          {%- for filter in collection.filters -%}
            {%- liquid
              assign group_open = false
              if forloop.index <= 2 or filter.active_values.size > 0
                assign group_open = true
              endif
              if filter.type == 'price_range'
                if filter.min_value.value or filter.max_value.value
                  assign group_open = true
                endif
              endif
              assign is_availability = false
              if filter.values.first.param_name contains 'availability'
                assign is_availability = true
              endif
            -%}
            <details class="bt-filter-group" {% if group_open %}open{% endif %} data-filter-group>
              <summary class="bt-filter-group__summary bt-interactive">
                <span>{{ filter.label }}</span>
                <span class="bt-filter-group__summary-right">
                  {%- if filter.active_values.size > 0 -%}<span class="bt-filter-group__badge">{{ filter.active_values.size }}</span>{%- endif -%}
                  <svg class="bt-filter-group__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </span>
              </summary>
              <div class="bt-filter-group__content" data-filter-content>
                <div class="bt-filter-group__values">
                  {%- case filter.type -%}
                    {%- when 'boolean' or 'list' -%}
                      {%- for value in filter.values -%}
                        <label class="bt-filter-checkbox bt-interactive{% if is_availability %} bt-filter-checkbox--switch{% endif %}{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            data-url-to-add="{{ value.url_to_add | escape }}"
                            data-url-to-remove="{{ value.url_to_remove | escape }}"
                          >
                          <span class="bt-filter-checkbox__indicator">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                          </span>
                          <span class="bt-filter-checkbox__label">{{ value.label }}</span>
                          <span class="bt-filter-checkbox__count">{{ value.count }}</span>
                        </label>
                      {%- endfor -%}
                    {%- when 'price_range' -%}
                      {%- liquid
                        assign max_price = filter.range_max | divided_by: 100.0 | ceil
                        assign min_value = filter.min_value.value | default: 0 | divided_by: 100.0
                        assign max_value = filter.max_value.value | default: filter.range_max | divided_by: 100.0
                        if min_value < 0
                          assign min_value = 0
                        endif
                      -%}
                      <div class="bt-price-range">
                        <div class="bt-price-range__field">
                          <label class="bt-price-range__label" for="Filter-Price-GTE">{{ 'collections.filters.from' | t }}</label>
                          <div class="bt-price-range__input-wrap">
                            <span class="bt-price-range__currency">{{ cart.currency.symbol }}</span>
                            <input
                              class="bt-price-range__input"
                              name="{{ filter.min_value.param_name }}"
                              id="Filter-Price-GTE"
                              value="{% if min_value > 0 %}{{ min_value | round }}{% endif %}"
                              type="number"
                              inputmode="decimal"
                              placeholder="0"
                              min="0"
                              max="{{ max_price }}"
                              data-price-min
                            >
                          </div>
                        </div>
                        <span class="bt-price-range__sep" aria-hidden="true">—</span>
                        <div class="bt-price-range__field">
                          <label class="bt-price-range__label" for="Filter-Price-LTE">{{ 'collections.filters.to' | t }}</label>
                          <div class="bt-price-range__input-wrap">
                            <span class="bt-price-range__currency">{{ cart.currency.symbol }}</span>
                            <input
                              class="bt-price-range__input"
                              name="{{ filter.max_value.param_name }}"
                              id="Filter-Price-LTE"
                              value="{% if max_value < filter.range_max %}{{ max_value | round }}{% endif %}"
                              type="number"
                              inputmode="decimal"
                              placeholder="{{ max_price }}"
                              min="0"
                              max="{{ max_price }}"
                              data-price-max
                            >
                          </div>
                        </div>
                      </div>
                  {%- endcase -%}
                </div>
              </div>
            </details>
          {%- endfor -%}

          {% content_for "blocks" %}

          {% comment %} Mobile drawer footer — sticky "Show N results" bar {% endcomment %}
          <div class="bt-collection-grid__sidebar-footer">
            <button type="button" class="bt-btn bt-btn--primary bt-btn--block bt-interactive bt-press" data-filter-close>
              {{ 'collections.filters.show_results' | t: count: collection.products_count }}
            </button>
          </div>
        </aside>
      {%- endif -%}

      {% comment %} Product grid {% endcomment %}
      <div class="bt-collection-grid__main">
        {%- paginate collection.products by products_per_page -%}
          {%- if collection.products.size > 0 -%}
            <div class="bt-grid bt-grid--{{ columns_desktop }}">
              {%- for product in collection.products -%}
                {%- if forloop.index <= 4 -%}
                  {% comment %} First row = LCP candidates: eager + high priority {% endcomment %}
                  {% render 'card-product', product: product, show_secondary_image: section.settings.show_secondary_image, show_vendor: section.settings.show_vendor, image_ratio: settings.card_image_aspect_ratio, show_sale_badge: settings.show_sale_badge, show_sold_out_badge: settings.show_sold_out_badge, show_care_badge: settings.show_care_badge, show_light_badge: settings.show_light_badge, specimen_frame: section.settings.enable_specimen_frame, loading: 'eager', fetchpriority: 'high' %}
                {%- else -%}
                  {% render 'card-product', product: product, show_secondary_image: section.settings.show_secondary_image, show_vendor: section.settings.show_vendor, image_ratio: settings.card_image_aspect_ratio, show_sale_badge: settings.show_sale_badge, show_sold_out_badge: settings.show_sold_out_badge, show_care_badge: settings.show_care_badge, show_light_badge: settings.show_light_badge, specimen_frame: section.settings.enable_specimen_frame %}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="bt-collection-grid__empty">
              <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="var(--bt-color-secondary)" stroke-width="1" aria-hidden="true"><path d="M12 2C8 6 4 10 4 14c0 4.4 3.6 8 8 8s8-3.6 8-8c0-4-4-8-8-12Z" opacity="0.4"/><circle cx="8" cy="9" r="1" fill="var(--bt-color-secondary)"/><circle cx="16" cy="9" r="1" fill="var(--bt-color-secondary)"/><path d="M8 14c.8 1.2 2.4 2 4 2s3.2-.8 4-2" stroke="var(--bt-color-secondary)" stroke-width="1.5" stroke-linecap="round"/></svg>
              <h2 class="bt-collection-grid__empty-title">{{ 'collections.general.empty_title' | t }}</h2>
              <p class="bt-collection-grid__empty-text">{{ 'collections.general.no_matches' | t }}</p>
              <a href="{{ collection.url }}" class="bt-btn bt-btn--gold bt-interactive bt-press">{{ 'collections.filters.clear_all' | t }}</a>
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            {%- liquid
              assign shown_count = paginate.current_offset | plus: collection.products.size
              assign progress_pct = shown_count | times: 100.0 | divided_by: paginate.items | round
            -%}
            <div class="bt-collection-grid__loadmore" data-loadmore data-section-id="{{ section.id }}" data-next-page="{{ paginate.current_page | plus: 1 }}">
              {%- if paginate.next -%}
                <button type="button" class="bt-btn bt-btn--outline bt-btn--lg bt-collection-grid__loadmore-btn bt-interactive bt-press" data-loadmore-btn hidden>
                  {{ 'collections.general.load_more' | t }}
                </button>
              {%- endif -%}
              <p class="bt-collection-grid__showing">{{ 'collections.general.showing' | t: shown: shown_count, total: paginate.items }}</p>
              <div class="bt-collection-grid__progress" aria-hidden="true">
                <span class="bt-collection-grid__progress-bar" style="width: {{ progress_pct }}%"></span>
              </div>
            </div>
            {% comment %} No-JS fallback: numbered pagination (hidden by JS when Load more activates) {% endcomment %}
            <div class="bt-collection-grid__pagination" data-pagination>{% render 'pagination', paginate: paginate %}</div>
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </div>
  </div>
</div>

{% javascript %}
  (function () {
    /* ════════════════════════════════════════════
       AJAX SILENT REFRESH — fade-out, swap, fade-up reveal.
       No full page reload, no screen flash.
       ════════════════════════════════════════════ */
    var ajaxing = false;

    /* Shared popover state: document/window listeners for sort/price popovers
       are registered ONCE (guarded by popoverShared.bound) so repeated AJAX
       grid rebuilds never stack duplicate global handlers. Handlers re-check
       root.isConnected to drop references to swapped-out DOM. */
    var popoverShared = { active: null, bound: false };
    function bindPopoverGlobals() {
      if (popoverShared.bound) return; popoverShared.bound = true;
      document.addEventListener('click', function (e) {
        var a = popoverShared.active;
        if (a && !a.root.isConnected) { popoverShared.active = null; return; }
        if (a && !a.root.contains(e.target) && !a.menu.contains(e.target)) a.hide();
      });
      document.addEventListener('keydown', function (e) {
        var a = popoverShared.active;
        if (a && !a.root.isConnected) { popoverShared.active = null; return; }
        if (a && e.key === 'Escape') { a.hide(); a.btn.focus(); }
      });
      window.addEventListener('scroll', function () {
        var a = popoverShared.active;
        if (a && !a.root.isConnected) { popoverShared.active = null; return; }
        if (a) a.position();
      }, true);
      window.addEventListener('resize', function () {
        var a = popoverShared.active;
        if (a && !a.root.isConnected) { popoverShared.active = null; return; }
        if (a) a.position();
      });
    }

    /* Motion choreography constants (see ui-ux-pro-max guidance:
       exit faster than enter, transform/opacity only, staggered) */
    var EXIT_STAGGER = 20;    /* ms between old cards, reading order */
    var EXIT_DURATION = 220;  /* ms per card (ease-in) */
    var ENTER_STAGGER = 45;   /* ms between new cards */
    var ENTER_DELAY_CAP = 450;/* cap so large pages don't feel endless */
    var ENTER_DURATION = 340; /* ms per card (ease-out) */
    var reduceMotionMq = window.matchMedia('(prefers-reduced-motion: reduce)');

    function ajaxNavigate(url, pushState) {
      if (ajaxing) return;
      ajaxing = true;
      var grid = document.querySelector('.bt-collection-grid');
      if (!grid) { window.location.href = url; return; }
      /* Close any open popover + remove orphaned portal menus from body
         before swapping DOM (otherwise they'd reference stale nodes). */
      document.querySelectorAll('.bt-sort__menu.is-open').forEach(function (m) {
        m.classList.remove('is-open');
        m.hidden = true;
        m.style.position = ''; m.style.zIndex = '';
        m.style.left = ''; m.style.top = ''; m.style.width = '';
      });
      document.querySelectorAll('[aria-expanded="true"]').forEach(function (b) {
        b.setAttribute('aria-expanded', 'false');
      });

      var main = grid.querySelector('.bt-collection-grid__main');
      var reduce = reduceMotionMq.matches;
      var cards = main ? Array.prototype.slice.call(main.querySelectorAll('.bt-grid > *')) : [];

      /* Lock current height so the swap can't collapse the page (CLS),
         and block pointer input for the duration of the transition. */
      if (main) {
        main.style.minHeight = main.offsetHeight + 'px';
        main.style.pointerEvents = 'none';
      }

      /* EXIT — old cards slide left + fade with a 20ms reading-order
         stagger. The fetch runs in parallel; the swap waits for the exit. */
      var exitMs = 0;
      if (!reduce && cards.length) {
        cards.forEach(function (card, i) {
          card.style.transitionDelay = (i * EXIT_STAGGER) + 'ms';
          card.classList.add('bt-card-exit');
        });
        exitMs = (cards.length - 1) * EXIT_STAGGER + EXIT_DURATION;
      }
      document.body.classList.add('bt-ajax-loading');

      var fetchPromise = fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
        .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); });
      var exitPromise = new Promise(function (res) { setTimeout(res, exitMs); });

      Promise.all([fetchPromise, exitPromise])
        .then(function (results) {
          var html = results[0];
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var newGrid = doc.querySelector('.bt-collection-grid');
          var oldGrid = document.querySelector('.bt-collection-grid');
          if (!newGrid || !oldGrid) { window.location.href = url; return; }

          oldGrid.innerHTML = newGrid.innerHTML;
          if (pushState !== false) {
            history.pushState({ btAjax: true, url: url }, '', url);
          }

          /* ENTER — new cards fade + slide in from the right, 45ms stagger.
             Reduced motion: skip animation entirely, content is just there. */
          var enterMs = 0;
          if (!reduce) {
            var fresh = oldGrid.querySelectorAll('.bt-grid > *');
            fresh.forEach(function (c, i) {
              c.style.animationDelay = Math.min(i * ENTER_STAGGER, ENTER_DELAY_CAP) + 'ms';
            });
            oldGrid.classList.add('bt-ajax-in');
            enterMs = ENTER_DELAY_CAP + ENTER_DURATION + 60;
          }

          /* re-init interactive components on new DOM */
          initAll();
          /* scroll to top of grid if user had scrolled past it */
          var rect = oldGrid.getBoundingClientRect();
          if (rect.top < 0) {
            oldGrid.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          }

          /* keep the pointer lock on the fresh grid until the enter
             animation completes, then release everything */
          var newMain = oldGrid.querySelector('.bt-collection-grid__main');
          if (newMain) newMain.style.pointerEvents = 'none';
          setTimeout(function () {
            oldGrid.classList.remove('bt-ajax-in');
            oldGrid.querySelectorAll('.bt-grid > *').forEach(function (c) { c.style.animationDelay = ''; });
            if (newMain) newMain.style.pointerEvents = '';
            ajaxing = false;
            document.body.classList.remove('bt-ajax-loading');
          }, enterMs);
        })
        .catch(function () { window.location.href = url; });
    }

    function urlWithSort(sortVal) {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', sortVal);
      url.searchParams.delete('page');
      return url.toString();
    }

    /* ════════════════════════════════════════════
       POPOVER (sort + price) — portal to body
       ════════════════════════════════════════════ */
    function setupPopover(root, btnSel, menuSel, opts) {
      var btn = root.querySelector(btnSel);
      var menu = root.querySelector(menuSel);
      if (!btn || !menu) return;
      var open = false;
      var originalParent = menu.parentNode;
      var originalNextSibling = menu.nextSibling;
      opts = opts || {};
      var currentEl = opts.currentSel ? root.querySelector(opts.currentSel) : null;
      var optionSel = opts.optionSel || '[data-sort-option]';
      var labelAttr = opts.labelAttr || null;

      function position() {
        var r = btn.getBoundingClientRect();
        var menuWidth = menu.offsetWidth;
        var left = r.left;
        if (left + menuWidth > window.innerWidth - 8) left = window.innerWidth - menuWidth - 8;
        if (left < 8) left = 8;
        menu.style.left = left + 'px';
        menu.style.top = (r.bottom + 6) + 'px';
      }
      function show() {
        open = true;
        popoverShared.active = api;
        if (opts.matchWidth) menu.style.width = btn.offsetWidth + 'px';
        document.body.appendChild(menu);
        menu.hidden = false;
        menu.style.position = 'fixed';
        menu.style.zIndex = '1000';
        void menu.offsetHeight;
        menu.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
        position();
      }
      function hide() {
        open = false;
        if (popoverShared.active === api) popoverShared.active = null;
        menu.classList.remove('is-open');
        btn.setAttribute('aria-expanded', 'false');
        setTimeout(function () {
          if (open) return;
          menu.hidden = true;
          menu.style.position = ''; menu.style.zIndex = '';
          menu.style.left = ''; menu.style.top = ''; menu.style.width = '';
          if (originalNextSibling && originalNextSibling.parentNode === originalParent) {
            originalParent.insertBefore(menu, originalNextSibling);
          } else { originalParent.appendChild(menu); }
        }, 220);
      }

      var api = { root: root, menu: menu, btn: btn, hide: hide, position: position };
      bindPopoverGlobals();
      btn.addEventListener('click', function (e) { e.stopPropagation(); if (open) hide(); else show(); });

      root.querySelectorAll(optionSel).forEach(function (opt) {
        opt.addEventListener('mouseenter', function () {
          if (!currentEl) return;
          if (labelAttr) { var lbl = opt.getAttribute(labelAttr); if (lbl) currentEl.textContent = lbl; }
          else { var txt = opt.querySelector('span'); if (txt) currentEl.textContent = txt.textContent; }
        });
        /* Sort options: AJAX navigate preserving query params */
        var sortVal = opt.getAttribute('data-sort-value');
        if (sortVal !== null) {
          opt.addEventListener('click', function (e) {
            e.preventDefault();
            hide();
            ajaxNavigate(urlWithSort(sortVal));
          });
        }
      });
      root.addEventListener('mouseleave', function () {
        if (!currentEl) return;
        var selOpt = root.querySelector(optionSel + '.is-selected');
        if (selOpt) {
          if (labelAttr) { currentEl.textContent = selOpt.getAttribute(labelAttr) || currentEl.textContent; }
          else { var sp = selOpt.querySelector('span'); if (sp) currentEl.textContent = sp.textContent; }
        }
      });
    }

    function initPopovers() {
      /* Clean up any orphaned portal menus left on body from previous AJAX swap */
      document.querySelectorAll('body > .bt-sort__menu').forEach(function (m) {
        /* only remove if its original parent is gone (stale) */
        if (!m.closest('.bt-collection-grid') && !m.closest('[data-sort]')) {
          m.remove();
        }
      });
      document.querySelectorAll('[data-sort]').forEach(function (root) {
        if (root._btPopoverInit) return; root._btPopoverInit = true;
        setupPopover(root, '[data-sort-button]', '[data-sort-menu]', {
          currentSel: '[data-sort-current]', optionSel: '[data-sort-option]'
        });
      });
    }

    /* ════════════════════════════════════════════
       SIDEBAR DETAILS — height animation
       ════════════════════════════════════════════ */
    function initDetails() {
      document.querySelectorAll('[data-filter-group]').forEach(function (details) {
        if (details._btDetailsInit) return; details._btDetailsInit = true;
        var content = details.querySelector('[data-filter-content]');
        if (!content) return;
        var summary = details.querySelector('summary');
        summary.addEventListener('click', function (e) {
          e.preventDefault();
          if (details.open) {
            content.style.height = content.scrollHeight + 'px';
            void content.offsetHeight;
            content.style.height = '0px'; content.style.opacity = '0';
            setTimeout(function () { details.removeAttribute('open'); content.style.height = ''; content.style.opacity = ''; }, 220);
          } else {
            details.setAttribute('open', '');
            content.style.height = '0px'; content.style.opacity = '0';
            void content.offsetHeight;
            content.style.height = content.scrollHeight + 'px'; content.style.opacity = '1';
            setTimeout(function () { content.style.height = ''; }, 220);
          }
        });
      });
    }

    /* ════════════════════════════════════════════
       LOAD MORE — Section Rendering API append.
       Fetches ?page=N&section_id=…, appends the new cards, and swaps the
       load-more block for the freshly rendered one (server already computed
       the next page number, "Showing X of N" text and progress width).
       Numbered pagination stays as the no-JS fallback.
       ════════════════════════════════════════════ */
    function initLoadMore() {
      document.querySelectorAll('[data-loadmore]').forEach(function (wrap) {
        if (wrap._btLoadmoreInit) return; wrap._btLoadmoreInit = true;
        var main = wrap.closest('.bt-collection-grid__main');
        var pagination = main ? main.querySelector('[data-pagination]') : null;
        /* JS is available: hide numbered pagination (Load more takes over) */
        if (pagination) pagination.hidden = true;
        var btn = wrap.querySelector('[data-loadmore-btn]');
        if (!btn) return; /* last page: keep "Showing X of N" + full progress, no button */
        btn.hidden = false;
        btn.addEventListener('click', function () {
          if (btn.disabled) return;
          var nextPage = wrap.getAttribute('data-next-page');
          var sectionId = wrap.getAttribute('data-section-id');
          var url = new URL(window.location.href);
          url.searchParams.delete('page');
          url.searchParams.set('page', nextPage);
          url.searchParams.set('section_id', sectionId);
          btn.disabled = true;
          btn.classList.add('bt-btn--loading');
          fetch(url.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' })
            .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
            .then(function (html) {
              var doc = new DOMParser().parseFromString(html, 'text/html');
              var grid = main.querySelector('.bt-grid');
              var newItems = doc.querySelectorAll('.bt-collection-grid .bt-grid > *');
              if (grid && newItems.length) {
                newItems.forEach(function (item) {
                  item.classList.add('bt-loadmore-item');
                  grid.appendChild(item);
                });
              }
              var newWrap = doc.querySelector('[data-loadmore]');
              var newPagination = doc.querySelector('[data-pagination]');
              if (newWrap) {
                wrap.replaceWith(newWrap);
                if (pagination && newPagination) pagination.replaceWith(newPagination);
                initLoadMore();
              } else {
                /* That was the last page — drop the block entirely */
                wrap.remove();
                if (pagination) pagination.remove();
              }
            })
            .catch(function () {
              /* graceful fallback: plain navigation to the target page */
              var fallback = new URL(window.location.href);
              fallback.searchParams.delete('page');
              fallback.searchParams.set('page', nextPage);
              window.location.href = fallback.toString();
            });
        });
      });
    }

    /* ════════════════════════════════════════════
       AJAX NAVIGATION DELEGATION
       Intercept clicks on links + checkbox changes
       inside the collection grid → ajaxNavigate.
       ════════════════════════════════════════════ */
    function initAjaxDelegation() {
      if (window._btAjaxDelegation) return; window._btAjaxDelegation = true;

      document.addEventListener('click', function (e) {
        var link = e.target.closest('a[href]');
        if (!link) return;
        if (!link.closest('.bt-collection-grid')) return;
        var href = link.getAttribute('href');
        if (!href || href === '#' || href.charAt(0) === '#') return;
        if (link.target === '_blank' || link.hasAttribute('download')) return;
        /* skip sort options (handled by their own click handler) */
        if (link.hasAttribute('data-sort-value')) return;
        /* skip product links — navigate normally to PDP */
        if (href.indexOf('/products/') !== -1) return;
        /* skip pagination links when Load more is active (hidden anyway) */
        if (link.closest('[data-pagination]') && link.closest('[data-pagination]').hidden) return;
        e.preventDefault();
        ajaxNavigate(href);
      });

      document.addEventListener('change', function (e) {
        var input = e.target;
        if (input.tagName !== 'INPUT' || input.type !== 'checkbox') return;
        if (!input.closest('.bt-collection-grid')) return;
        var url = input.checked ? input.getAttribute('data-url-to-add') : input.getAttribute('data-url-to-remove');
        if (!url) return;
        ajaxNavigate(url);
      });

      /* Price range ── debounced AJAX on input */
      var priceTimer = null;
      document.addEventListener('input', function (e) {
        var inp = e.target;
        if (!inp.hasAttribute('data-price-min') && !inp.hasAttribute('data-price-max')) return;
        clearTimeout(priceTimer);
        priceTimer = setTimeout(function () {
          applyPriceRange();
        }, 350);
      });
      function applyPriceRange() {
        var minInp = document.querySelector('[data-price-min]');
        var maxInp = document.querySelector('[data-price-max]');
        var minVal = minInp ? parseFloat(minInp.value) || 0 : 0;
        var maxVal = maxInp ? parseFloat(maxInp.value) || 0 : 0;
        var maxLimit = maxInp ? parseFloat(maxInp.getAttribute('max')) || 0 : 0;
        var baseUrl = window.location.pathname + window.location.search;
        /* strip existing price params */
        baseUrl = baseUrl.replace(/[?&]filter\.v\.price\.gte=[^&]*/g, '').replace(/[?&]filter\.v\.price\.lte=[^&]*/g, '').replace(/&&/g, '&').replace(/\?&/, '?').replace(/[?&]$/, '');
        var sep = baseUrl.indexOf('?') === -1 ? '?' : '&';
        var url = baseUrl;
        if (minVal > 0) { url += sep + 'filter.v.price.gte=' + minVal; sep = '&'; }
        if (maxVal > 0 && maxVal < maxLimit) { url += sep + 'filter.v.price.lte=' + maxVal; sep = '&'; }
        if (url !== window.location.pathname + window.location.search) {
          ajaxNavigate(url);
        }
      }

      window.addEventListener('popstate', function () {
        if (ajaxing) {
          /* A filter/sort request is in flight: retry once shortly; if it is
             still busy, fall back to a full reload of the (already updated)
             URL instead of silently dropping the back/forward navigation. */
          setTimeout(function () {
            if (ajaxing) { window.location.reload(); } else { ajaxNavigate(window.location.href, false); }
          }, 300);
          return;
        }
        ajaxNavigate(window.location.href, false);
      });
    }

    /* ════════════════════════════════════════════
       FILTER TOGGLE — desktop collapses the sidebar,
       mobile opens the slide-in drawer.
       ════════════════════════════════════════════ */
    var mobileSidebarBound = false;
    function initMobileSidebar() {
      var filterToggle = document.querySelector('[data-filter-toggle]');
      var sidebar = document.querySelector('[data-sidebar]');
      if (!filterToggle || !sidebar) return;
      if (!filterToggle._btMobileInit) {
        filterToggle._btMobileInit = true;
        filterToggle.addEventListener('click', function () {
          var sb = document.querySelector('[data-sidebar]');
          var grid = document.querySelector('.bt-collection-grid');
          if (!sb || !grid) return;
          if (window.matchMedia('(min-width: 990px)').matches) {
            /* Desktop: collapse/expand the sidebar column */
            var collapsed = grid.classList.toggle('is-sidebar-collapsed');
            filterToggle.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
          } else {
            /* Mobile: slide-in drawer */
            sb.classList.toggle('is-open');
            document.body.classList.toggle('bt-filter-open');
          }
        });
      }
      /* Drawer footer + outside-click close: document listener registered once
         (guarded), elements re-resolved at event time so the single handler
         keeps working across AJAX grid rebuilds without stacking. */
      if (mobileSidebarBound) return; mobileSidebarBound = true;
      document.addEventListener('click', function (e) {
        if (e.target.closest('[data-filter-close]')) {
          var sb = document.querySelector('[data-sidebar]');
          if (sb) sb.classList.remove('is-open');
          document.body.classList.remove('bt-filter-open');
          return;
        }
        if (!document.body.classList.contains('bt-filter-open')) return;
        var sb = document.querySelector('[data-sidebar]');
        var tg = document.querySelector('[data-filter-toggle]');
        if (!sb) return;
        if (sb.contains(e.target) || (tg && tg.contains(e.target))) return;
        sb.classList.remove('is-open');
        document.body.classList.remove('bt-filter-open');
      });
    }

    /* Quick-add is handled globally in assets/cart.js (single
       delegated listener) so it also works on the homepage and
       survives AJAX grid swaps without duplicate handlers. */

    function initAll() {
      initPopovers();
      initDetails();
      initMobileSidebar();
      initLoadMore();
    }

    initAll();
    initAjaxDelegation();
  })();
{% endjavascript %}

{% stylesheet %}
  /* ════════════════════════════════════════════
     STICKY TOOLBAR
     ════════════════════════════════════════════ */
  .bt-collection-grid__toolbar {
    position: sticky;
    top: 80px; /* clear the fixed header */
    z-index: 30;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--bt-space-md);
    margin-bottom: var(--bt-space-sm);
    padding-block: var(--bt-space-2xs);
    background: rgba(var(--bt-color-bg-rgb), 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--bt-color-border-light);
  }
  .bt-collection-grid__toolbar-left {
    display: flex;
    align-items: center;
    gap: var(--bt-space-sm);
    min-width: 0;
  }
  /* Prominent count: strong number + muted unit */
  .bt-collection-grid__count {
    display: flex;
    align-items: baseline;
    gap: 0.35em;
    margin: 0;
    font-size: var(--bt-fs-body-sm);
