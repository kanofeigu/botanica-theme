    border-radius: var(--bt-radius-pill);
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
  }
  /* Filter toggle — soft pill, visible on all viewports
     (desktop: collapses sidebar / mobile: opens drawer) */
  .bt-collection-grid__filter-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--bt-space-2xs);
