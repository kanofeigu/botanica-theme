<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {%- for scheme in settings.color_schemes limit: 1 -%}{%- assign default_scheme = scheme -%}{%- endfor -%}
  <meta name="theme-color" content="{{ default_scheme.settings.background }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {%- liquid
    assign meta_description = page_description | default: shop.description
    if meta_description == blank
      assign meta_description = 'general.meta_description_fallback' | t
    endif
  -%}
  <meta name="description" content="{{ meta_description | escape }}">

  {{ content_for_header }}

  {%- liquid
    assign body_font_bold = settings.body_font | font_modify: 'weight', 'bold'
    assign body_font_italic = settings.body_font | font_modify: 'style', 'italic'
    assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  -%}

  {{ 'design-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {% comment %}
    Effects CSS loaded non-blocking via media="print" swap pattern.
    These files are purely decorative (animations/transitions on
    transform & opacity only — zero layout impact). Deferring them
    removes ~43 KB from the critical rendering path.
    <noscript> fallback for JS-disabled clients.
  {% endcomment %}
  <link rel="stylesheet" href="{{ 'effects.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'effects.css' | asset_url }}"></noscript>
  <link rel="stylesheet" href="{{ 'botanical-effects.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'botanical-effects.css' | asset_url }}"></noscript>

  {% comment %}
    Inject merchant-editable palette TYPE settings AFTER design-tokens.css so
    the cascade lets merchants' color changes win over the static fallbacks
    shipped in design-tokens.css (which only exist for the empty-state preview).
    Same specificity (:root), later source order → merchant palette wins.
  {% endcomment %}
  {% style %}
    {{ settings.body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.heading_font | font_face: font_display: 'swap' }}

    {%- comment -%}
      Color schemes — one .color-scheme-N class per scheme defined in
      settings_data.json (merchant-editable under Theme settings → Colors).
      scheme-1 doubles as the :root global default so uncategorized surfaces
      (body, drawers) keep the base palette. Derived tokens (hover / tint /
      border-light / shadows) resolve from these vars at point of use via
      color-mix() in design-tokens.css, so they adapt per scheme automatically.
      Surface / muted derive in Liquid: light schemes lift surface and soften
      text; dark schemes invert the direction.
    {%- endcomment -%}
    {%- for scheme in settings.color_schemes -%}
      {%- assign bg_brightness = scheme.settings.background | color_brightness -%}
      {%- if bg_brightness > 128 -%}
        {%- assign scheme_surface = scheme.settings.background | color_lighten: 2 -%}
        {%- assign scheme_muted = scheme.settings.text | color_lighten: 12 -%}
      {%- else -%}
        {%- assign scheme_surface = scheme.settings.background | color_lighten: 6 -%}
        {%- assign scheme_muted = scheme.settings.text | color_darken: 12 -%}
      {%- endif -%}
      {% if forloop.index == 1 %}:root,{% endif %}
      .color-{{ scheme.id }} {
        --bt-color-bg: {{ scheme.settings.background }};
        --bt-color-bg-rgb: {{ scheme.settings.background.red }}, {{ scheme.settings.background.green }}, {{ scheme.settings.background.blue }};
        --bt-color-surface: {{ scheme_surface }};
        --bt-color-text: {{ scheme.settings.text }};
        --bt-color-text-rgb: {{ scheme.settings.text.red }}, {{ scheme.settings.text.green }}, {{ scheme.settings.text.blue }};
        --bt-color-text-muted: {{ scheme_muted }};
        --bt-color-primary: {{ scheme.settings.button }};
        --bt-color-primary-rgb: {{ scheme.settings.button.red }}, {{ scheme.settings.button.green }}, {{ scheme.settings.button.blue }};
        --bt-color-primary-contrast: {{ scheme.settings.button_label }};
        --bt-color-primary-contrast-rgb: {{ scheme.settings.button_label.red }}, {{ scheme.settings.button_label.green }}, {{ scheme.settings.button_label.blue }};
        --bt-color-secondary: {{ scheme.settings.accent }};
        --bt-color-secondary-rgb: {{ scheme.settings.accent.red }}, {{ scheme.settings.accent.green }}, {{ scheme.settings.accent.blue }};
        --bt-color-border: {{ scheme.settings.shadow }};
        {%- if scheme.settings.background_gradient != blank %}
          --bt-color-bg-gradient: {{ scheme.settings.background_gradient }};
        {%- endif %}
      }
    {%- endfor -%}

    :root {
      --bt-font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
      --bt-font-body: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
      --bt-fs-body: {{ settings.body_scale | divided_by: 100.0 }}rem;
      --bt-max-width: {{ settings.max_width }}px;
      --bt-grid-gap: {{ settings.grid_horizontal_spacing }}px;
      --bt-radius-btn: {{ settings.button_corner_radius }}px;
      --bt-radius-input: {{ settings.inputs_corner_radius }}px;
      --bt-radius-card: {{ settings.card_corner_radius }}px;
    }
  {% endstyle %}

  {%- unless settings.heading_font.system? -%}
    {{ settings.heading_font | font_url | preload_tag: as: "font", type: "font/woff2", crossorigin: "anonymous" }}
  {%- endunless -%}
  {%- unless settings.body_font.system? -%}
    {{ settings.body_font | font_url | preload_tag: as: "font", type: "font/woff2", crossorigin: "anonymous" }}
  {%- endunless -%}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    if (Shopify.designMode) {
      document.documentElement.classList.add('shopify-design-mode');
    }
  </script>
</head>

<body>
  <a class="bt-skip-link" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  {% sections 'header-group' %}

  <main
    id="MainContent"
    class="content-for-layout focus-none"
    role="main"
    tabindex="-1"
  >
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- if settings.cart_type == 'drawer' -%}
    {%- liquid
      assign free_shipping_threshold = settings.free_shipping_threshold | default: 50
      assign free_shipping_msg = 'sections.cart.free_shipping_remaining_html' | t: amount: '{amount}'
      assign free_shipping_reached = 'sections.cart.free_shipping_reached' | t
      assign cart_title = 'sections.cart.title' | t
      assign cart_empty = 'sections.cart.empty' | t
      assign cart_subtotal = 'sections.cart.subtotal' | t
      assign cart_checkout = 'sections.cart.checkout' | t
      assign cart_view = 'sections.cart.view_cart' | t
      assign close_label = 'accessibility.close' | t
      assign gift_note_label = 'sections.cart.note' | t | default: 'Add a gift note'
    -%}
    <bt-cart-drawer
      class="bt-cart-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="{{ cart_title }}"
      data-free-shipping-threshold="{{ free_shipping_threshold }}"
      data-free-shipping-msg="{{ free_shipping_msg | escape }}"
      data-free-shipping-reached="{{ free_shipping_reached | escape }}"
    >
      <div class="bt-cart-drawer__overlay" data-cart-overlay></div>
      <div class="bt-cart-drawer__panel">
        <div class="bt-cart-drawer__header">
          <h2 class="bt-h3">{{ cart_title }}</h2>
          <button type="button" class="bt-header__icon-btn" data-cart-close aria-label="{{ close_label }}">
            {% render 'icon-close' %}
          </button>
        </div>
        <div class="bt-cart-drawer__body" data-cart-drawer-body>

          {% comment %} Free shipping progress bar — JS will update dynamically {% endcomment %}
          <div class="bt-cart-drawer__shipping" data-cart-shipping role="status" hidden>
            {%- if cart.item_count > 0 and settings.show_free_shipping_bar -%}
              {%- liquid
                assign threshold = settings.free_shipping_threshold | times: 100
                assign remaining = threshold | minus: cart.total_price
              -%}
              {%- if remaining > 0 -%}
                {%- assign remaining_formatted = remaining | money -%}
                <p class="bt-cart-drawer__shipping-msg">{{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_formatted }}</p>
                <div class="bt-cart-drawer__shipping-track"><div class="bt-cart-drawer__shipping-fill" style="width: {{ cart.total_price | times: 100 | divided_by: threshold }}%"></div></div>
              {%- else -%}
                <p class="bt-cart-drawer__shipping-msg bt-cart-drawer__shipping-msg--reached">{{ 'sections.cart.free_shipping_reached' | t }}</p>
              {%- endif -%}
            {%- endif -%}
          </div>

          {% comment %} Empty state — visible when cart is empty {% endcomment %}
          <div class="bt-cart-drawer__empty" data-cart-empty{% if cart.item_count > 0 %} hidden{% endif %}>
            <p>{{ cart_empty }}</p>
          </div>

          {% comment %} Cart items — rendered by JS after first load {% endcomment %}
          <ul class="bt-cart-drawer__items" role="list" data-cart-items{% if cart.item_count == 0 %} hidden{% endif %}>
            {%- for item in cart.items -%}
              <li class="bt-cart-drawer__item" role="listitem">
                <div class="bt-cart-drawer__item-media">
                  {%- if item.image -%}
                    <a href="{{ item.url }}">{{ item.image | image_url: width: 150 | image_tag: loading: 'lazy', widths: '75, 150', alt: item.title }}</a>
                  {%- endif -%}
                </div>
                <div class="bt-cart-drawer__item-info">
                  <a href="{{ item.url }}" class="bt-cart-drawer__item-title">{{ item.product.title }}</a>
                  {%- if item.variant.title != 'Default Title' -%}
                    <p class="bt-cart-drawer__item-variant">{{ item.variant.title }}</p>
                  {%- endif -%}
                  <div class="bt-cart-drawer__item-qty-row">
                    {% render 'qty-stepper', item_key: item.key, quantity: item.quantity, product_title: item.product.title %}
                    <span class="bt-cart-drawer__item-price">
                      {%- if item.variant.compare_at_price > item.final_price -%}
                        <span class="bt-cart-drawer__item-compare">{{ item.variant.compare_at_price | money }}</span>
                      {%- endif -%}
                      {{ item.final_line_price | money }}
                    </span>
                  </div>
                </div>
                <button type="button" class="bt-cart-drawer__item-remove" data-action="remove" data-key="{{ item.key }}" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">
                  {% render 'icon-trash' %}
                </button>
              </li>
            {%- endfor -%}
          </ul>

          {% comment %} Upsell recommendations — loaded dynamically by JS {% endcomment %}
          <div class="bt-cart-drawer__upsell" data-cart-upsell></div>
        </div>

        {% comment %} Footer — always rendered, hidden when empty {% endcomment %}
        <div class="bt-cart-drawer__footer" data-cart-drawer-footer{% if cart.item_count == 0 %} hidden{% endif %}>
          {% comment %} Gift note {% endcomment %}
          <div class="bt-cart-drawer__note">
            <label for="CartDrawerNote" class="bt-cart-drawer__note-label">{{ gift_note_label }}</label>
            <textarea id="CartDrawerNote" class="bt-input bt-cart-drawer__note-input" name="note" data-cart-gift-note rows="2" placeholder="{{ 'sections.cart.note_placeholder' | t | default: 'Special instructions…' }}">{{ cart.note }}</textarea>
          </div>

          <div class="bt-cart-drawer__total">
            <span>{{ cart_subtotal }}</span>
            <strong data-cart-subtotal>{{ cart.total_price | money }}</strong>
          </div>

          <a href="{{ routes.cart_url }}" class="bt-btn bt-btn--secondary bt-btn--block bt-btn--sm" data-cart-view-btn{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart_view }}</a>
          <form action="{{ routes.cart_url }}" method="post" data-cart-checkout-form{% if cart.item_count == 0 %} hidden{% endif %}>
            <button type="submit" name="checkout" class="bt-btn bt-btn--primary bt-btn--block bt-btn--lg">{{ cart_checkout }}</button>
          </form>
        </div>
      </div>
    </bt-cart-drawer>
  {%- endif -%}

  <bt-predictive-search class="bt-predictive" hidden>
    <div class="bt-predictive__bar bt-container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="bt-predictive__form">
        <input
          type="search"
          name="q"
          class="bt-input bt-predictive__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.search' | t }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <input type="hidden" name="type" value="product">
        <button type="button" class="bt-header__icon-btn bt-predictive__close" data-predictive-close aria-label="{{ 'accessibility.close' | t }}">
          {% render 'icon-close' %}
        </button>
      </form>
    </div>
    <div class="bt-predictive__results bt-predictive-results bt-container" role="listbox" aria-label="{{ 'general.search.results' | t }}" hidden></div>
  </bt-predictive-search>

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  <script>
    window.shopUrl = '{{ request.origin }}';
    window.theme = window.theme || {};
    window.theme.moneyFormat = {{ shop.money_format | json }};
    window.theme.strings = {
      addToCart: {{ 'products.product.add_to_cart' | t | json }},
      viewDetails: {{ 'products.product.view_details' | t | json }},
      close: {{ 'accessibility.close' | t | json }}
    };
  </script>

  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
  {%- if settings.predictive_search_enabled -%}
    <script src="{{ 'search.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <script src="{{ 'sticky-atc.js' | asset_url }}" defer="defer"></script>
</body>
</html>
