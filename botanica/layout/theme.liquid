<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.colors_background }}">
  <link rel="canonical" href="{{ canonical_url }}">

  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>

  {% if page_description %}
    <meta name="description" content="{{ page_description | escape }}">
  {% endif %}

  {{ content_for_header }}

  {%- liquid
    assign body_font_bold = settings.body_font | font_modify: 'weight', 'bold'
    assign body_font_italic = settings.body_font | font_modify: 'style', 'italic'
    assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
  -%}

  {{ 'design-tokens.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}

  {% comment %}
    Effects CSS loaded non-blocking via media="print" swap pattern.
    These files are purely decorative (animations/transitions on
    transform & opacity only — zero layout impact). Deferring them
    removes ~43 KB from the critical rendering path.
    <noscript> fallback for JS-disabled clients.
  {% endcomment %}
  <link rel="stylesheet" href="{{ 'effects.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'effects.css' | asset_url }}"></noscript>
  <link rel="stylesheet" href="{{ 'botanical-effects.css' | asset_url }}" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="{{ 'botanical-effects.css' | asset_url }}"></noscript>

  {% comment %}
    Inject merchant-editable palette TYPE settings AFTER design-tokens.css so
    the cascade lets merchants' color changes win over the static fallbacks
    shipped in design-tokens.css (which only exist for the empty-state preview).
    Same specificity (:root), later source order → merchant palette wins.
  {% endcomment %}
  {% style %}
    {{ settings.body_font | font_face: font_display: 'swap' }}
    {{ body_font_bold | font_face: font_display: 'swap' }}
    {{ body_font_italic | font_face: font_display: 'swap' }}
    {{ body_font_bold_italic | font_face: font_display: 'swap' }}
    {{ settings.heading_font | font_face: font_display: 'swap' }}

    :root {
      --bt-color-bg: {{ settings.colors_background }};
      --bt-color-surface: {{ settings.colors_surface }};
      --bt-color-text: {{ settings.colors_text }};
      --bt-color-text-muted: {{ settings.colors_text_muted }};
      --bt-color-primary: {{ settings.colors_primary }};
      --bt-color-primary-contrast: {{ settings.colors_primary_contrast }};
      --bt-color-secondary: {{ settings.colors_secondary }};
      --bt-color-border: {{ settings.colors_border }};

      --bt-font-heading: {{ settings.heading_font.family }}, {{ settings.heading_font.fallback_families }};
      --bt-font-body: {{ settings.body_font.family }}, {{ settings.body_font.fallback_families }};
      --bt-fs-body: {{ settings.body_scale | divided_by: 100.0 }}rem;
      --bt-max-width: {{ settings.max_width }}px;
      --bt-grid-gap: {{ settings.grid_horizontal_spacing }}px;
      --bt-radius-btn: {{ settings.button_corner_radius }}px;
      --bt-radius-input: {{ settings.inputs_corner_radius }}px;
      --bt-radius-card: {{ settings.card_corner_radius }}px;
    }
  {% endstyle %}

  {%- unless settings.heading_font.system? -%}
    {{ settings.heading_font | font_url | preload_tag: as: "font", type: "font/woff2", crossorigin: "anonymous" }}
  {%- endunless -%}
  {%- unless settings.body_font.system? -%}
    {{ settings.body_font | font_url | preload_tag: as: "font", type: "font/woff2", crossorigin: "anonymous" }}
  {%- endunless -%}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    if (Shopify.designMode) {
      document.documentElement.classList.add('shopify-design-mode');
    }
  </script>
</head>

<body>
  <a class="bt-skip-link" href="#MainContent">
    {{ 'accessibility.skip_to_text' | t }}
  </a>

  {% sections 'header-group' %}

  <main
    id="MainContent"
    class="content-for-layout focus-none"
    role="main"
    tabindex="-1"
  >
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- if settings.cart_type == 'drawer' -%}
    <bt-cart-drawer class="bt-cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
      <div class="bt-cart-drawer__overlay" data-cart-overlay></div>
      <div class="bt-cart-drawer__panel">
        <div class="bt-cart-drawer__header">
          <h2 class="bt-h3">{{ 'sections.cart.title' | t }}</h2>
          <button type="button" class="bt-header__icon-btn" data-cart-close aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon-close' %}
          </button>
        </div>
        <div class="bt-cart-drawer__body" data-cart-drawer-body>
          {%- if cart.item_count > 0 -%}
            {%- if settings.show_free_shipping_bar -%}
              {%- liquid
                assign threshold = settings.free_shipping_threshold | times: 100
                assign remaining = threshold | minus: cart.total_price
              -%}
              {%- if remaining > 0 -%}
                <div class="bt-cart-drawer__shipping" role="status">
                  {%- assign remaining_formatted = remaining | money -%}
                  <p class="bt-cart-drawer__shipping-msg">{{ 'sections.cart.free_shipping_remaining_html' | t: amount: remaining_formatted }}</p>
                  <div class="bt-cart-drawer__shipping-track"><div class="bt-cart-drawer__shipping-fill" style="width: {{ cart.total_price | times: 100 | divided_by: threshold }}%"></div></div>
                </div>
              {%- else -%}
                <p class="bt-cart-drawer__shipping-msg bt-cart-drawer__shipping-msg--reached" role="status">{{ 'sections.cart.free_shipping_reached' | t }}</p>
              {%- endif -%}
            {%- endif -%}
            <ul class="bt-cart-drawer__items" role="list">
              {%- for item in cart.items -%}
                <li class="bt-cart-drawer__item" role="listitem">
                  <div class="bt-cart-drawer__item-media">
                    {%- if item.image -%}
                      {{ item.image | image_url: width: 150 | image_tag: loading: 'lazy', widths: '75, 150', alt: item.title }}
                    {%- endif -%}
                  </div>
                  <div class="bt-cart-drawer__item-info">
                    <a href="{{ item.url }}" class="bt-cart-drawer__item-title">{{ item.product.title }}</a>
                    {%- if item.variant.title != 'Default Title' -%}
                      <p class="bt-cart-drawer__item-variant">{{ item.variant.title }}</p>
                    {%- endif -%}
                    <div class="bt-cart-drawer__item-qty-row">
                      <input type="number" name="updates[]" value="{{ item.quantity }}" min="1" class="bt-input bt-cart-drawer__qty" aria-label="{{ 'products.product.quantity.label' | t }}" readonly>
                      <span>{{ item.final_line_price | money }}</span>
                    </div>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="bt-cart-drawer__item-remove" aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}">{% render 'icon-close' %}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- else -%}
            <div class="bt-cart-drawer__empty">
              <p>{{ 'sections.cart.empty' | t }}</p>
            </div>
          {%- endif -%}
        </div>
        {%- if cart.item_count > 0 -%}
          <div class="bt-cart-drawer__footer">
            <div class="bt-cart-drawer__total">
              <span>{{ 'sections.cart.subtotal' | t }}</span>
              <strong>{{ cart.total_price | money }}</strong>
            </div>
            <a href="{{ routes.cart_url }}" class="bt-btn bt-btn--secondary bt-btn--block">{{ 'sections.cart.view_cart' | t }}</a>
            <form action="{{ routes.cart_url }}" method="post">
              <button type="submit" name="checkout" class="bt-btn bt-btn--primary bt-btn--block bt-btn--lg">{{ 'sections.cart.checkout' | t }}</button>
            </form>
          </div>
        {%- endif -%}
      </div>
    </bt-cart-drawer>
  {%- endif -%}

  <bt-predictive-search class="bt-predictive" hidden>
    <div class="bt-predictive__results bt-predictive-results" role="listbox" aria-label="{{ 'general.search.results' | t }}"></div>
  </bt-predictive-search>

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
    <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
  </ul>

  <script>
    window.shopUrl = '{{ request.origin }}';
    window.theme = window.theme || {};
    window.theme.moneyFormat = {{ shop.money_format | json }};
  </script>

  <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
  {%- if settings.predictive_search_enabled -%}
    <script src="{{ 'search.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}
  <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'sticky-atc.js' | asset_url }}" defer="defer"></script>
  <bt-quick-view hidden></bt-quick-view>
</body>
</html>
