<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.colors_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ 'general.password_page.login_form_heading' | t }}</title>

    {%- liquid
      assign body_font = settings.body_font
      assign heading_font = settings.heading_font
    -%}

    {% style %}
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}

      :root {
        --bt-color-bg: {{ settings.colors_background | default: '#F5F1E8' }};
        --bt-color-text: {{ settings.colors_text | default: '#2E2A24' }};
        --bt-color-primary: {{ settings.colors_primary | default: '#4A6B4F' }};
        --bt-color-primary-contrast: {{ settings.colors_primary_contrast | default: '#FFFFFF' }};
        --bt-color-secondary: {{ settings.colors_secondary | default: '#C97D5A' }};
        --bt-font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --bt-font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --bt-fs-h1: clamp(2.2rem, 3.5vw, 3.2rem);
        --bt-fs-body: 1rem;
        --bt-fs-body-sm: 0.875rem;
        --bt-lh-body: 1.6;
        --bt-radius-btn: 4px;
        --bt-radius-input: 4px;
        --bt-space-sm: 16px;
        --bt-space-md: 24px;
        --bt-border-width: 1px;
        --bt-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --bt-duration-fast: 150ms;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html { font-size: 100%; -webkit-text-size-adjust: 100%; }

      body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        padding: var(--bt-space-md);
        font-family: var(--bt-font-body);
        font-size: var(--bt-fs-body);
        line-height: var(--bt-lh-body);
        color: var(--bt-color-text);
        background: var(--bt-color-bg);
      }

      .password-modal {
        width: 100%;
        max-width: 440px;
        padding: var(--bt-space-md);
        text-align: center;
      }

      .password-modal h1 {
        font-family: var(--bt-font-heading);
        font-size: var(--bt-fs-h1);
        font-weight: 400;
        margin: 0 0 var(--bt-space-sm);
      }

      .password-modal p {
        margin: 0 0 var(--bt-space-md);
        color: var(--bt-color-text);
        opacity: 0.75;
      }

      .password-modal__form {
        display: flex;
        flex-direction: column;
        gap: var(--bt-space-sm);
      }

      .password-modal__input {
        padding: 0.75em 1em;
        font-family: var(--bt-font-body);
        font-size: var(--bt-fs-body);
        border: var(--bt-border-width) solid var(--bt-color-text);
        border-radius: var(--bt-radius-input);
        background: transparent;
        color: var(--bt-color-text);
        text-align: center;
      }

      .password-modal__input:focus-visible {
        outline: 2px solid var(--bt-color-primary);
        outline-offset: 2px;
      }

      .password-modal__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.75em 2em;
        font-family: var(--bt-font-body);
        font-size: var(--bt-fs-body-sm);
        font-weight: 600;
        background: var(--bt-color-primary);
        color: var(--bt-color-primary-contrast);
        border: none;
        border-radius: var(--bt-radius-btn);
        cursor: pointer;
        min-height: 44px;
        transition: opacity var(--bt-duration-fast) var(--bt-ease-out);
      }

      .password-modal__btn:hover { opacity: 0.9; }

      .password-modal__error {
        color: var(--bt-color-secondary);
        font-size: var(--bt-fs-body-sm);
        margin-top: var(--bt-space-sm);
      }

      .password-modal__admin {
        margin-top: var(--bt-space-md);
        font-size: var(--bt-fs-body-sm);
      }

      .password-modal__admin a {
        color: var(--bt-color-primary);
      }

      .bt-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
      }

      @media (prefers-reduced-motion: reduce) {
        * { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <div class="password-modal">
      <h1>{{ 'general.password_page.login_form_heading' | t }}</h1>

      {%- form 'storefront_password', class: 'password-modal__form' -%}
        <label for="Password" class="bt-sr-only">
          {{ 'general.password_page.login_form_password_label' | t }}
        </label>
        <input
          type="password"
          name="password"
          id="Password"
          class="password-modal__input"
          placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
          autofocus
          aria-required="true"
          required
        >
        <button type="submit" name="commit" class="password-modal__btn">
          {{ 'general.password_page.login_form_submit' | t }}
        </button>
      {%- endform -%}

      {%- if form.errors -%}
        <div class="password-modal__error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="password-modal__admin">
        {{ 'general.password_page.admin_link_html' | t }}
      </div>
      {{ content_for_layout }}
    </div>

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </body>
</html>
