{% comment %}
  blocks/badge.liquid — Reusable badge/pill
  Configurable text, color from palette, size.
{% endcomment %}
{%- if block.settings.text != blank -%}
  <span class="bt-badge bt-badge--{{ block.settings.style | default: 'default' }}" {{ block.shopify_attributes }}>
    {{ block.settings.text | escape }}
  </span>
{%- endif -%}

{% stylesheet %}
  .bt-badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 10px;
    font-size: var(--bt-fs-badge);
    font-weight: 600;
    line-height: 1.6;
    border-radius: var(--bt-radius-tag);
    white-space: nowrap;
  }
  .bt-badge--default { background: var(--bt-color-surface); color: var(--bt-color-text); }
  .bt-badge--primary { background: var(--bt-color-primary-tint); color: var(--bt-color-primary); }
  .bt-badge--secondary { background: var(--bt-color-secondary-tint); color: var(--bt-color-secondary); }
  .bt-badge--accent { background: var(--bt-color-primary); color: var(--bt-color-primary-contrast); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.badge.name",
  "settings": [
    { "type": "text", "id": "text", "label": "t:blocks.badge.settings.text.label", "default": "New" },
    { "type": "select", "id": "style", "label": "t:blocks.badge.settings.style.label",
      "options": [
        { "value": "default", "label": "t:blocks.badge.settings.style.options__1.label" },
        { "value": "primary", "label": "t:blocks.badge.settings.style.options__2.label" },
        { "value": "secondary", "label": "t:blocks.badge.settings.style.options__3.label" },
        { "value": "accent", "label": "t:blocks.badge.settings.style.options__4.label" }
      ],
      "default": "default"
    }
  ],
  "presets": [{ "name": "t:blocks.badge.name" }]
}
{% endschema %}
