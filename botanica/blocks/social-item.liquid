{% comment %}
  blocks/social-item.liquid — Social media icon link block
  Inline SVG icons for major platforms, configurable link + platform.
{% endcomment %}
{%- liquid
  assign platform = block.settings.platform | default: 'instagram'
  assign link = block.settings.link | default: '#'
  assign label = 'Follow us on ' | append: platform
-%}
<a
  href="{{ link }}"
  class="bt-social-item"
  target="_blank"
  rel="noopener"
  {{ block.shopify_attributes }}
  aria-label="{{ label }}"
>
  <span class="bt-sr-only">{{ label }}</span>
  {%- case platform -%}
    {%- when 'instagram' -%}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
    {%- when 'facebook' -%}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M17 2h-3a5 5 0 00-5 5v3H6v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3V2z" stroke="currentColor" stroke-width="1.5"/></svg>
    {%- when 'pinterest' -%}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M10 15.5c.5-1 1.5-3 1.5-3s-.5-.8-.5-2c0-1.8 1-3 2.5-3s2.5 1.2 2.5 3c0 2-1.5 3.5-2 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    {%- when 'tiktok' -%}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 15c-2 0-3.5-1.5-3.5-3.5S7 8 9 8c1.5 0 3 1 3.5 2.5v-1c0-3 2-5 5-5v4c-1.5 0-3 .5-4 1.5v6c0 3-2.5 5.5-5.5 5.5S2.5 19 2.5 16s2.5-5.5 5.5-5.5c.5 0 1 .2 1.5.4" stroke="currentColor" stroke-width="1.5"/></svg>
    {%- when 'youtube' -%}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22.5 7.5a2.5 2.5 0 00-2.5-2.5H4A2.5 2.5 0 001.5 7.5v9A2.5 2.5 0 004 19h16a2.5 2.5 0 002.5-2.5v-9z" stroke="currentColor" stroke-width="1.5"/><path d="M10 9l5 3-5 3V9z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    {%- when 'x' -%}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4l7 8-7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M20 4l-7 8 7 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    {%- else -%}
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M8 12h8M12 8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
  {%- endcase -%}
</a>

{% stylesheet %}
  .bt-social-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--bt-color-text-muted);
    transition: color var(--bt-duration-fast), transform var(--bt-duration-fast);
    border-radius: var(--bt-radius-pill);
  }
  .bt-social-item:hover {
    color: var(--bt-color-primary);
    transform: translateY(-1px);
  }
  .bt-social-item:focus-visible {
    outline: var(--bt-focus-ring-width) solid var(--bt-color-focus-ring);
    outline-offset: var(--bt-focus-ring-offset);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.social_item.name",
  "settings": [
    {
      "type": "select",
      "id": "platform",
      "label": "t:blocks.social_item.settings.platform.label",
      "options": [
        { "value": "instagram", "label": "t:blocks.social_item.settings.platform.options__1.label" },
        { "value": "facebook", "label": "t:blocks.social_item.settings.platform.options__2.label" },
        { "value": "pinterest", "label": "t:blocks.social_item.settings.platform.options__3.label" },
        { "value": "tiktok", "label": "t:blocks.social_item.settings.platform.options__4.label" },
        { "value": "youtube", "label": "t:blocks.social_item.settings.platform.options__5.label" },
        { "value": "x", "label": "t:blocks.social_item.settings.platform.options__6.label" }
      ],
      "default": "instagram"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.social_item.settings.link.label"
    }
  ],
  "presets": [{ "name": "t:blocks.social_item.name" }]
}
{% endschema %}
