{% comment %}
  blocks/button-group.liquid — Reusable button block
  Supports primary and outline buttons with link configuration.
{% endcomment %}
{%- liquid
  assign label = block.settings.label
  assign link = block.settings.link
  assign style = block.settings.style | default: 'primary'
-%}
{%- if label != blank -%}
  <a
    href="{{ link | default: '#' }}"
    class="bt-btn bt-btn--{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ label | escape }}
  </a>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.button_group.name",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:blocks.button_group.settings.label.label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:blocks.button_group.settings.link.label"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:blocks.button_group.settings.style.label",
      "options": [
        { "value": "primary", "label": "t:blocks.button_group.settings.style.options__1.label" },
        { "value": "outline", "label": "t:blocks.button_group.settings.style.options__2.label" }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.button_group.name"
    }
  ]
}
{% endschema %}
