{% comment %}
  blocks/care-icons.liquid — 4-column inline-SVG plant care summary grid.
  Replaces Hey Rooted's 4-PNG icon grid with crisp Botanica-original SVGs
  (light / water / humidity / toxicity). Each cell: large icon + label +
  value. Visually-hidden text keeps screen readers informed beyond the
  icon-only affordance. Oldstyle numerals on values keeps editorial tone.
  All data from block settings — never reads custom metafields.
{% endcomment %}
{%- liquid
  assign has_any = false
  if block.settings.light_value != blank or block.settings.water_value != blank or block.settings.humidity_value != blank or block.settings.toxicity_value != blank
    assign has_any = true
  endif
-%}
{%- if has_any -%}
  <div class="bt-care-icons" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h3 class="bt-care-icons__heading bt-eyebrow">{{ block.settings.heading | escape }}</h3>
    {%- endif -%}
    <ul class="bt-care-icons__grid" role="list">
      {%- if block.settings.light_value != blank -%}
        <li class="bt-care-icons__cell">
          <span class="bt-care-icons__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <circle cx="12" cy="12" r="4.5"/>
              <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.5 4.5l2.1 2.1M17.4 17.4l2.1 2.1M4.5 19.5l2.1-2.1M17.4 6.6l2.1-2.1"/>
            </svg>
          </span>
          <span class="bt-care-icons__label">{{ block.settings.light_label | default: 'Light' | escape }}</span>
          <span class="bt-care-icons__value">{{ block.settings.light_value | escape }}</span>
        </li>
      {%- endif -%}
      {%- if block.settings.water_value != blank -%}
        <li class="bt-care-icons__cell">
          <span class="bt-care-icons__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3C9 8 6 11 6 13.5a6 6 0 0 0 12 0C18 11 15 8 12 3Z"/>
              <path d="M9 14a3 3 0 0 0 3 3" opacity="0.55"/>
            </svg>
          </span>
          <span class="bt-care-icons__label">{{ block.settings.water_label | default: 'Water' | escape }}</span>
          <span class="bt-care-icons__value">{{ block.settings.water_value | escape }}</span>
        </li>
      {%- endif -%}
      {%- if block.settings.humidity_value != blank -%}
        <li class="bt-care-icons__cell">
          <span class="bt-care-icons__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <path d="M5 9c0-3 4-6 6-7 2 1 7 4 7 7a6.5 6.5 0 0 1-13 0Z"/>
              <path d="M9 9c0 1 1 1.5 1.5 1.5M14 11c0 1 .8 1.5 1.2 1.5" opacity="0.6"/>
            </svg>
          </span>
          <span class="bt-care-icons__label">{{ block.settings.humidity_label | default: 'Humidity' | escape }}</span>
          <span class="bt-care-icons__value">{{ block.settings.humidity_value | escape }}</span>
        </li>
      {%- endif -%}
      {%- if block.settings.toxicity_value != blank -%}
        <li class="bt-care-icons__cell">
          <span class="bt-care-icons__icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="8.5"/>
              <path d="M12 7v6M12 16.5v0.8"/>
            </svg>
          </span>
          <span class="bt-care-icons__label">{{ block.settings.toxicity_label | default: 'Toxicity' | escape }}</span>
          <span class="bt-care-icons__value">{{ block.settings.toxicity_value | escape }}</span>
        </li>
      {%- endif -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .bt-care-icons { margin-top: var(--bt-space-2xs); }
  .bt-care-icons__heading { margin-bottom: var(--bt-space-sm); }
  .bt-care-icons__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--bt-space-sm);
    text-align: center;
  }
  .bt-care-icons__cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--bt-space-3xs);
    padding: var(--bt-space-sm) var(--bt-space-2xs);
    background: var(--bt-color-bg);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-md);
    transition: transform var(--bt-duration-base) var(--bt-ease-out);
  }
  .bt-care-icons__cell:hover { transform: translateY(-2px); }
  .bt-care-icons__icon {
    width: 56px; height: 56px;
    display: flex; align-items: center; justify-content: center;
    color: var(--bt-color-secondary);
    background: var(--bt-color-surface);
    border-radius: var(--bt-radius-pill);
    border: 1px solid var(--bt-color-border-light);
  }
  .bt-care-icons__label {
    font-family: var(--bt-font-body);
    font-size: var(--bt-fs-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--bt-color-text-muted);
  }
  .bt-care-icons__value {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text);
    font-variant-numeric: oldstyle-nums;
    line-height: 1.3;
  }
  @media (max-width: 989px) {
    .bt-care-icons__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .bt-care-icons__grid { grid-template-columns: 1fr; }
    .bt-care-icons__cell { flex-direction: row; justify-content: flex-start; gap: var(--bt-space-sm); text-align: left; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.care_icons.name",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:blocks.care_icons.settings.heading.label", "default": "Care at a glance" },
    { "type": "header", "content": "t:blocks.care_icons.settings.light.header" },
    { "type": "text", "id": "light_label", "label": "t:blocks.care_icons.settings.label.label", "default": "Light" },
    { "type": "text", "id": "light_value", "label": "t:blocks.care_icons.settings.value.label", "default": "Bright indirect" },
    { "type": "header", "content": "t:blocks.care_icons.settings.water.header" },
    { "type": "text", "id": "water_label", "label": "t:blocks.care_icons.settings.label.label", "default": "Water" },
    { "type": "text", "id": "water_value", "label": "t:blocks.care_icons.settings.value.label", "default": "Weekly" },
    { "type": "header", "content": "t:blocks.care_icons.settings.humidity.header" },
    { "type": "text", "id": "humidity_label", "label": "t:blocks.care_icons.settings.label.label", "default": "Humidity" },
    { "type": "text", "id": "humidity_value", "label": "t:blocks.care_icons.settings.value.label", "default": "Moderate" },
    { "type": "header", "content": "t:blocks.care_icons.settings.toxicity.header" },
    { "type": "text", "id": "toxicity_label", "label": "t:blocks.care_icons.settings.label.label", "default": "Toxicity" },
    { "type": "text", "id": "toxicity_value", "label": "t:blocks.care_icons.settings.value.label", "default": "Toxic to pets" }
  ],
  "presets": [{ "name": "t:blocks.care_icons.name" }]
}
{% endschema %}