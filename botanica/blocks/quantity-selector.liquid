{% comment %}
  blocks/quantity-selector.liquid — Quantity +/- input for PDP
  44×44px touch targets, aria-label, number input.
{% endcomment %}
<div class="bt-qty" {{ block.shopify_attributes }}>
  <label class="bt-qty__label bt-field__label" for="Quantity-{{ section.id }}">
    {{ 'products.product.quantity.label' | t }}
  </label>
  <div class="bt-qty__controls">
    <button type="button" class="bt-qty__btn" name="minus" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">
      <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h10" stroke="currentColor" stroke-width="2"/></svg>
    </button>
    <input type="number" name="quantity" id="Quantity-{{ section.id }}" class="bt-qty__input" value="1" min="1">
    <button type="button" class="bt-qty__btn" name="plus" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">
      <svg width="14" height="14" viewBox="0 0 14 14"><path d="M2 7h10M7 2v10" stroke="currentColor" stroke-width="2"/></svg>
    </button>
  </div>
</div>

{% javascript %}
  /* Self-contained qty stepper: ONE document-level delegated listener,
     globally guarded so multiple quantity blocks never double-bind.
     (Consolidated here from buy-buttons.liquid.) */
  if (!window.__btQtyStepperBound) {
    window.__btQtyStepperBound = true;
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.bt-qty__btn');
      if (!btn) return;
      var controls = btn.closest('.bt-qty__controls');
      if (!controls) return;
      var input = controls.querySelector('input[name="quantity"]');
      if (!input) return;
      var min = parseInt(input.getAttribute('min') || '1', 10);
      if (isNaN(min) || min < 1) min = 1;
      var max = parseInt(input.getAttribute('max') || '', 10);
      if (isNaN(max) || max < 1) max = 9999;  /* no/zero max attr = effectively unlimited */
      var cur = parseInt(input.value || '1', 10);
      if (isNaN(cur) || cur < 1) cur = min;
      if (btn.getAttribute('name') === 'plus') {
        cur = Math.min(cur + 1, max);
      } else if (btn.getAttribute('name') === 'minus') {
        cur = Math.max(cur - 1, min);
      }
      input.value = cur;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }
{% endjavascript %}

{% stylesheet %}
  .bt-qty { margin-bottom: var(--bt-space-sm); }
  /* Borderless soft pill — matches the buy-buttons stepper spec */
  .bt-qty__controls { display: inline-flex; align-items: center; gap: 2px; padding: 3px; border: none; border-radius: var(--bt-radius-pill); background: var(--bt-color-surface-hover); }
  .bt-qty__btn { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: none; border-radius: var(--bt-radius-pill); background: transparent; color: var(--bt-color-text); cursor: pointer; transition: background var(--bt-duration-fast), color var(--bt-duration-fast), box-shadow var(--bt-duration-fast); }
  .bt-qty__btn:hover { background: var(--bt-color-bg); color: var(--bt-color-primary); box-shadow: var(--bt-shadow-sm); }
  .bt-qty__input { width: 44px; height: 40px; border: none; text-align: center; font-size: var(--bt-fs-body); font-weight: var(--bt-fw-semibold); font-family: var(--bt-font-body); color: var(--bt-color-text); background: transparent; -moz-appearance: textfield; }
  .bt-qty__input::-webkit-inner-spin-button, .bt-qty__input::-webkit-outer-spin-button { -webkit-appearance: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.quantity_selector.name",
  "presets": [{ "name": "t:blocks.quantity_selector.name" }]
}
{% endschema %}
