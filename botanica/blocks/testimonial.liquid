{% comment %}
  blocks/testimonial.liquid — Customer testimonial block
  Quote + attribution + optional avatar. Editorial botanical style.
{% endcomment %}
{%- liquid
  assign quote = block.settings.quote
  assign author = block.settings.author
  assign role_text = block.settings.role
  assign stars = block.settings.stars | plus: 0
  assign linked_product = block.settings.product
-%}
{%- if quote != blank -%}
  <figure class="bt-testimonial" {{ block.shopify_attributes }}>
    {%- if stars > 0 -%}
      <div class="bt-testimonial__stars" aria-hidden="true">
        {%- for i in (1..5) -%}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="{% if i <= stars %}var(--bt-color-secondary){% else %}none{% endif %}" stroke="var(--bt-color-secondary)" stroke-width="1"><path d="M8 1l2 4 4 .5-3 3 .5 4.5L8 11l-3.5 2 .5-4.5-3-3L6 5z"/></svg>
        {%- endfor -%}
      </div>
    {%- endif -%}
    <blockquote class="bt-testimonial__quote">
      <p>{{ quote }}</p>
    </blockquote>
    {%- if author != blank -%}
      <figcaption class="bt-testimonial__attr">
        <strong>{{ author | escape }}</strong>
        {%- if role_text != blank -%}
          <span>{{ role_text | escape }}</span>
        {%- endif -%}
      </figcaption>
    {%- endif -%}
    {%- if linked_product != blank -%}
      <a
        class="bt-testimonial__product"
        href="{{ linked_product.url }}"
        aria-label="{{ 'products.product.view_product' | t }}: {{ linked_product.title | escape }}"
      >
        <span class="bt-testimonial__product-media">
          {%- if linked_product.featured_media -%}
            {{ linked_product.featured_media | image_url: width: 112 | image_tag:
              loading: 'lazy',
              widths: '56, 112',
              sizes: '56px',
              alt: linked_product.featured_media.alt | default: linked_product.title
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'bt-testimonial__product-placeholder' }}
          {%- endif -%}
        </span>
        <span class="bt-testimonial__product-body">
          <span class="bt-testimonial__product-title">{{ linked_product.title | escape }}</span>
          <span class="bt-testimonial__product-price">
            {%- if linked_product.compare_at_price > linked_product.price -%}
              <s>{{ linked_product.compare_at_price | money }}</s>
            {%- endif -%}
            {%- if linked_product.price_varies -%}
              {{ 'products.product.price.from_price_html' | t: price: linked_product.price | money }}
            {%- else -%}
              {{ linked_product.price | money }}
            {%- endif -%}
          </span>
        </span>
      </a>
    {%- endif -%}
  </figure>
{%- endif -%}

{% stylesheet %}
  .bt-testimonial {
    position: relative;
    margin: 0;
    padding: var(--bt-space-md);
    background: var(--bt-color-surface);
    border-radius: var(--bt-radius-card);
    text-align: center;
    box-shadow: var(--bt-shadow-card);
    transition: transform 250ms var(--bt-ease-out),
                box-shadow 250ms var(--bt-ease-out);
  }
  /* Surface sheen: faint top highlight, same language as product cards. */
  .bt-testimonial::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--bt-card-sheen);
    pointer-events: none;
  }
  /* Hover elevation: shadow deepens on hover-capable pointers; the lift is
     motion-gated for reduced-motion users. */
  @media (hover: hover) {
    .bt-testimonial:hover {
      box-shadow: var(--bt-shadow-card-hover);
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .bt-testimonial:hover {
      transform: translateY(-4px);
    }
  }
  .bt-testimonial__stars {
    display: flex;
    justify-content: center;
    gap: 2px;
    margin-bottom: var(--bt-space-xs);
  }
  .bt-testimonial__quote {
    margin: 0;
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h4);
    font-style: italic;
    line-height: var(--bt-lh-body);
    color: var(--bt-color-text);
    text-wrap: balance;
  }
  .bt-testimonial__quote p { margin: 0; }
  .bt-testimonial__attr {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: var(--bt-space-sm);
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
  }
  .bt-testimonial__attr strong {
    color: var(--bt-color-text);
    font-weight: var(--bt-fw-semibold);
  }

  /* ── Linked product: hairline-ruled mini product strip ── */
  .bt-testimonial__product {
    display: flex;
    align-items: center;
    gap: var(--bt-space-sm);
    margin-top: var(--bt-space-md);
    padding-top: var(--bt-space-md);
    border-top: 1px solid var(--bt-hairline);
    text-align: start;
    text-decoration: none;
    color: var(--bt-color-text);
  }
  .bt-testimonial__product-media {
    flex-shrink: 0;
    display: block;
    width: 56px;
    height: 56px;
    border: 1px solid var(--bt-hairline);
    background: var(--bt-color-surface-hover);
    overflow: hidden;
  }
  .bt-testimonial__product-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-testimonial__product-placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.2;
  }
  .bt-testimonial__product-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .bt-testimonial__product-title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-body);
    line-height: var(--bt-lh-heading);
    color: var(--bt-color-text);
    transition: color var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-testimonial__product:hover .bt-testimonial__product-title {
    color: var(--bt-color-primary);
  }
  .bt-testimonial__product-price {
    font-size: var(--bt-fs-body-sm);
    color: var(--bt-color-text-muted);
  }
  .bt-testimonial__product-price s {
    opacity: 0.6;
    margin-inline-end: 0.4em;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.testimonial.name",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "t:blocks.testimonial.settings.quote.label",
      "default": "The care guide included with every plant is incredible. I went from plant killer to proud plant parent in three months."
    },
    {
      "type": "text",
      "id": "author",
      "label": "t:blocks.testimonial.settings.author.label",
      "default": "Sarah Chen"
    },
    {
      "type": "text",
      "id": "role",
      "label": "t:blocks.testimonial.settings.role.label",
      "default": "Verified buyer"
    },
    {
      "type": "range",
      "id": "stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5,
      "label": "t:blocks.testimonial.settings.stars.label"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:blocks.testimonial.settings.product.label",
      "info": "t:blocks.testimonial.settings.product.info"
    }
  ],
  "presets": [{ "name": "t:blocks.testimonial.name" }]
}
{% endschema %}
