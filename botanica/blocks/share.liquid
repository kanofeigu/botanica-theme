{% comment %}
  blocks/share.liquid — Social share buttons
{% endcomment %}
<div class="bt-share" {{ block.shopify_attributes }}>
  {%- assign share_label = block.settings.share_label | default: 'Share' -%}
  <span class="bt-share__label">{{ share_label | escape }}</span>
  <a href="//www.facebook.com/sharer.php?u={{ shop.url | append: product.url | url_encode }}" class="bt-share__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_facebook' | t }}">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M16 1H2a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h7.5V10.4H6.8V7.8h2.7V5.8c0-2.7 1.6-4.1 4-4.1 1.2 0 2.2.1 2.5.1v2.8h-1.7c-1.3 0-1.6.6-1.6 1.6v1.5h3.1l-.4 2.6h-2.7V17H16a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1Z" fill="currentColor"/></svg>
  </a>
  <a href="//twitter.com/intent/tweet?text={{ product.title | url_encode }}&url={{ shop.url | append: product.url | url_encode }}" class="bt-share__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_twitter' | t }}">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M13.7 2h2.6l-5.7 6.5L17 17h-5.3l-4.1-5.4L3 17H.3l6.1-7L.3 2h5.4l3.7 4.9L13.7 2Zm-.9 13.5h1.5L4.8 3.4H3.2l9.6 12.1Z" fill="currentColor"/></svg>
  </a>
  <a href="//pinterest.com/pin/create/button/?url={{ shop.url | append: product.url | url_encode }}&description={{ product.title | url_encode }}" class="bt-share__link" target="_blank" rel="noopener" aria-label="{{ 'general.social.alt_text.share_on_pinterest' | t }}">
    <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M9 1a8 8 0 0 0-3.1 15.4c-.1-.6 0-1.3.1-2l.6-2.4s-.1-.3-.1-.7c0-.7.4-1.2.9-1.2.4 0 .6.3.6.7 0 .4-.3 1-.4 1.6-.1.5.2.9.7.9 1.1 0 1.9-1.4 1.9-3 0-1.2-.9-2.2-2.4-2.2-1.8 0-3 1.4-3 3 0 .5.2 1 .4 1.4l-.2.7c-.2.8-.6 2.4-.6 2.4A8 8 0 1 0 9 1Z" fill="currentColor"/></svg>
  </a>
</div>

{% stylesheet %}
  .bt-share {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }
  .bt-share__label {
    font-size: var(--bt-fs-small);
    color: var(--bt-color-text-muted, #4D4840);
  }
  .bt-share__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    color: var(--bt-color-text, #2E2A24);
    text-decoration: none;
    transition: background 0.2s;
  }
  .bt-share__link:hover,
  .bt-share__link:focus-visible {
    background: var(--bt-color-surface, #FAF7EF);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.share.name",
  "settings": [
    { "type": "text", "id": "share_label", "label": "Label", "default": "Share" }
  ],
  "presets": [{ "name": "t:blocks.share.name" }]
}
{% endschema %}
