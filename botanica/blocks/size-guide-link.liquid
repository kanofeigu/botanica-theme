{% comment %}
  blocks/size-guide-link.liquid — "Plant size guide" opener next to variant picker.
  Renders small leaf-iconified outline button that opens a native <dialog>
  carrying either a linked page or richtext body (size table copy).
  Uses native dialog: free ESC, backdrop dismiss (handled inline below),
  focus restore. Inspired by Hey Rooted's "Plant Size guide" UX but
  built entirely with the platform, no Dawn `<modal-dialog>` custom element.
{% endcomment %}
{%- liquid
  assign btn_text = block.settings.button_label | default: 'Plant size guide'
  assign dialog_id = 'bt-size-guide-' | append: block.id
-%}
{%- if btn_text != blank -%}
  <div class="bt-size-guide-link" {{ block.shopify_attributes }}>
    <button
      type="button"
      class="bt-size-guide-link__btn bt-btn bt-btn--outline bt-btn--sm bt-interactive"
      data-size-guide-open="{{ dialog_id }}"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M12 3v18M3 12h18" stroke-linecap="round"/>
        <path d="M7 7h10M7 17h10" stroke-linecap="round" opacity="0.6"/>
      </svg>
      <span>{{ btn_text | escape }}</span>
    </button>

    <dialog id="{{ dialog_id }}" class="bt-size-guide" aria-modal="true" aria-labelledby="{{ dialog_id }}-title">
      <div class="bt-size-guide__inner">
        <div class="bt-size-guide__header">
          <h2 id="{{ dialog_id }}-title" class="bt-size-guide__title">{{ block.settings.heading | default: 'Plant size guide' | escape }}</h2>
          <button type="button" class="bt-size-guide__close" data-size-guide-close aria-label="{{ 'accessibility.close' | t }}">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          </button>
        </div>
        <div class="bt-size-guide__body bt-rich-text">
          {%- if block.settings.page != blank -%}
            {{ block.settings.page.content }}
          {%- elsif block.settings.content != blank -%}
            {{ block.settings.content }}
          {%- else -%}
            <p>{{ 'products.product.size_guide_empty_html' | t }}</p>
          {%- endif -%}
        </div>
      </div>
    </dialog>
  </div>
{%- endif -%}

{% javascript %}
  (function () {
    function setup(opener) {
      var dialogId = opener.getAttribute('data-size-guide-open');
      var dialog = document.getElementById(dialogId);
      if (!dialog) return;
      var lastFocused = null;

      opener.addEventListener('click', function () {
        if (typeof dialog.showModal !== 'function') { dialog.setAttribute('open', ''); return; }
        lastFocused = document.activeElement;
        dialog.showModal();
      });

      var closer = dialog.querySelector('[data-size-guide-close]');
      if (closer) closer.addEventListener('click', function () { dialog.close(); });

      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close();
      });

      dialog.addEventListener('close', function () {
        if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      });
    }
    var openers = document.querySelectorAll('[data-size-guide-open]');
    openers.forEach(setup);
  })();
{% endjavascript %}

{% stylesheet %}
  .bt-size-guide-link { margin-top: var(--bt-space-2xs); }
  .bt-size-guide-link__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .bt-size-guide__inner {
    max-width: min(560px, 92vw);
    margin: auto;
    background: var(--bt-color-bg);
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-card);
    padding: var(--bt-space-lg) var(--bt-space-md) var(--bt-space-md);
    box-shadow: var(--bt-shadow-lg);
  }
  .bt-size-guide__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--bt-space-md);
  }
  .bt-size-guide__title {
    font-family: var(--bt-font-heading);
    font-size: var(--bt-fs-h3);
    font-weight: var(--bt-fw-normal);
    margin: 0;
    color: var(--bt-color-text);
  }
  .bt-size-guide__close {
    background: transparent;
    border: 1px solid var(--bt-color-border-light);
    border-radius: var(--bt-radius-pill);
    width: 32px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
    color: var(--bt-color-text);
    cursor: pointer;
    transition: background var(--bt-duration-fast);
  }
  .bt-size-guide__close:hover { background: var(--bt-color-surface-hover); }
  .bt-size-guide__body { color: var(--bt-color-text-muted); font-size: var(--bt-fs-body-sm); line-height: var(--bt-lh-relaxed); }
  .bt-size-guide__body table { width: 100%; border-collapse: collapse; margin-top: var(--bt-space-2xs); }
  .bt-size-guide__body th, .bt-size-guide__body td { border-top: 1px solid var(--bt-color-border-light); padding: var(--bt-space-2xs); text-align: left; }
  .bt-size-guide__body th { font-family: var(--bt-font-heading); font-weight: var(--bt-fw-semibold); color: var(--bt-color-text); }
  dialog.bt-size-guide { border: none; padding: 0; background: transparent; max-width: none; max-height: none; }
  dialog.bt-size-guide::backdrop { background: rgba(var(--bt-color-text-rgb), 0.4); }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.size_guide_link.name",
  "settings": [
    { "type": "text", "id": "button_label", "label": "t:blocks.size_guide_link.settings.button_label.label", "default": "Plant size guide" },
    { "type": "text", "id": "heading", "label": "t:blocks.size_guide_link.settings.heading.label", "default": "Plant size guide" },
    { "type": "liquid", "id": "content", "label": "t:blocks.size_guide_link.settings.content.label" },
    { "type": "page", "id": "page", "label": "t:blocks.size_guide_link.settings.page.label" }
  ],
  "presets": [{ "name": "t:blocks.size_guide_link.name" }]
}
{% endschema %}