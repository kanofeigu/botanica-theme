{% comment %}
  blocks/complementary-products.liquid — Upsell product row ("Pairs well with…")
  Shows hand-picked products from a selected collection in horizontal cards.
  Each card has image, title, price, and Add to cart button.
{% endcomment %}
{%- liquid
  assign collection_handle = block.settings.collection
  assign heading = block.settings.heading | default: 'Pairs well with…'
  assign max_products = block.settings.max_products | default: 4
  assign upsell_collection = collections[collection_handle]
-%}

{%- if upsell_collection != blank and upsell_collection.products.size > 0 -%}
  <div class="bt-complementary" {{ block.shopify_attributes }} aria-label="{{ heading | escape }}">
    {%- if heading != blank -%}
      <p class="bt-complementary__heading">{{ heading | escape }}</p>
    {%- endif -%}
    <ul class="bt-complementary__list" role="list">
      {%- for upsell_product in upsell_collection.products limit: max_products -%}
        {%- unless upsell_product.id == product.id -%}
          {%- liquid
            assign upsell_variant = upsell_product.selected_or_first_available_variant
            assign upsell_url = upsell_product.url
            if upsell_variant
              assign upsell_url = upsell_url | append: '?variant=' | append: upsell_variant.id
            endif
          -%}
          <li class="bt-complementary__item" role="listitem">
            <a href="{{ upsell_url }}" class="bt-complementary__link" aria-label="{{ upsell_product.title | escape }}">
              <div class="bt-complementary__media">
                {%- if upsell_product.featured_media -%}
                  {{ upsell_product.featured_media | image_url: width: 160 | image_tag:
                    loading: 'lazy',
                    widths: '80, 120, 160',
                    sizes: '80px',
                    alt: upsell_product.featured_media.alt | default: upsell_product.title,
                    class: 'bt-complementary__image'
                  }}
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'bt-complementary__placeholder' }}
                {%- endif -%}
              </div>
              <div class="bt-complementary__info">
                <span class="bt-complementary__title">{{ upsell_product.title | escape }}</span>
                <span class="bt-complementary__price">
                  {%- if upsell_variant.compare_at_price > upsell_variant.price -%}
                    <s class="bt-complementary__compare-at">{{ upsell_variant.compare_at_price | money }}</s>
                  {%- endif -%}
                  {{ upsell_variant.price | money }}
                </span>
              </div>
            </a>
            {%- if upsell_variant -%}
              <button
                type="button"
                class="bt-card__quick-add bt-complementary__atc"
                data-variant-id="{{ upsell_variant.id }}"
                aria-label="{{ 'products.product.add_to_cart' | t }} — {{ upsell_product.title | escape }}"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                <span class="bt-sr-only">{{ 'products.product.add_to_cart' | t }}</span>
              </button>
            {%- endif -%}
          </li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .bt-complementary {
    padding: var(--bt-space-md) 0;
    margin-top: var(--bt-space-sm);
  }
  .bt-complementary__heading {
    font-size: var(--bt-fs-body-sm);
    font-weight: var(--bt-fw-semibold);
    margin-bottom: var(--bt-space-sm);
    color: var(--bt-color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .bt-complementary__list {
    display: flex;
    gap: var(--bt-space-sm);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: var(--bt-space-2xs);
    /* Hide scrollbar entirely — a pop-in scrollbar intrudes into the box and
       reflows everything below (page "jumps" when the pointer enters). */
    scrollbar-width: none;
  }
  .bt-complementary__list::-webkit-scrollbar {
    display: none;
  }
  .bt-complementary__item {
    flex: 0 0 auto;
    width: 160px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-2xs);
    position: relative;
    background: var(--bt-color-surface);
    border-radius: var(--bt-radius-card);
    padding: var(--bt-space-2xs);
    transition: box-shadow var(--bt-duration-fast);
  }
  .bt-complementary__item:hover {
    box-shadow: 0 2px 12px rgba(var(--bt-color-text-rgb), 0.08);
  }
  .bt-complementary__link {
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: var(--bt-space-2xs);
  }
  .bt-complementary__media {
    aspect-ratio: 1;
    border-radius: calc(var(--bt-radius-card) - 2px);
    overflow: hidden;
    background: var(--bt-color-bg);
  }
  .bt-complementary__image,
  .bt-complementary__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bt-complementary__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 var(--bt-space-3xs);
  }
  .bt-complementary__title {
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-medium);
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bt-complementary__price {
    font-size: var(--bt-fs-body-xs);
    font-weight: var(--bt-fw-semibold);
    color: var(--bt-color-text-muted);
  }
  .bt-complementary__compare-at {
    font-weight: var(--bt-fw-normal);
    opacity: 0.6;
    margin-right: 4px;
    text-decoration: line-through;
  }
  /* Scoped under .bt-complementary so these rules always win over the
     card-product .bt-card__quick-add base styles if both stylesheets load. */
  .bt-complementary .bt-complementary__atc {
    position: absolute;
    bottom: var(--bt-space-2xs);
    right: var(--bt-space-2xs);
    left: auto;
    width: 32px;
    height: 32px;
    min-height: 0;
    padding: 0;
    gap: 0;
    backdrop-filter: none;
    box-shadow: none;
    border-radius: 50%;
    background: var(--bt-color-primary);
    color: var(--bt-color-primary-contrast);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 0;
    transform: scale(0.8);
    transition: all var(--bt-duration-fast) var(--bt-ease-out);
  }
  .bt-complementary__item:hover .bt-complementary__atc,
  .bt-complementary .bt-complementary__atc.is-loading,
  .bt-complementary .bt-complementary__atc.is-added {
    opacity: 1;
    transform: scale(1);
  }
  .bt-complementary .bt-complementary__atc:hover {
    background: var(--bt-color-primary-hover);
  }
  @media (hover: none) {
    .bt-complementary .bt-complementary__atc {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (min-width: 750px) {
    .bt-complementary__list { gap: var(--bt-space-sm); }
    .bt-complementary__item { width: 150px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.complementary_products.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.complementary_products.settings.heading.label",
      "default": "Pairs well with…"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:blocks.complementary_products.settings.collection.label"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:blocks.complementary_products.settings.max_products.label",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [{ "name": "t:blocks.complementary_products.name" }]
}
{% endschema %}
